  @@index([processId])
  @@map("indicators")
}

model IndicatorValue {
  id          String   @id @default(cuid())
  indicatorId String
  value       Float
  period      String // "2025-06"
  note        String?
  createdAt   DateTime @default(now())

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@map("indicator_values")
}

// ─── EVIDENCE ────────────────────────────────────────

model EvidenceFile {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String?
  evidenceType   EvidenceType   @default(OTHER)
  status         EvidenceStatus @default(PENDING_REVIEW)
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  processId      String?
  standardCode   String?
  clauseId       String?
  responsibleId  String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  module         String? // legacy polymorphic link kept for backwards compatibility
  moduleId       String?
  uploadedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization             Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process                  Process?                       @relation(fields: [processId], references: [id], onDelete: SetNull)
  clause                   Clause?                        @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  uploadedBy               User?                          @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  responsible              User?                          @relation("EvidenceResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  reviewedBy               User?                          @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documentLinks            EvidenceDocumentLink[]
  riskLinks                EvidenceRiskLink[]
  auditLinks               EvidenceAuditLink[]
  findingLinks             EvidenceFindingLink[]
  nonconformityLinks       EvidenceNonconformityLink[]
  indicatorLinks           EvidenceIndicatorLink[]
  managementReviewLinks    EvidenceManagementReviewLink[]
  controlEvidences         ControlEvidence[]
  soaApprovalEvidence      StatementOfApplicability[]     @relation("SoAApprovalEvidence")
  soaEntryEvidence         SoAControlEntry[]              @relation("SoAEntryEvidence")
  riskPlanApprovalEvidence RiskTreatmentPlan[]            @relation("RiskPlanApprovalEvidence")
  riskAcceptanceEvidence   RiskAcceptance[]               @relation("RiskAcceptanceEvidence")
  assetControlEvidence     AssetControl[]                 @relation("AssetControlEvidence")
  incidentEvidence         SecurityIncidentEvidence[]
  remediationEvidence      Remediation[]                  @relation("RemediationEvidence")
  verificationEvidence     Verification[]                 @relation("VerificationEvidence")
  testResultEvidence       TestResult[]                   @relation("TestResultEvidence")
  supplierSecurityEvidence SupplierSecurityProfile[]      @relation("SupplierSecurityEvidence")

  @@index([organizationId, status])
  @@index([organizationId, expiresAt])
  @@index([organizationId, evidenceType])
  @@index([organizationId, processId])
  @@index([organizationId, clauseId])
  @@index([organizationId, responsibleId])
  @@map("evidence_files")
}

model EvidenceDocumentLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  documentId     String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, documentId])
  @@index([organizationId, documentId])
  @@map("evidence_document_links")
}

model EvidenceRiskLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  riskId         String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  risk         Risk         @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, riskId])
  @@index([organizationId, riskId])
  @@map("evidence_risk_links")
}

model EvidenceAuditLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  auditId        String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, auditId])
  @@index([organizationId, auditId])
  @@map("evidence_audit_links")
}

model EvidenceFindingLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  findingId      String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  finding      AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, findingId])
  @@index([organizationId, findingId])
  @@map("evidence_finding_links")
}

model EvidenceNonconformityLink {
  id              String   @id @default(cuid())
  organizationId  String
  evidenceId      String
  nonconformityId String
  createdById     String?
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence      EvidenceFile  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, nonconformityId])
  @@index([organizationId, nonconformityId])
  @@map("evidence_nonconformity_links")
}

model EvidenceIndicatorLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  indicatorId    String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  indicator    Indicator    @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, indicatorId])
  @@index([organizationId, indicatorId])
  @@map("evidence_indicator_links")
}

model EvidenceManagementReviewLink {
  id                 String   @id @default(cuid())
  organizationId     String
  evidenceId         String
  managementReviewId String
  createdById        String?
  createdAt          DateTime @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence         EvidenceFile     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  managementReview ManagementReview @relation(fields: [managementReviewId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, managementReviewId])
  @@index([organizationId, managementReviewId])
  @@map("evidence_management_review_links")
}

// ─── NOTIFICATIONS ───────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  type           NotificationType @default(INFO)
  read           Boolean          @default(false)
  readAt         DateTime?
  link           String?
  idempotencyKey String?
  createdAt      DateTime         @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryJob  NotificationDeliveryJob?

  @@unique([organizationId, idempotencyKey])
  @@index([userId, read, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  emailEnabled   Boolean            @default(true)
  disabledTypes  NotificationType[] @default([])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("notification_preferences")
}

model NotificationDeliveryJob {
  id                  String                     @id @default(cuid())
  organizationId      String
  notificationId      String?                    @unique
  userId              String?
  recipientEmail      String
  recipientName       String
  title               String
  body                String
  link                String?
  idempotencyKey      String
  status              NotificationDeliveryStatus @default(PENDING)
  attempts            Int                        @default(0)
  maxAttempts         Int                        @default(5)
  nextAttemptAt       DateTime                   @default(now())
  processingStartedAt DateTime?
  providerMessageId   String?
  lastError           String?
  lastErrorAt         DateTime?
  sentAt              DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("notification_delivery_jobs")
}

// ─── BILLING ─────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  gracePeriodEndsAt    DateTime?
  suspendedAt          DateTime?
  lastPaymentFailedAt  DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     BillingInvoice[]

  @@map("subscriptions")
}

model BillingInvoice {
  id               String    @id @default(cuid())
  organizationId   String
  subscriptionId   String?
  stripeInvoiceId  String    @unique
  number           String?
  status           String
  currency         String    @default("usd")
  amountDue        Int
  amountPaid       Int       @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?
  hostedInvoiceUrl String?
  invoicePdf       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([subscriptionId])
  @@map("billing_invoices")
}

model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  payload     Json?
  attempts    Int       @default(1)
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([type, createdAt])
  @@index([processedAt])
  @@map("stripe_webhook_events")
}

model ReportExport {
  id                  String               @id @default(cuid())
  organizationId      String
  generatedById       String?
  reportType          String
  format              ReportFormat
  dateFrom            DateTime
  dateTo              DateTime
  rowCount            Int
  fileName            String
  mimeType            String?
  title               String?
  filters             Json?
  content             Bytes?
  storagePath         String?
  fileSize            Int?
  checksum            String?
  status              ReportArtifactStatus @default(QUEUED)
  error               String?
  idempotencyKey      String?
  attempts            Int                  @default(0)
  maxAttempts         Int                  @default(3)
  nextAttemptAt       DateTime             @default(now())
  processingStartedAt DateTime?
  leaseToken          String?
  lastErrorAt         DateTime?
  failedAt            DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([generatedById])
  @@index([organizationId, status, createdAt])
  @@map("report_exports")
}

enum ReportArtifactStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// ─── AUDIT LOGS ──────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  module         String
  recordId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model OnboardingMetricEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  event          String
  step           Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, event, createdAt])
  @@index([userId, createdAt])
  @@map("onboarding_metric_events")
}

// ─── ISOTECH MANUAL ALIGNMENT ───────────────────────
// Models that extend the SaaS to cover the ISOTech functional reference.
// All entities are tenant-scoped via organizationId.

// § 10.2 Grupos / § 10.3 Permiso a Grupo / § 10.4 Usuarios de Grupo
model Group {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMembership[]
  permissions  GroupPermission[]
  processLinks GroupProcess[]
  moduleLinks  GroupModule[]

  @@unique([organizationId, name])
  @@map("groups")
}

model GroupProcess {
  id        String   @id @default(cuid())
  groupId   String
  processId String
  createdAt DateTime @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([groupId, processId])
  @@index([processId])
  @@map("group_processes")
}

model GroupModule {
  id        String   @id @default(cuid())
  groupId   String
  module    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, module])
  @@map("group_modules")
}

model OrganizationCatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  kind           String
  name           String
  description    String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, active])
  @@map("organization_catalog_items")
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_memberships")
}

model GroupPermission {
  id         String @id @default(cuid())
  groupId    String
  permission String // e.g. "documents:create", "records:*"

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, permission])
  @@map("group_permissions")
}

// § 11.1 Cargo
model Position {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnel    Personnel[]

  @@unique([organizationId, name])
  @@map("positions")
}

// § 11.3 Datos Personal
model Personnel {
  id             String    @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  identification String?
  positionId     String?
  active         Boolean   @default(true)
  hiredAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position              Position?                @relation(fields: [positionId], references: [id])
  trainingAssignments   TrainingAssignment[]
  trainingAudienceLinks TrainingCourseAudience[]
  documentsElaborated   Document[]               @relation("DocumentElaborationResponsible")
  documentsApproved     Document[]               @relation("DocumentApprovalResponsible")
  documentsCustodied    Document[]               @relation("DocumentCustodian")
  recordsCustodied      Record[]                 @relation("RecordCustodian")

  @@map("personnel")
}

// ─── TRAINING MANAGEMENT ─────────────────────────────────

model TrainingCourse {
  id                      String   @id @default(cuid())
  organizationId          String
  code                    String
  title                   String
  description             String?
  standardTags            String[] @default([])
  defaultValidityMonths   Int      @default(12)
  defaultDueDays          Int      @default(30)
  mandatory               Boolean  @default(false)
  autoAssignOnDocApproval Boolean  @default(false)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentLinks TrainingCourseDocument[]
  audienceLinks TrainingCourseAudience[]
  assignments   TrainingAssignment[]
  changeLinks   ChangeTrainingCourse[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("training_courses")
}

model TrainingCourseDocument {
  courseId   String
  documentId String

  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([courseId, documentId])
  @@index([documentId])
  @@map("training_course_documents")
}

model TrainingCourseAudience {
  courseId    String
  personnelId String

  course    TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personnel Personnel      @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@id([courseId, personnelId])
  @@index([personnelId])
  @@map("training_course_audience")
}

model TrainingAssignment {
  id                    String                   @id @default(cuid())
  organizationId        String
  courseId              String
  personnelId           String
  processId             String?
  status                TrainingAssignmentStatus @default(ASSIGNED)
  assignedAt            DateTime                 @default(now())
  dueAt                 DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  evidenceNote          String?
  evidenceUrl           String?
  triggeredByDocumentId String?
  triggeredByVersion    String?
  reminderSentAt        DateTime?
  createdById           String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course              TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  personnel           Personnel      @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  process             Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  triggeredByDocument Document?      @relation("TrainingTriggerDocument", fields: [triggeredByDocumentId], references: [id], onDelete: SetNull)

  @@unique([courseId, personnelId, triggeredByDocumentId, triggeredByVersion])
  @@index([organizationId, status])
  @@index([personnelId, dueAt])
  @@index([courseId])
  @@map("training_assignments")
}

// ─── CHANGE CONTROL ─────────────────────────────────────

model ChangeRequest {
  id              String              @id @default(cuid())
  organizationId  String
  code            String
  title           String
  category        String
  changeType      String
  reason          String
  impact          ChangeImpact        @default(MEDIUM)
  affectedAreas   String[]            @default([])
  status          ChangeRequestStatus @default(DRAFT)
  requesterId     String?
  requesterName   String?
  nonconformityId String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  implementedAt   DateTime?
  verifiedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nonconformity   Nonconformity?         @relation(fields: [nonconformityId], references: [id], onDelete: SetNull)
  processes       ChangeProcess[]
  documents       ChangeDocument[]
  risks           ChangeRisk[]
  trainingCourses ChangeTrainingCourse[]
  approvers       ChangeApprover[]
  tasks           ChangeTask[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([nonconformityId])
  @@map("change_requests")
}

model ChangeProcess {
  changeRequestId String
  processId       String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  process       Process       @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, processId])
  @@index([processId])
  @@map("change_processes")
}

model ChangeDocument {
  changeRequestId String
  documentId      String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, documentId])
  @@index([documentId])
  @@map("change_documents")
}

model ChangeRisk {
  changeRequestId String
  riskId          String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  risk          Risk          @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, riskId])
  @@index([riskId])
  @@map("change_risks")
}

model ChangeTrainingCourse {
  changeRequestId String
  courseId        String

  changeRequest ChangeRequest  @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, courseId])
  @@index([courseId])
  @@map("change_training_courses")
}

model ChangeApprover {
  id                String         @id @default(cuid())
  changeRequestId   String
  userId            String
  status            ApprovalStatus @default(PENDING)
  comment           String?
  decidedAt         DateTime?
  attestationReason String?
  createdAt         DateTime       @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@unique([changeRequestId, userId])
  @@index([userId])
  @@map("change_approvers")
}

model ChangeTask {
  id              String    @id @default(cuid())
  changeRequestId String
  title           String
  done            Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId, done])
  @@map("change_tasks")
}

// ─── SUPPLIER MANAGEMENT ─────────────────────────────────

model Supplier {
  id               String              @id @default(cuid())
  organizationId   String
  code             String
  name             String
  category         String
  criticality      SupplierCriticality @default(MEDIUM)
  ownerId          String?
  status           SupplierStatus      @default(UNDER_REVIEW)
  contactName      String?
  contactEmail     String?
  notes            String?
  nextReviewDue    DateTime?
  lastEvaluationAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents       SupplierDocument[]
  risks           SupplierRisk[]
  nonconformities SupplierNonconformity[]
  evaluations     SupplierEvaluation[]
  securityProfile SupplierSecurityProfile?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([nextReviewDue])
  @@map("suppliers")
}

model SupplierDocument {
  supplierId String
  documentId String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([supplierId, documentId])
  @@index([documentId])
  @@map("supplier_documents")
}

model SupplierRisk {
  supplierId String
  riskId     String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  risk     Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@id([supplierId, riskId])
  @@index([riskId])
  @@map("supplier_risks")
}

model SupplierNonconformity {
  supplierId      String
  nonconformityId String

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)

  @@id([supplierId, nonconformityId])
  @@index([nonconformityId])
  @@map("supplier_nonconformities")
}

model SupplierEvaluation {
  id            String                    @id @default(cuid())
  supplierId    String
  score         Int?
  outcome       SupplierEvaluationOutcome
  notes         String?
  evaluatedById String?
  evaluatedAt   DateTime                  @default(now())
  nextReviewDue DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, evaluatedAt])
  @@map("supplier_evaluations")
}

// ─── INTEGRATIONS ────────────────────────────────────────

model Integration {
  id               String            @id @default(cuid())
  organizationId   String
  key              String
  name             String
  provider         String
  category         String
  description      String?
  valueProposition String?
  status           IntegrationStatus @default(NOT_CONNECTED)
  externalAccount  String?
  config           Json?
  detailNote       String?
  lastSyncAt       DateTime?
  connectedAt      DateTime?
  configuredById   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncRuns     IntegrationSyncRun[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("integrations")
}

model IntegrationSyncRun {
  id               String                @id @default(cuid())
  integrationId    String
  status           IntegrationSyncStatus @default(RUNNING)
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  recordsProcessed Int                   @default(0)
  evidenceCreated  Int                   @default(0)
  errorMessage     String?
  metadata         Json?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
  @@map("integration_sync_runs")
}

// § 12.1.1 Lugar
model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents         Document[]
  informationAssets InformationAsset[]

  @@unique([organizationId, name])
  @@map("locations")
}

// § 13.1.1 Tiempo de Retención
model RetentionTime {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  months         Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("retention_times")
}

// § 13.1.2 Disposición
model Disposition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("dispositions")
}

// § 13.1.3 Método de Archivo
model ArchiveMethod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("archive_methods")
}

// § 13.1.4 Tipo de Registro
model RecordType {
  id             String   @id @default(cuid())
  organizationId String
  code           String?
  name           String // FISICO, ELECTRONICO, FISICO_Y_ELECTRONICO, ...
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@map("record_types")
}

// § 13.2 Control de Registros
model Record {
  id               String             @id @default(cuid())
  organizationId   String
  code             String
  name             String
  processId        String?
  clauseId         String?
  recordTypeId     String?
  retentionTimeId  String?
  dispositionId    String?
  archiveMethodId  String?
  custodianId      String?
  reviewerId       String?
  reviewStatus     RecordReviewStatus @default(DRAFT)
  reviewComment    String?
  reviewedAt       DateTime?
  physicalLocation String?
  digitalLocation  String?
  observations     String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process       Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  clause        Clause?        @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  recordType    RecordType?    @relation(fields: [recordTypeId], references: [id])
  retentionTime RetentionTime? @relation(fields: [retentionTimeId], references: [id])
  disposition   Disposition?   @relation(fields: [dispositionId], references: [id])
  archiveMethod ArchiveMethod? @relation(fields: [archiveMethodId], references: [id])
  custodian     Personnel?     @relation("RecordCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  reviewer      User?          @relation("RecordReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  entries       RecordEntry[]

  @@unique([organizationId, code])
  @@index([processId])
  @@index([organizationId, clauseId])
  @@index([custodianId])
  @@map("records")
}

model RecordEntry {
  id            String            @id @default(cuid())
  recordId      String
  title         String            @default("Entrada")
  reference     String? // e.g. registry number, batch
  description   String?
  entryDate     DateTime          @default(now())
  status        RecordEntryStatus @default(VALID)
  responsibleId String?
  fileName      String?
  fileUrl       String?
  fileSize      Int?
  mimeType      String?
  enteredById   String?
  enteredAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  record      Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  responsible User?  @relation("RecordEntryResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  enteredBy   User?  @relation("RecordEntryEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([recordId, entryDate])
  @@index([recordId, status])
  @@index([responsibleId])
  @@map("record_entries")
}

// § 15 Programa de Auditoría (annual program grouping audits)
model AuditProgram {
  id             String             @id @default(cuid())
  organizationId String
  year           Int
  title          String
  objectives     String?
  scope          String?
  standards      String[]           @default([])
  criteria       String?
  responsibleId  String?
  status         AuditProgramStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("AuditProgramResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  audits       Audit[]

  @@unique([organizationId, year, title])
  @@map("audit_programs")
}

model AuditChecklistItem {
  id          String              @id @default(cuid())
  auditId     String
  clauseCode  String?
  clauseId    String?
  question    String
  expected    String?
  response    String?
  status      ChecklistItemStatus @default(PENDING)
  evidenceUrl String?
  notes       String?
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())

  audit  Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  clause Clause? @relation(fields: [clauseId], references: [id], onDelete: SetNull)

  @@map("audit_checklist_items")
}

model AuditParticipant {
  id             String               @id @default(cuid())
  organizationId String
  auditId        String
  userId         String
  role           AuditParticipantRole @default(AUDITEE)
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([auditId, userId])
  @@index([organizationId, auditId])
  @@index([userId])
  @@map("audit_participants")
}

// § 16 Revisión por la Dirección
model ManagementReview {
  id             String                 @id @default(cuid())
  organizationId String
  title          String
  scheduledDate  DateTime?
  heldAt         DateTime?
  status         ManagementReviewStatus @default(PLANNED)
  chairId        String?
  attendees      String[]               @default([]) // free-text names or user IDs
  standards      String[]               @default([])
  summary        String?
  reportUrl      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inputs        ManagementReviewInput[]
  decisions     ManagementReviewDecision[]
  actions       Action[]
  evidenceLinks EvidenceManagementReviewLink[]
  participants  ManagementReviewParticipant[]

  @@map("management_reviews")
}

model ManagementReviewInput {
  id              String                @id @default(cuid())
  reviewId        String
  topic           ManagementReviewTopic
  content         String
  auditId         String?
  indicatorId     String?
  riskId          String?
  nonconformityId String?
  actionId        String?
  capaId          String?
  createdAt       DateTime              @default(now())

  review        ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  audit         Audit?           @relation(fields: [auditId], references: [id], onDelete: SetNull)
  indicator     Indicator?       @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  risk          Risk?            @relation(fields: [riskId], references: [id], onDelete: SetNull)
  nonconformity Nonconformity?   @relation(fields: [nonconformityId], references: [id], onDelete: SetNull)
  action        Action?          @relation(fields: [actionId], references: [id], onDelete: SetNull)
  capa          CAPA?            @relation(fields: [capaId], references: [id], onDelete: SetNull)

  @@index([reviewId, topic])
  @@index([auditId])
  @@index([indicatorId])
  @@index([riskId])
  @@index([nonconformityId])
  @@index([actionId])
  @@index([capaId])
  @@map("management_review_inputs")
}

model ManagementReviewDecision {
  id        String    @id @default(cuid())
  reviewId  String
  topic     String
  decision  String
  ownerId   String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  review ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  action Action?

  @@map("management_review_decisions")
}

model ManagementReviewParticipant {
  id             String                          @id @default(cuid())
  organizationId String
  reviewId       String
  userId         String
  role           ManagementReviewParticipantRole @default(ATTENDEE)
  createdAt      DateTime                        @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([organizationId, reviewId])
  @@index([userId])
  @@map("management_review_participants")
}

// ─── STATEMENT OF APPLICABILITY ──────────────────────

model StatementOfApplicability {
  id                 String    @id @default(cuid())
  organizationId     String
  version            Int
  status             SoAStatus @default(DRAFT)
  scope              String?
  ownerId            String?
  approverId         String?
  approvalComment    String?
  approvalEvidenceId String?
  approvedAt         DateTime?
  nextReviewDate     DateTime?
  supersededById     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?                      @relation("SoAOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approver         User?                      @relation("SoAApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalEvidence EvidenceFile?              @relation("SoAApprovalEvidence", fields: [approvalEvidenceId], references: [id], onDelete: SetNull)
  supersededBy     StatementOfApplicability?  @relation("SoASupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       StatementOfApplicability[] @relation("SoASupersede")
  entries          SoAControlEntry[]
  riskPlans        RiskTreatmentPlan[]        @relation("SoARiskPlans")

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("statements_of_applicability")
}

model SoAControlEntry {
  id                   String                    @id @default(cuid())
  organizationId       String
  soaId                String
  controlId            String
  controlCode          String
  controlTitle         String
  controlDomain        SecurityControlDomain
  applicability        ControlApplicability      @default(UNDER_REVIEW)
  justification        String?
  implementationStatus OrganizationControlStatus @default(NOT_ASSESSED)
  relatedRiskItemId    String?
  evidenceId           String?
  responsibleId        String?
  reviewDate           DateTime?
  notes                String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  soa             StatementOfApplicability @relation(fields: [soaId], references: [id], onDelete: Cascade)
  control         SecurityControl          @relation(fields: [controlId], references: [id], onDelete: Restrict)
  relatedRiskItem RiskTreatmentItem?       @relation("SoAEntryRiskItem", fields: [relatedRiskItemId], references: [id], onDelete: SetNull)
  evidence        EvidenceFile?            @relation("SoAEntryEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  responsible     User?                    @relation("SoAEntryResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@unique([soaId, controlId])
  @@index([organizationId, soaId])
  @@index([organizationId, applicability])
  @@map("soa_control_entries")
}

// ─── RISK TREATMENT ──────────────────────────────────

model RiskAssessmentMethodology {
  id                  String    @id @default(cuid())
  organizationId      String
  version             Int
  title               String
  description         String?
  probabilityScale    Json
  impactScale         Json
  riskMatrix          Json
  acceptanceCriteria  String
  acceptanceThreshold Int?
  ownerId             String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?               @relation("RiskMethodologyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy   User?               @relation("RiskMethodologyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  plans        RiskTreatmentPlan[]

  @@unique([organizationId, version])
  @@map("risk_assessment_methodologies")
}

model RiskTreatmentPlan {
  id                 String                  @id @default(cuid())
  organizationId     String
  methodologyId      String?
  soaId              String?
  version            Int
  title              String
  status             RiskTreatmentPlanStatus @default(DRAFT)
  ownerId            String?
  approverId         String?
  approvalComment    String?
  approvalEvidenceId String?
  approvedAt         DateTime?
  nextReviewDate     DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  methodology      RiskAssessmentMethodology? @relation(fields: [methodologyId], references: [id], onDelete: SetNull)
  soa              StatementOfApplicability?  @relation("SoARiskPlans", fields: [soaId], references: [id], onDelete: SetNull)
  owner            User?                      @relation("RiskPlanOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approver         User?                      @relation("RiskPlanApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalEvidence EvidenceFile?              @relation("RiskPlanApprovalEvidence", fields: [approvalEvidenceId], references: [id], onDelete: SetNull)
  items            RiskTreatmentItem[]

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("risk_treatment_plans")
}

model RiskTreatmentItem {
  id                  String                  @id @default(cuid())
  organizationId      String
  planId              String
  reference           String
  title               String
  description         String?
  riskId              String?
  asset               String?
  threat              String?
  vulnerability       String?
  impact              Int
  probability         Int
  inherentRisk        Int
  existingControls    String?
  proposedControls    String?
  treatment           RiskTreatment           @default(MITIGATE)
  residualImpact      Int?
  residualProbability Int?
  residualRisk        Int?
  ownerId             String?
  targetDate          DateTime?
  status              RiskTreatmentItemStatus @default(OPEN)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                RiskTreatmentPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  risk                Risk?                    @relation("RiskTreatmentItemRisk", fields: [riskId], references: [id], onDelete: SetNull)
  owner               User?                    @relation("RiskItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  controls            RiskTreatmentControl[]
  residualAssessments ResidualRiskAssessment[]
  acceptances         RiskAcceptance[]
  soaEntries          SoAControlEntry[]        @relation("SoAEntryRiskItem")

  @@unique([planId, reference])
  @@index([organizationId, status])
  @@index([organizationId, planId])
  @@map("risk_treatment_items")
}

model RiskTreatmentControl {
  id                    String   @id @default(cuid())
  organizationId        String
  itemId                String
  organizationControlId String
  role                  String   @default("PROPOSED")
  createdAt             DateTime @default(now())

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                RiskTreatmentItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)

  @@unique([itemId, organizationControlId])
  @@index([organizationId, itemId])
  @@map("risk_treatment_controls")
}

model ResidualRiskAssessment {
  id                  String   @id @default(cuid())
  organizationId      String
  itemId              String
  residualImpact      Int
  residualProbability Int
  residualRisk        Int
  rationale           String?
  assessedById        String
  assessedAt          DateTime @default(now())
  approved            Boolean  @default(false)
  createdAt           DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         RiskTreatmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assessedBy   User              @relation("ResidualRiskAssessor", fields: [assessedById], references: [id], onDelete: Restrict)
  acceptances  RiskAcceptance[]

  @@index([organizationId, itemId, assessedAt])
  @@map("residual_risk_assessments")
}

model RiskAcceptance {
  id                   String    @id @default(cuid())
  organizationId       String
  itemId               String
  residualAssessmentId String?
  justification        String
  acceptedById         String
  acceptedAt           DateTime  @default(now())
  comment              String?
  evidenceId           String?
  validUntil           DateTime?
  createdAt            DateTime  @default(now())

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item               RiskTreatmentItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  residualAssessment ResidualRiskAssessment? @relation(fields: [residualAssessmentId], references: [id], onDelete: SetNull)
  acceptedBy         User                    @relation("RiskAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  evidence           EvidenceFile?           @relation("RiskAcceptanceEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, itemId])
  @@map("risk_acceptances")
}

// ─── INFORMATION ASSET INVENTORY ─────────────────────

model InformationAsset {
  id             String           @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  category       AssetCategory
  ownerId        String?
  custodianId    String?
  processId      String?
  locationId     String?
  status         AssetStatus      @default(ACTIVE)
  criticality    AssetCriticality @default(MEDIUM)
  reviewDate     DateTime?
  nextReviewDate DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?                   @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  custodian          User?                   @relation("AssetCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  process            Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  location           Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  classification     AssetClassification?
  dependencies       AssetDependency[]       @relation("AssetDependencySource")
  dependents         AssetDependency[]       @relation("AssetDependencyTarget")
  risks              AssetRisk[]
  controls           AssetControl[]
  incidentLinks      SecurityIncidentAsset[]
  vulnerabilityLinks VulnerabilityAsset[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([organizationId, status])
  @@index([organizationId, criticality])
  @@index([organizationId, nextReviewDate])
  @@map("information_assets")
}

model AssetClassification {
  id                String                    @id @default(cuid())
  organizationId    String
  assetId           String                    @unique
  confidentiality   CIARating                 @default(MEDIUM)
  integrity         CIARating                 @default(MEDIUM)
  availability      CIARating                 @default(MEDIUM)
  classification    InformationClassification @default(INTERNAL)
  legalRequirements String?
  retention         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, classification])
  @@map("asset_classifications")
}

model AssetDependency {
  id               String              @id @default(cuid())
  organizationId   String
  sourceAssetId    String
  dependentAssetId String
  type             AssetDependencyType @default(DEPENDS_ON)
  description      String?
  createdAt        DateTime            @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceAsset    InformationAsset @relation("AssetDependencySource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  dependentAsset InformationAsset @relation("AssetDependencyTarget", fields: [dependentAssetId], references: [id], onDelete: Cascade)

  @@unique([sourceAssetId, dependentAssetId])
  @@index([organizationId, sourceAssetId])
  @@map("asset_dependencies")
}

model AssetRisk {
  id             String   @id @default(cuid())
  organizationId String
  assetId        String
  riskId         String?
  threat         String?
  vulnerability  String?
  description    String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  risk         Risk?            @relation(fields: [riskId], references: [id], onDelete: SetNull)

  @@index([organizationId, assetId])
  @@map("asset_risks")
}

model AssetControl {
  id                    String                    @id @default(cuid())
  organizationId        String
  assetId               String
  organizationControlId String
  status                OrganizationControlStatus @default(NOT_ASSESSED)
  evidenceId            String?
  note                  String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset               InformationAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  evidence            EvidenceFile?       @relation("AssetControlEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@unique([assetId, organizationControlId])
  @@index([organizationId, assetId])
  @@map("asset_controls")
}

// ─── SECURITY INCIDENTS ──────────────────────────────

model SecurityIncident {
  id                   String           @id @default(cuid())
  organizationId       String
  code                 String
  detectedAt           DateTime
  occurredAt           DateTime?
  reporterId           String?
  responsibleId        String?
  severity             IncidentSeverity @default(MEDIUM)
  category             IncidentCategory @default(OTHER)
  description          String
  impact               String?
  status               IncidentStatus   @default(DETECTED)
  notificationRequired Boolean          @default(false)
  notificationDetails  String?
  lessonsLearned       String?
  closedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter       User?                      @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  responsible    User?                      @relation("IncidentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  affectedAssets SecurityIncidentAsset[]
  evidenceLinks  SecurityIncidentEvidence[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@map("security_incidents")
}

model SecurityIncidentAsset {
  id             String   @id @default(cuid())
  organizationId String
  incidentId     String
  assetId        String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  asset        InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([incidentId, assetId])
  @@index([organizationId, incidentId])
  @@map("security_incident_assets")
}

model SecurityIncidentEvidence {
  id             String   @id @default(cuid())
  organizationId String
  incidentId     String
  evidenceId     String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([incidentId, evidenceId])
  @@index([organizationId, incidentId])
  @@map("security_incident_evidences")
}

// ─── VULNERABILITIES ─────────────────────────────────

model Vulnerability {
  id             String                @id @default(cuid())
  organizationId String
  code           String
  source         String
  cve            String?
  severity       VulnerabilitySeverity @default(MEDIUM)
  exposure       String?
  description    String?
  responsibleId  String?
  targetDate     DateTime?
  status         VulnerabilityStatus   @default(OPEN)
  discoveredAt   DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsible  User?                @relation("VulnerabilityResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  assets       VulnerabilityAsset[]
  remediations Remediation[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@map("vulnerabilities")
}

model VulnerabilityAsset {
  id              String   @id @default(cuid())
  organizationId  String
  vulnerabilityId String
  assetId         String
  exposure        String?
  createdAt       DateTime @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vulnerability Vulnerability    @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  asset         InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, assetId])
  @@index([organizationId, vulnerabilityId])
  @@map("vulnerability_assets")
}

model Remediation {
  id              String            @id @default(cuid())
  organizationId  String
  vulnerabilityId String
  description     String
  responsibleId   String?
  targetDate      DateTime?
  status          RemediationStatus @default(PLANNED)
  evidenceId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vulnerability Vulnerability  @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  responsible   User?          @relation("RemediationResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  evidence      EvidenceFile?  @relation("RemediationEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  verifications Verification[]

  @@index([organizationId, vulnerabilityId])
  @@map("remediations")
}

model Verification {
  id             String             @id @default(cuid())
  organizationId String
  remediationId  String
  result         VerificationResult
  notes          String?
  verifiedById   String
  verifiedAt     DateTime           @default(now())
  evidenceId     String?
  createdAt      DateTime           @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediation  Remediation   @relation(fields: [remediationId], references: [id], onDelete: Cascade)
  verifiedBy   User          @relation("VerificationBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  evidence     EvidenceFile? @relation("VerificationEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, remediationId])
  @@map("verifications")
}

// ─── BUSINESS CONTINUITY ─────────────────────────────

model BusinessContinuityPlan {
  id             String               @id @default(cuid())
  organizationId String
  code           String
  title          String
  scope          String?
  ownerId        String?
  status         ContinuityPlanStatus @default(DRAFT)
  rtoMinutes     Int?
  rpoMinutes     Int?
  dependencies   String?
  reviewDate     DateTime?
  nextReviewDate DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User?                  @relation("BcpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  criticalProcesses BCPProcess[]
  drPlans           DisasterRecoveryPlan[]
  scenarios         ContinuityScenario[]
  tests             ContinuityTest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("business_continuity_plans")
}

model BCPProcess {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  processId      String
  rtoMinutes     Int?
  rpoMinutes     Int?
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  process      Process                @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([planId, processId])
  @@index([organizationId, planId])
  @@map("bcp_processes")
}

model DisasterRecoveryPlan {
  id             String               @id @default(cuid())
  organizationId String
  code           String
  title          String
  bcpId          String?
  ownerId        String?
  status         ContinuityPlanStatus @default(DRAFT)
  rtoMinutes     Int?
  rpoMinutes     Int?
  systems        String?
  dependencies   String?
  reviewDate     DateTime?
  nextReviewDate DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bcp          BusinessContinuityPlan? @relation(fields: [bcpId], references: [id], onDelete: SetNull)
  owner        User?                   @relation("DrpOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("disaster_recovery_plans")
}

model ContinuityScenario {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  title          String
  description    String?
  type           String?
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tests        ContinuityTest[]

  @@index([organizationId, planId])
  @@map("continuity_scenarios")
}

model ContinuityTest {
  id             String               @id @default(cuid())
  organizationId String
  planId         String
  scenarioId     String?
  title          String
  type           ContinuityTestType   @default(TABLETOP)
  status         ContinuityTestStatus @default(PLANNED)
  plannedDate    DateTime?
  executedDate   DateTime?
  responsibleId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  scenario     ContinuityScenario?    @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  responsible  User?                  @relation("ContinuityTestResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  results      TestResult[]

  @@index([organizationId, planId])
  @@index([organizationId, status])
  @@map("continuity_tests")
}

model TestResult {
  id                 String                @id @default(cuid())
  organizationId     String
  testId             String
  outcome            ContinuityTestOutcome
  rtoAchievedMinutes Int?
  rpoAchievedMinutes Int?
  summary            String?
  evidenceId         String?
  testedById         String
  testedAt           DateTime              @default(now())
  createdAt          DateTime              @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  test               ContinuityTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  evidence           EvidenceFile?       @relation("TestResultEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  testedBy           User                @relation("TestResultBy", fields: [testedById], references: [id], onDelete: Restrict)
  improvementActions ImprovementAction[]

  @@index([organizationId, testId])
  @@map("test_results")
}

model ImprovementAction {
  id             String                  @id @default(cuid())
  organizationId String
  testResultId   String
  description    String
  responsibleId  String?
  targetDate     DateTime?
  status         ImprovementActionStatus @default(OPEN)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testResult   TestResult   @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("ImprovementActionResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([organizationId, testResultId])
  @@map("improvement_actions")
}

