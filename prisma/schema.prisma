// ─── ISO/IEC 20000 — IT SERVICE MANAGEMENT (ITSM) ────
// Namespace funcional ITSM. No reutiliza SecurityIncident (ISO 27001):
// los incidentes de servicio son ITSMIncident con ITSMIncidentStatus.

model ITService {
  id             String            @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  category       String?
  criticality    ItsmCriticality   @default(MEDIUM)
  status         ItsmServiceStatus @default(ACTIVE)
  processId      String?
  documentId     String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogEntries    ServiceCatalogEntry[]
  owners            ServiceOwner[]
  slas              ServiceLevelAgreement[]
  olas              OperationalLevelAgreement[]
  requests          ServiceRequest[]
  incidents         ITSMIncident[]
  problems          Problem[]
  changes           ITSMChange[]
  releases          Release[]
  cis               ConfigurationItem[]
  availabilityPlans AvailabilityPlan[]
  capacityPlans     CapacityPlan[]
  continuityPlans   ServiceContinuityPlan[]
  suppliers         ServiceSupplier[]
  reports           ServiceReport[]
  articles          KnowledgeArticle[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, criticality])
  @@map("itsm_services")
}

model ServiceCatalogEntry {
  id                        String   @id @default(cuid())
  organizationId            String
  code                      String
  serviceId                 String
  name                      String
  description               String?
  requestable               Boolean  @default(true)
  estimatedFulfillmentHours Float?
  active                    Boolean  @default(true)
  createdById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      ITService        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  requests     ServiceRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, serviceId])
  @@index([organizationId, active])
  @@map("itsm_service_catalog_entries")
}

model ServiceOwner {
  id             String        @id @default(cuid())
  organizationId String
  code           String
  serviceId      String
  userId         String?
  ownerName      String?
  ownershipRole  ItsmOwnerRole @default(PRIMARY)
  effectiveFrom  DateTime      @default(now())
  effectiveTo    DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      ITService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, serviceId])
  @@map("itsm_service_owners")
}

model ServiceLevelAgreement {
  id                    String              @id @default(cuid())
  organizationId        String
