  materializationPlan     String?
  materializationEvidence String?
  dueDate                 DateTime?
  materializedAt          DateTime?
  closedAt                DateTime?
  rejectionReason         String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewer     User?        @relation("OpportunityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, reviewerId, status])
  @@map("opportunities")
}

// ─── ACTIONS ─────────────────────────────────────────

model Action {
  id                         String       @id @default(cuid())
  organizationId             String
  title                      String
  description                String?
  type                       ActionType   @default(CORRECTIVE)
  priority                   Priority     @default(MEDIUM)
  status                     ActionStatus @default(PENDING)
  stage                      ACPMStage    @default(REQUEST)
  source                     String?
  rootCause                  String?
  proposedSolution           String?
  effectivenessCheck         String?
  effectivenessAt            DateTime?
  ownerId                    String?
  requestedById              String?
  requestApproverId          String?
  solutionApproverId         String?
  dueDate                    DateTime?
  completedAt                DateTime?
  progress                   Int          @default(0)
  riskId                     String?
  nonconformityId            String?
  managementReviewId         String?
  managementReviewDecisionId String?      @unique
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk                     Risk?                     @relation(fields: [riskId], references: [id])
  nonconformity            Nonconformity?            @relation(fields: [nonconformityId], references: [id])
  managementReview         ManagementReview?         @relation(fields: [managementReviewId], references: [id])
  managementReviewDecision ManagementReviewDecision? @relation(fields: [managementReviewDecisionId], references: [id], onDelete: SetNull)
