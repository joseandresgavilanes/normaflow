  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@unique([organizationId, investigationId])
  @@index([organizationId, status])
  @@index([organizationId, allegationType])
  @@index([organizationId, speakUpReportId])
  @@map("anti_bribery_investigations")
}

// ─── ISO 50001:2018 ENERGY MANAGEMENT SYSTEM ─────────
// Specialized EnMS models. Cross-module refs (process, location, supplier,
// CAPA, indicator, document, evidence) are scalar ids validated org-scoped
// in server actions. Formulas for EnPI / savings / emissions are configurable
// and versioned on the EnPI / baseline / verification records themselves.

model EnergySource {
  id             String           @id @default(cuid())
  organizationId String
  code           String
  name           String
  sourceType     EnergySourceType @default(ELECTRICITY)
  unit           String           @default("kWh")
  /// Factor de emisión configurable (tCO2e / unidad).
  emissionFactor Float?
  emissionUnit   String?          @default("tCO2e")
  /// Coste unitario configurable (moneda / unidad).
  costPerUnit    Float?
  currency       String?          @default("EUR")
  renewableShare Float?
  supplierId     String?
  active         Boolean          @default(true)
  notes          String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uses         EnergyUse[]
  meters       EnergyMeter[]

  @@unique([organizationId, code])
  @@index([organizationId, sourceType])
  @@index([organizationId, active])
  @@map("energy_sources")
}

model EnergyUse {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  sourceId       String?
  processId      String?
  locationId     String?
  equipment      String?
  /// Consumo estimado anual en la unidad de la fuente.
  annualEstimate Float?
  unit           String   @default("kWh")
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       EnergySource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  significant  SignificantEnergyUse[]

  @@unique([organizationId, code])
  @@index([organizationId, sourceId])
  @@index([organizationId, processId])
  @@map("energy_uses")
}

model SignificantEnergyUse {
  id                   String         @id @default(cuid())
  organizationId       String
  code                 String
  energyUseId          String
  reviewId             String?
  /// Criterios de significancia (consumo, potencial de mejora, etc.) como Json.
  criteria             Json?
  consumptionShare     Float?
  improvementPotential Float?
  significant          Boolean        @default(true)
  rationale            String?
  ownerId              String?
  status               EnmsItemStatus @default(ACTIVE)
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  energyUse     EnergyUse                    @relation(fields: [energyUseId], references: [id], onDelete: Cascade)
  review        EnergyReview?                @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  baselines     EnergyBaseline[]
  enpis         EnergyPerformanceIndicator[]
  meters        EnergyMeter[]
  opportunities EnergyOpportunity[]

  @@unique([organizationId, code])
  @@index([organizationId, significant])
  @@index([organizationId, reviewId])
  @@index([energyUseId])
  @@map("significant_energy_uses")
}

model EnergyReview {
  id             String             @id @default(cuid())
  organizationId String
  code           String
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  scope          String?
  methodSummary  String?
  findings       String?
  status         EnergyReviewStatus @default(DRAFT)
  reviewedById   String?
  reviewedAt     DateTime?
  approvedById   String?
  approvedAt     DateTime?
  documentId     String?
  evidenceId     String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  significantUses SignificantEnergyUse[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, periodEnd])
  @@map("energy_reviews")
}

model EnergyBaseline {
  id                     String         @id @default(cuid())
  organizationId         String
  code                   String
  title                  String
  seuId                  String?
  periodStart            DateTime
  periodEnd              DateTime
  consumption            Float
  unit                   String         @default("kWh")
  /// Valores de variables relevantes en el periodo base (Json).
  relevantVariableValues Json?
  staticFactorValues     Json?
  /// Método de normalización versionado: NONE | RATIO | LINEAR | CUSTOM.
  normalizationMethod    String         @default("NONE")
  formulaVersion         String         @default("1")
  formulaConfig          Json?
  normalizedConsumption  Float?
  status                 EnmsItemStatus @default(ACTIVE)
  approvedById           String?
  approvedAt             DateTime?
  documentId             String?
  createdById            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seu          SignificantEnergyUse?        @relation(fields: [seuId], references: [id], onDelete: SetNull)
  enpis        EnergyPerformanceIndicator[]

  @@unique([organizationId, code, formulaVersion])
  @@index([organizationId, code])
  @@index([organizationId, seuId])
  @@index([organizationId, status])
  @@map("energy_baselines")
}

/// EnPI con fórmula configurable y versionada (ISO 50001 §6.3 / §9.1).
model EnergyPerformanceIndicator {
  id               String            @id @default(cuid())
  organizationId   String
  code             String
  name             String
  description      String?
  seuId            String?
  baselineId       String?
  /// Tipo de fórmula: INTENSITY | CONSUMPTION | CUSTOM | …
  formulaKind      EnergyFormulaKind @default(INTENSITY)
  formulaVersion   String            @default("1")
  /// Configuración de la fórmula (coeficientes, denominador, factores).
  formulaConfig    Json?
  unit             String            @default("kWh/unit")
  targetValue      Float?
  currentValue     Float?
  baselineValue    Float?
  deviationPercent Float?
  /// Reutiliza Indicator corporativo cuando existe.
  indicatorId      String?
  active           Boolean           @default(true)
  superseded       Boolean           @default(false)
  approvedById     String?
  approvedAt       DateTime?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seu          SignificantEnergyUse? @relation(fields: [seuId], references: [id], onDelete: SetNull)
  baseline     EnergyBaseline?       @relation(fields: [baselineId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code, formulaVersion])
  @@index([organizationId, active])
  @@index([organizationId, formulaKind])
  @@index([organizationId, seuId])
  @@map("energy_performance_indicators")
}

model EnergyMeter {
  id              String    @id @default(cuid())
  organizationId  String
  code            String
  name            String
  sourceId        String?
  seuId           String?
  locationId      String?
  serialNumber    String?
  unit            String    @default("kWh")
  calibrationDate DateTime?
  nextCalibration DateTime?
  active          Boolean   @default(true)
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       EnergySource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  seu          SignificantEnergyUse? @relation(fields: [seuId], references: [id], onDelete: SetNull)
  readings     EnergyReading[]

  @@unique([organizationId, code])
  @@index([organizationId, sourceId])
  @@index([organizationId, active])
  @@map("energy_meters")
}

model EnergyReading {
  id                     String    @id @default(cuid())
  organizationId         String
  code                   String
  meterId                String
  readingAt              DateTime  @default(now())
  periodStart            DateTime?
  periodEnd              DateTime?
  value                  Float
  unit                   String    @default("kWh")
  estimated              Boolean   @default(false)
  /// Snapshot de variables relevantes del periodo (Json).
  relevantVariableValues Json?
  cost                   Float?
  emissions              Float?
  notes                  String?
  createdById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meter        EnergyMeter  @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, meterId])
  @@index([organizationId, readingAt])
  @@index([organizationId, periodStart, periodEnd])
  @@map("energy_readings")
}

model RelevantVariable {
  id             String               @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  unit           String
  variableType   RelevantVariableType @default(PRODUCTION)
  active         Boolean              @default(true)
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, variableType])
  @@map("relevant_variables")
}

model StaticFactor {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  value          Float
  unit           String
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  active         Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("static_factors")
}

model EnergyOpportunity {
  id              String                    @id @default(cuid())
  organizationId  String
  code            String
  title           String
  description     String?
  seuId           String?
  estimatedSaving Float?
  savingUnit      String?                   @default("kWh")
  estimatedCost   Float?
  currency        String?                   @default("EUR")
  paybackMonths   Float?
  priority        EnergyOpportunityPriority @default(MEDIUM)
  status          EnergyOpportunityStatus   @default(IDENTIFIED)
  ownerId         String?
  identifiedAt    DateTime                  @default(now())
  documentId      String?
  createdById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seu          SignificantEnergyUse? @relation(fields: [seuId], references: [id], onDelete: SetNull)
  actionPlans  EnergyActionPlan[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@map("energy_opportunities")
}

model EnergyActionPlan {
  id              String             @id @default(cuid())
  organizationId  String
  code            String
  title           String
  description     String?
  opportunityId   String?
  ownerId         String?
  startDate       DateTime?
  dueDate         DateTime?
  progressPercent Int                @default(0)
  status          EnergyActionStatus @default(PLANNED)
  /// Reutiliza CAPA corporativo cuando la acción es correctiva formal.
  capaId          String?
  documentId      String?
  evidenceId      String?
  completedAt     DateTime?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity   EnergyOpportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  verifications EnergySavingVerification[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, opportunityId])
  @@index([organizationId, dueDate])
  @@map("energy_action_plans")
}

model EnergySavingVerification {
  id                  String                   @id @default(cuid())
  organizationId      String
  code                String
  actionPlanId        String
  periodStart         DateTime
  periodEnd           DateTime
  baselineConsumption Float?
  actualConsumption   Float?
  absoluteSaving      Float?
  normalizedSaving    Float?
  unit                String                   @default("kWh")
  costSaving          Float?
  emissionSaving      Float?
  /// Fórmula de verificación versionada (IPMVP-like configurable).
  formulaKind         EnergyFormulaKind        @default(ABSOLUTE_SAVINGS)
  formulaVersion      String                   @default("1")
  formulaConfig       Json?
  status              EnergyVerificationStatus @default(DRAFT)
  verifiedById        String?
  verifiedAt          DateTime?
  notes               String?
  evidenceId          String?
  createdById         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionPlan   EnergyActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, actionPlanId])
  @@index([organizationId, status])
  @@map("energy_saving_verifications")
}

model EnergyProcurementEvaluation {
  id             String                  @id @default(cuid())
  organizationId String
  code           String
  title          String
  sourceType     EnergySourceType        @default(ELECTRICITY)
  supplierId     String?
  supplierName   String?
  period         String?
  evaluatedAt    DateTime                @default(now())
  /// Criterios (precio, renovable, fiabilidad…) como Json puntuado.
  criteriaScores Json?
  totalScore     Float?
  result         EnergyProcurementResult @default(UNDER_REVIEW)
  recommendation String?
  documentId     String?
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, result])
  @@index([organizationId, supplierId])
  @@map("energy_procurement_evaluations")
}

model EnergyDesignReview {
  id                      String                   @id @default(cuid())
  organizationId          String
  code                    String
  title                   String
  projectReference        String?
  processId               String?
  locationId              String?
  description             String?
  energyConsiderations    String?
  opportunitiesIdentified String?
  status                  EnergyDesignReviewStatus @default(DRAFT)
  reviewedById            String?
  reviewedAt              DateTime?
  documentId              String?
  evidenceId              String?
  createdById             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, processId])
  @@map("energy_design_reviews")
}

// ─── ISO 22000:2018 / HACCP FOOD SAFETY ──────────────
// SGIA: productos, flujo, peligros, PRP/OPRP/CCP, monitoreo, trazabilidad
// y retiro. Referencias a Process/Supplier/CAPA/Document/Evidence por id
// escalar validado en server actions. Trazabilidad hacia atrás/adelante
// sobre TraceabilityLot.previousLotIds (JSON).

model FoodProduct {
  id                String   @id @default(cuid())
  organizationId    String
  code              String
  name              String
  description       String?
  category          String?
  shelfLifeDays     Int?
  storageConditions String?
  /// Códigos de alérgenos presentes (Allergen.code[]).
  allergenCodes     String[] @default([])
  processId         String?
  active            Boolean  @default(true)
  documentId        String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intendedUses IntendedUse[]
  processFlows ProcessFlow[]
  lots         TraceabilityLot[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("food_products")
}

model RawMaterial {
  id                String   @id @default(cuid())
  organizationId    String
  code              String
  name              String
  description       String?
  supplierId        String?
  specification     String?
  allergenCodes     String[] @default([])
  storageConditions String?
  active            Boolean  @default(true)
  documentId        String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lots         TraceabilityLot[]

  @@unique([organizationId, code])
  @@index([organizationId, supplierId])
  @@map("raw_materials")
}

model IntendedUse {
  id                  String   @id @default(cuid())
  organizationId      String
  code                String
  productId           String
  consumerGroup       String?
  preparationMethod   String?
  vulnerableConsumers Boolean  @default(false)
  misusePotential     String?
  notes               String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      FoodProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, productId])
  @@map("intended_uses")
}

model ProcessFlow {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  productId      String
  title          String
  version        String         @default("1")
  status         FoodFlowStatus @default(DRAFT)
  verifiedOnSite Boolean        @default(false)
  verifiedAt     DateTime?
  verifiedById   String?
  notes          String?
  documentId     String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      FoodProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  steps        ProcessStep[]

  @@unique([organizationId, code, version])
  @@index([organizationId, productId])
  @@index([organizationId, status])
  @@map("process_flows")
}

model ProcessStep {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  flowId         String
  sequence       Int
  name           String
  stepType       FoodStepType @default(PROCESS)
  description    String?
  processId      String?
  temperature    String?
  timeParam      String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flow              ProcessFlow            @relation(fields: [flowId], references: [id], onDelete: Cascade)
  hazardAssessments HazardAssessment[]
  operationalPrps   OperationalPRP[]
  ccps              CriticalControlPoint[]

  @@unique([organizationId, code])
  @@unique([flowId, sequence])
  @@index([organizationId, flowId])
  @@map("process_steps")
}

model FoodHazard {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  name           String
  hazardType     FoodHazardType @default(BIOLOGICAL)
  description    String?
  source         String?
  active         Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessments  HazardAssessment[]

  @@unique([organizationId, code])
  @@index([organizationId, hazardType])
  @@map("food_hazards")
}

model HazardAssessment {
  id               String                @id @default(cuid())
  organizationId   String
  code             String
  hazardId         String
  stepId           String?
  productId        String?
  severity         Int                   @default(3)
  likelihood       Int                   @default(3)
  score            Int                   @default(9)
  significant      Boolean               @default(false)
  /// Decisión de control: PRP | OPRP | CCP | NONE
  controlDecision  HazardControlDecision @default(NONE)
  justification    String?
  existingMeasures String?
  status           FoodAssessmentStatus  @default(DRAFT)
  assessedAt       DateTime              @default(now())
  assessedById     String?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hazard          FoodHazard             @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  step            ProcessStep?           @relation(fields: [stepId], references: [id], onDelete: SetNull)
  operationalPrps OperationalPRP[]
  ccps            CriticalControlPoint[]

  @@unique([organizationId, code])
  @@index([organizationId, significant])
  @@index([organizationId, controlDecision])
