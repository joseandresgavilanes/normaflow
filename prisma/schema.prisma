// NormaFlow Database Schema
// Proveedor: Supabase Postgres
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ORGANIZATIONS & USERS ───────────────────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  industry    String?
  country     String    @default("ES")
  logoUrl     String?
  plan        Plan      @default(STARTER)
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships     Membership[]
  standards       OrganizationStandard[]
  assessments     Assessment[]
  documents       Document[]
  processes       Process[]
  risks           Risk[]
  audits          Audit[]
  nonconformities Nonconformity[]
  actions         Action[]
  indicators      Indicator[]
  evidenceFiles   EvidenceFile[]
  notifications   Notification[]
  subscription    Subscription?
  billingInvoices BillingInvoice[]
  reportExports   ReportExport[]
  auditLogs       AuditLog[]

  // ISOTech manual alignment
  groups              Group[]
  positions           Position[]
  personnel           Personnel[]
  locations           Location[]
  retentionTimes      RetentionTime[]
  dispositions        Disposition[]
  archiveMethods      ArchiveMethod[]
  recordTypes         RecordType[]
  records             Record[]
  auditPrograms       AuditProgram[]
  managementReviews   ManagementReview[]
  trainingCourses     TrainingCourse[]
  trainingAssignments TrainingAssignment[]
  changeRequests      ChangeRequest[]
  suppliers           Supplier[]
  integrations        Integration[]
  memberInvites       MemberInvite[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  authUserId   String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  sentInvites    MemberInvite[] @relation("InvitedBy")
  ownedDocuments Document[]     @relation("DocumentOwner")
  reportExports  ReportExport[] @relation("ReportGeneratedBy")

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(CONTRIBUTOR)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model MemberInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(CONTRIBUTOR)
  token          String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("member_invites")
}

// ─── STANDARDS & CLAUSES ─────────────────────────────

model Standard {
  id          String  @id @default(cuid())
  code        String  @unique // ISO_9001, ISO_27001
  name        String
  version     String
  description String?
  isActive    Boolean @default(true)

  clauses      Clause[]
  assessments  Assessment[]
  orgStandards OrganizationStandard[]

  @@map("standards")
}

model Clause {
  id          String  @id @default(cuid())
  standardId  String
  code        String // e.g. "4.1", "6.1.2"
  title       String
  description String?
  parentId    String?
  order       Int     @default(0)

  standard          Standard           @relation(fields: [standardId], references: [id])
  parent            Clause?            @relation("ClauseParent", fields: [parentId], references: [id])
  children          Clause[]           @relation("ClauseParent")
  assessmentAnswers AssessmentAnswer[]
  documents         Document[]

  @@map("clauses")
}

model OrganizationStandard {
  id             String    @id @default(cuid())
  organizationId String
  standardId     String
  startedAt      DateTime  @default(now())
  targetDate     DateTime?
  score          Float?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard     @relation(fields: [standardId], references: [id])

  @@unique([organizationId, standardId])
  @@map("organization_standards")
}

// ─── GAP ASSESSMENT ──────────────────────────────────

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  standardId     String
  title          String
  type           AssessmentType   @default(INTERNAL)
  status         AssessmentStatus @default(IN_PROGRESS)
  globalScore    Float?
  assessorId     String?
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard           @relation(fields: [standardId], references: [id])
  answers      AssessmentAnswer[]

  @@map("assessments")
}

model AssessmentAnswer {
  id           String       @id @default(cuid())
  assessmentId String
  clauseId     String
  score        Int          @default(0) // 0-100
  status       ClauseStatus @default(NOT_EVALUATED)
  comment      String?
  evidence     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  clause     Clause     @relation(fields: [clauseId], references: [id])

  @@unique([assessmentId, clauseId])
  @@map("assessment_answers")
}

// ─── DOCUMENT CONTROL ────────────────────────────────

model Document {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  title          String
  type           DocumentType
  status         DocumentStatus @default(DRAFT)
  clauseId       String?
  processId      String?
  standardCode   String?
  currentVersion String         @default("1.0")
  ownerId        String?
  reviewDate     DateTime?
  tags           String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // ISOTech manual § 12
  isExternal               Boolean  @default(false)
  externalLink             String?
  custodianId              String?
  responsibleElaborationId String?
  responsibleApprovalId    String?
  locationId               String?
  physicalLocation         String?
  distributionList         String[]
  observations             String?

  organization                 Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clause                       Clause?                  @relation(fields: [clauseId], references: [id])
  process                      Process?                 @relation(fields: [processId], references: [id], onDelete: SetNull)
  location                     Location?                @relation(fields: [locationId], references: [id])
  owner                        User?                    @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  responsibleElaboration       Personnel?               @relation("DocumentElaborationResponsible", fields: [responsibleElaborationId], references: [id], onDelete: SetNull)
  responsibleApproval          Personnel?               @relation("DocumentApprovalResponsible", fields: [responsibleApprovalId], references: [id], onDelete: SetNull)
  custodian                    Personnel?               @relation("DocumentCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  versions                     DocumentVersion[]
  approvals                    Approval[]
  trainingCourseLinks          TrainingCourseDocument[]
  triggeredTrainingAssignments TrainingAssignment[]     @relation("TrainingTriggerDocument")
  changeLinks                  ChangeDocument[]
  supplierLinks                SupplierDocument[]

  @@unique([organizationId, code])
  @@index([processId])
  @@index([ownerId])
  @@index([responsibleElaborationId])
  @@index([responsibleApprovalId])
  @@index([custodianId])
  @@map("documents")
}

model DocumentVersion {
  id                String   @id @default(cuid())
  documentId        String
  version           String
  fileUrl           String?
  fileSize          Int?
  mimeType          String?
  changeLog         String?
  changeDescription String?
  previousVersion   String?
  createdById       String?
  createdAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

model Approval {
  id         String         @id @default(cuid())
  documentId String
  approverId String
  status     ApprovalStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

// ─── PROCESSES ───────────────────────────────────────

model Process {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  type           String? // core, support, strategic
  description    String?
  ownerId        String?
  inputs         String[]
  outputs        String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents           Document[]
  risks               Risk[]
  indicators          Indicator[]
  trainingAssignments TrainingAssignment[]
  changeLinks         ChangeProcess[]
  records             Record[]

  @@map("processes")
}

// ─── RISK MANAGEMENT ─────────────────────────────────

model Risk {
  id             String        @id @default(cuid())
  organizationId String
  processId      String?
  title          String
  description    String?
  category       String
  probability    Int // 1-5
  impact         Int // 1-5
  score          Int // probability * impact
  status         RiskStatus    @default(IDENTIFIED)
  treatment      RiskTreatment @default(MITIGATE)
  ownerId        String?
  dueDate        DateTime?
  residualScore  Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process       Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  controls      Control[]
  actions       Action[]
  changeLinks   ChangeRisk[]
  supplierLinks SupplierRisk[]

  @@index([processId])
  @@map("risks")
}

model Control {
  id          String        @id @default(cuid())
  riskId      String
  title       String
  description String?
  type        ControlType   @default(PREVENTIVE)
  status      ControlStatus @default(PLANNED)
  ownerId     String?
  createdAt   DateTime      @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@map("controls")
}

// ─── AUDITS ──────────────────────────────────────────

model Audit {
  id              String      @id @default(cuid())
  organizationId  String
  programId       String?
  title           String
  type            AuditType   @default(INTERNAL)
  standardCode    String?
  status          AuditStatus @default(PLANNED)
  auditorId       String?
  auditorExternal String?
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  scope           String?
  objectives      String?
  criteria        String?
  reportUrl       String?
  progress        Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program         AuditProgram?        @relation(fields: [programId], references: [id])
  findings        AuditFinding[]
  nonconformities Nonconformity[]
  checklistItems  AuditChecklistItem[]

  @@map("audits")
}

model AuditFinding {
  id          String          @id @default(cuid())
  auditId     String
  title       String
  description String?
  type        FindingType     @default(OBSERVATION)
  severity    FindingSeverity @default(MINOR)
  clauseCode  String?
  status      FindingStatus   @default(OPEN)
  evidenceUrl String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  audit         Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity?

  @@map("audit_findings")
}

// ─── NONCONFORMITIES / CAPA ──────────────────────────

model Nonconformity {
  id                     String     @id @default(cuid())
  organizationId         String
  auditId                String?
  findingId              String?    @unique
  title                  String
  description            String?
  source                 NCSource   @default(INTERNAL_AUDIT)
  severity               NCSeverity @default(MINOR)
  status                 NCStatus   @default(OPEN)
  ownerId                String?
  rootCause              String?
  dueDate                DateTime?
  closedAt               DateTime?
  effectivenessValidated Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit          Audit?                  @relation(fields: [auditId], references: [id])
  finding        AuditFinding?           @relation(fields: [findingId], references: [id])
  actions        Action[]
  changeRequests ChangeRequest[]
  supplierLinks  SupplierNonconformity[]

  @@map("nonconformities")
}

// ─── ACTIONS ─────────────────────────────────────────

model Action {
  id                 String       @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  type               ActionType   @default(CORRECTIVE)
  priority           Priority     @default(MEDIUM)
  status             ActionStatus @default(PENDING)
  stage              ACPMStage    @default(REQUEST)
  source             String?
  rootCause          String?
  proposedSolution   String?
  effectivenessCheck String?
  effectivenessAt    DateTime?
  ownerId            String?
  requestedById      String?
  requestApproverId  String?
  solutionApproverId String?
  dueDate            DateTime?
  completedAt        DateTime?
  progress           Int          @default(0)
  riskId             String?
  nonconformityId    String?
  managementReviewId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk             Risk?             @relation(fields: [riskId], references: [id])
  nonconformity    Nonconformity?    @relation(fields: [nonconformityId], references: [id])
  managementReview ManagementReview? @relation(fields: [managementReviewId], references: [id])
  comments         ActionComment[]

  @@map("actions")
}

model ActionComment {
  id        String   @id @default(cuid())
  actionId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_comments")
}

// ─── INDICATORS ──────────────────────────────────────

model Indicator {
  id             String          @id @default(cuid())
  organizationId String
  processId      String?
  name           String
  description    String?
  unit           String
  target         Float
  frequency      String          @default("monthly")
  ownerId        String?
  status         IndicatorStatus @default(ON_TRACK)
  clauseCode     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?         @relation(fields: [processId], references: [id], onDelete: SetNull)
  values       IndicatorValue[]

  @@index([processId])
  @@map("indicators")
}

model IndicatorValue {
  id          String   @id @default(cuid())
  indicatorId String
  value       Float
  period      String // "2025-06"
  note        String?
  createdAt   DateTime @default(now())

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@map("indicator_values")
}

// ─── EVIDENCE ────────────────────────────────────────

model EvidenceFile {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  module         String? // process, risk, audit, nc, indicator, document, change, supplier, integration
  moduleId       String?
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("evidence_files")
}

// ─── NOTIFICATIONS ───────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  type           NotificationType @default(INFO)
  read           Boolean          @default(false)
  readAt         DateTime?
  link           String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ─── BILLING ─────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     BillingInvoice[]

  @@map("subscriptions")
}

model BillingInvoice {
  id               String    @id @default(cuid())
  organizationId   String
  subscriptionId   String?
  stripeInvoiceId  String    @unique
  number           String?
  status           String
  currency         String    @default("eur")
  amountDue        Int
  amountPaid       Int       @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?
  hostedInvoiceUrl String?
  invoicePdf       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([subscriptionId])
  @@map("billing_invoices")
}

model ReportExport {
  id             String       @id @default(cuid())
  organizationId String
  generatedById  String?
  reportType     String
  format         ReportFormat
  dateFrom       DateTime
  dateTo         DateTime
  rowCount       Int
  fileName       String
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([generatedById])
  @@map("report_exports")
}

// ─── AUDIT LOGS ──────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  module         String
  recordId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── ISOTECH MANUAL ALIGNMENT ───────────────────────
// Models that extend the SaaS to cover the ISOTech functional reference.
// All entities are tenant-scoped via organizationId.

// § 10.2 Grupos / § 10.3 Permiso a Grupo / § 10.4 Usuarios de Grupo
model Group {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMembership[]
  permissions  GroupPermission[]

  @@unique([organizationId, name])
  @@map("groups")
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_memberships")
}

model GroupPermission {
  id         String @id @default(cuid())
  groupId    String
  permission String // e.g. "documents:create", "records:*"

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, permission])
  @@map("group_permissions")
}

// § 11.1 Cargo
model Position {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnel    Personnel[]

  @@unique([organizationId, name])
  @@map("positions")
}

// § 11.3 Datos Personal
model Personnel {
  id             String    @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  identification String?
  positionId     String?
  active         Boolean   @default(true)
  hiredAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position              Position?                @relation(fields: [positionId], references: [id])
  trainingAssignments   TrainingAssignment[]
  trainingAudienceLinks TrainingCourseAudience[]
  documentsElaborated   Document[]               @relation("DocumentElaborationResponsible")
  documentsApproved     Document[]               @relation("DocumentApprovalResponsible")
  documentsCustodied    Document[]               @relation("DocumentCustodian")
  recordsCustodied      Record[]                 @relation("RecordCustodian")

  @@map("personnel")
}

// ─── TRAINING MANAGEMENT ─────────────────────────────────

model TrainingCourse {
  id                      String   @id @default(cuid())
  organizationId          String
  code                    String
  title                   String
  description             String?
  standardTags            String[] @default([])
  defaultValidityMonths   Int      @default(12)
  defaultDueDays          Int      @default(30)
  mandatory               Boolean  @default(false)
  autoAssignOnDocApproval Boolean  @default(false)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentLinks TrainingCourseDocument[]
  audienceLinks TrainingCourseAudience[]
  assignments   TrainingAssignment[]
  changeLinks   ChangeTrainingCourse[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("training_courses")
}

model TrainingCourseDocument {
  courseId   String
  documentId String

  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([courseId, documentId])
  @@index([documentId])
  @@map("training_course_documents")
}

model TrainingCourseAudience {
  courseId    String
  personnelId String

  course    TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personnel Personnel      @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@id([courseId, personnelId])
  @@index([personnelId])
  @@map("training_course_audience")
}

model TrainingAssignment {
  id                    String                   @id @default(cuid())
  organizationId        String
  courseId              String
  personnelId           String
  processId             String?
  status                TrainingAssignmentStatus @default(ASSIGNED)
  assignedAt            DateTime                 @default(now())
  dueAt                 DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  evidenceNote          String?
  evidenceUrl           String?
  triggeredByDocumentId String?
  triggeredByVersion    String?
  reminderSentAt        DateTime?
  createdById           String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course              TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  personnel           Personnel      @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  process             Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  triggeredByDocument Document?      @relation("TrainingTriggerDocument", fields: [triggeredByDocumentId], references: [id], onDelete: SetNull)

  @@unique([courseId, personnelId, triggeredByDocumentId, triggeredByVersion])
  @@index([organizationId, status])
  @@index([personnelId, dueAt])
  @@index([courseId])
  @@map("training_assignments")
}

// ─── CHANGE CONTROL ─────────────────────────────────────

model ChangeRequest {
  id              String              @id @default(cuid())
  organizationId  String
  code            String
  title           String
  category        String
  changeType      String
  reason          String
  impact          ChangeImpact        @default(MEDIUM)
  affectedAreas   String[]            @default([])
  status          ChangeRequestStatus @default(DRAFT)
  requesterId     String?
  requesterName   String?
  nonconformityId String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  implementedAt   DateTime?
  verifiedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nonconformity   Nonconformity?         @relation(fields: [nonconformityId], references: [id], onDelete: SetNull)
  processes       ChangeProcess[]
  documents       ChangeDocument[]
  risks           ChangeRisk[]
  trainingCourses ChangeTrainingCourse[]
  approvers       ChangeApprover[]
  tasks           ChangeTask[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([nonconformityId])
  @@map("change_requests")
}

model ChangeProcess {
  changeRequestId String
  processId       String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  process       Process       @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, processId])
  @@index([processId])
  @@map("change_processes")
}

model ChangeDocument {
  changeRequestId String
  documentId      String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, documentId])
  @@index([documentId])
  @@map("change_documents")
}

model ChangeRisk {
  changeRequestId String
  riskId          String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  risk          Risk          @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, riskId])
  @@index([riskId])
  @@map("change_risks")
}

model ChangeTrainingCourse {
  changeRequestId String
  courseId        String

  changeRequest ChangeRequest  @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, courseId])
  @@index([courseId])
  @@map("change_training_courses")
}

model ChangeApprover {
  id                String         @id @default(cuid())
  changeRequestId   String
  userId            String
  status            ApprovalStatus @default(PENDING)
  comment           String?
  decidedAt         DateTime?
  attestationReason String?
  createdAt         DateTime       @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@unique([changeRequestId, userId])
  @@index([userId])
  @@map("change_approvers")
}

model ChangeTask {
  id              String    @id @default(cuid())
  changeRequestId String
  title           String
  done            Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId, done])
  @@map("change_tasks")
}

// ─── SUPPLIER MANAGEMENT ─────────────────────────────────

model Supplier {
  id               String              @id @default(cuid())
  organizationId   String
  code             String
  name             String
  category         String
  criticality      SupplierCriticality @default(MEDIUM)
  ownerId          String?
  status           SupplierStatus      @default(UNDER_REVIEW)
  contactName      String?
  contactEmail     String?
  notes            String?
  nextReviewDue    DateTime?
  lastEvaluationAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents       SupplierDocument[]
  risks           SupplierRisk[]
  nonconformities SupplierNonconformity[]
  evaluations     SupplierEvaluation[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([nextReviewDue])
  @@map("suppliers")
}

model SupplierDocument {
  supplierId String
  documentId String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([supplierId, documentId])
  @@index([documentId])
  @@map("supplier_documents")
}

model SupplierRisk {
  supplierId String
  riskId     String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  risk     Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@id([supplierId, riskId])
  @@index([riskId])
  @@map("supplier_risks")
}

model SupplierNonconformity {
  supplierId      String
  nonconformityId String

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)

  @@id([supplierId, nonconformityId])
  @@index([nonconformityId])
  @@map("supplier_nonconformities")
}

model SupplierEvaluation {
  id            String                    @id @default(cuid())
  supplierId    String
  score         Int?
  outcome       SupplierEvaluationOutcome
  notes         String?
  evaluatedById String?
  evaluatedAt   DateTime                  @default(now())
  nextReviewDue DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, evaluatedAt])
  @@map("supplier_evaluations")
}

// ─── INTEGRATIONS ────────────────────────────────────────

model Integration {
  id               String            @id @default(cuid())
  organizationId   String
  key              String
  name             String
  provider         String
  category         String
  description      String?
  valueProposition String?
  status           IntegrationStatus @default(NOT_CONNECTED)
  externalAccount  String?
  config           Json?
  detailNote       String?
  lastSyncAt       DateTime?
  connectedAt      DateTime?
  configuredById   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncRuns     IntegrationSyncRun[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("integrations")
}

model IntegrationSyncRun {
  id               String                @id @default(cuid())
  integrationId    String
  status           IntegrationSyncStatus @default(RUNNING)
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  recordsProcessed Int                   @default(0)
  evidenceCreated  Int                   @default(0)
  errorMessage     String?
  metadata         Json?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
  @@map("integration_sync_runs")
}

// § 12.1.1 Lugar
model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([organizationId, name])
  @@map("locations")
}

// § 13.1.1 Tiempo de Retención
model RetentionTime {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  months         Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("retention_times")
}

// § 13.1.2 Disposición
model Disposition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("dispositions")
}

// § 13.1.3 Método de Archivo
model ArchiveMethod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("archive_methods")
}

// § 13.1.4 Tipo de Registro
model RecordType {
  id             String   @id @default(cuid())
  organizationId String
  name           String // FISICO, ELECTRONICO, FISICO_Y_ELECTRONICO, ...
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("record_types")
}

// § 13.2 Control de Registros
model Record {
  id               String   @id @default(cuid())
  organizationId   String
  code             String
  name             String
  processId        String?
  recordTypeId     String?
  retentionTimeId  String?
  dispositionId    String?
  archiveMethodId  String?
  custodianId      String?
  physicalLocation String?
  digitalLocation  String?
  observations     String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process       Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  recordType    RecordType?    @relation(fields: [recordTypeId], references: [id])
  retentionTime RetentionTime? @relation(fields: [retentionTimeId], references: [id])
  disposition   Disposition?   @relation(fields: [dispositionId], references: [id])
  archiveMethod ArchiveMethod? @relation(fields: [archiveMethodId], references: [id])
  custodian     Personnel?     @relation("RecordCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  entries       RecordEntry[]

  @@unique([organizationId, code])
  @@index([processId])
  @@index([custodianId])
  @@map("records")
}

model RecordEntry {
  id          String   @id @default(cuid())
  recordId    String
  reference   String? // e.g. registry number, batch
  description String?
  fileName    String?
  fileUrl     String?
  fileSize    Int?
  mimeType    String?
  enteredById String?
  enteredAt   DateTime @default(now())

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("record_entries")
}

// § 15 Programa de Auditoría (annual program grouping audits)
model AuditProgram {
  id             String             @id @default(cuid())
  organizationId String
  year           Int
  title          String
  objectives     String?
  scope          String?
  status         AuditProgramStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audits       Audit[]

  @@unique([organizationId, year, title])
  @@map("audit_programs")
}

model AuditChecklistItem {
  id          String              @id @default(cuid())
  auditId     String
  clauseCode  String?
  question    String
  expected    String?
  response    String?
  status      ChecklistItemStatus @default(PENDING)
  evidenceUrl String?
  notes       String?
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("audit_checklist_items")
}

// § 16 Revisión por la Dirección
model ManagementReview {
  id             String                 @id @default(cuid())
  organizationId String
  title          String
  scheduledDate  DateTime?
  heldAt         DateTime?
  status         ManagementReviewStatus @default(PLANNED)
  chairId        String?
  attendees      String[] // free-text names or user IDs
  summary        String?
  reportUrl      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inputs       ManagementReviewInput[]
  decisions    ManagementReviewDecision[]
  actions      Action[]

  @@map("management_reviews")
}

model ManagementReviewInput {
  id        String                @id @default(cuid())
  reviewId  String
  topic     ManagementReviewTopic
  content   String
  createdAt DateTime              @default(now())

  review ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("management_review_inputs")
}

model ManagementReviewDecision {
  id        String    @id @default(cuid())
  reviewId  String
  topic     String
  decision  String
  ownerId   String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  review ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("management_review_decisions")
}

