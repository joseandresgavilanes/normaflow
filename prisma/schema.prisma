  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  documentId            String?
  createdById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      ITService                   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  olas         OperationalLevelAgreement[]
  requests     ServiceRequest[]
  incidents    ITSMIncident[]

  @@unique([organizationId, code])
  @@index([organizationId, serviceId])
  @@index([organizationId, status])
  @@map("itsm_service_level_agreements")
}

model OperationalLevelAgreement {
  id                    String              @id @default(cuid())
  organizationId        String
  code                  String
  serviceId             String
  slaId                 String?
  name                  String
  supportingTeam        String?
  responseTimeMinutes   Int?
  resolutionTimeMinutes Int?
  description           String?
  status                ItsmAgreementStatus @default(DRAFT)
  documentId            String?
  createdById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      ITService              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sla          ServiceLevelAgreement? @relation(fields: [slaId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, serviceId])
  @@index([organizationId, slaId])
  @@map("itsm_operational_level_agreements")
}

model ServiceRequest {
  id             String            @id @default(cuid())
  organizationId String
  code           String
  title          String
  description    String?
  serviceId      String?
  catalogEntryId String?
  slaId          String?
  requesterId    String?
  assigneeId     String?
  priority       ItsmPriority      @default(MEDIUM)
  status         ItsmRequestStatus @default(NEW)
  dueAt          DateTime?
  fulfilledAt    DateTime?
  closedAt       DateTime?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      ITService?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  catalogEntry ServiceCatalogEntry?   @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)
  sla          ServiceLevelAgreement? @relation(fields: [slaId], references: [id], onDelete: SetNull)
  incidents    ITSMIncident[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, serviceId])
  @@index([organizationId, priority])
  @@map("itsm_service_requests")
}

/// Incidente de servicio TI (ITSM). Distinto de SecurityIncident (ISO 27001).
model ITSMIncident {
  id                  String             @id @default(cuid())
  organizationId      String
  code                String
  title               String
  description         String?
  serviceId           String?
  slaId               String?
  requestId           String?
  problemId           String?
  configurationItemId String?
  reporterId          String?
  assigneeId          String?
  priority            ItsmPriority       @default(MEDIUM)
  impact              ItsmImpact         @default(MEDIUM)
  urgency             ItsmUrgency        @default(MEDIUM)
  status              ITSMIncidentStatus @default(NEW)
  detectedAt          DateTime           @default(now())
  assignedAt          DateTime?
  resolvedAt          DateTime?
  confirmedAt         DateTime?
  confirmedById       String?
  closedAt            DateTime?
  resolutionNotes     String?
  capaId              String?
  documentId          String?
  evidenceId          String?
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service           ITService?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sla               ServiceLevelAgreement? @relation(fields: [slaId], references: [id], onDelete: SetNull)
  request           ServiceRequest?        @relation(fields: [requestId], references: [id], onDelete: SetNull)
  problem           Problem?               @relation(fields: [problemId], references: [id], onDelete: SetNull)
  configurationItem ConfigurationItem?     @relation(fields: [configurationItemId], references: [id], onDelete: SetNull)
  changes           ITSMChange[]
  articles          KnowledgeArticle[]
  crossLinks        IncidentCrossLink[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, serviceId])
  @@index([organizationId, priority])
  @@map("itsm_incidents")
}

/// Relaciona un ITSMIncident con un incidente de otro dominio (seguridad, IA,
/// laboral) sin fusionar sus workflows — cada uno conserva su propia máquina
/// de estados y tabla. targetId se valida en la capa de aplicación contra la
/// tabla del dominio correspondiente (no hay FK real cross-tabla).
enum IncidentLinkDomain {
  SECURITY
  AI
  OCCUPATIONAL
}

model IncidentCrossLink {
  id             String             @id @default(cuid())
  organizationId String
  itsmIncidentId String
  targetDomain   IncidentLinkDomain
  targetId       String
  relationType   String?
  notes          String?
  createdById    String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itsmIncident ITSMIncident @relation(fields: [itsmIncidentId], references: [id], onDelete: Cascade)

  @@unique([itsmIncidentId, targetDomain, targetId])
  @@index([organizationId, targetDomain, targetId])
  @@map("incident_cross_links")
}

model Problem {
  id             String            @id @default(cuid())
  organizationId String
  code           String
  title          String
  description    String?
  serviceId      String?
  status         ITSMProblemStatus @default(IDENTIFIED)
  rootCause      String?
  workaround     String?
  assigneeId     String?
  identifiedAt   DateTime          @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  capaId         String?
  documentId     String?
  evidenceId     String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      ITService?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  incidents    ITSMIncident[]
  knownErrors  KnownError[]
  changes      ITSMChange[]
  articles     KnowledgeArticle[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, serviceId])
  @@map("itsm_problems")
}

model KnownError {
  id                  String               @id @default(cuid())
