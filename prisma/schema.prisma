// NormaFlow Database Schema
// Proveedor: Supabase Postgres
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ORGANIZATIONS & USERS ───────────────────────────

model Organization {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  industry              String?
  country               String           @default("ES")
  size                  String?
  logoUrl               String?
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  website               String?
  address               String?
  plan                  Plan             @default(STARTER)
  trialEndsAt           DateTime?
  onboardingStatus      OnboardingStatus @default(COMPLETED)
  onboardingStep        Int              @default(1)
  onboardingGoal        OnboardingGoal?
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  activationAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  storageBytes          Int              @default(0)

  memberships                   Membership[]
  standards                     OrganizationStandard[]
  assessments                   Assessment[]
  documents                     Document[]
  processes                     Process[]
  risks                         Risk[]
  audits                        Audit[]
  nonconformities               Nonconformity[]
  actions                       Action[]
  capas                         CAPA[]
  capaEvidences                 CAPAEvidence[]
  auditParticipants             AuditParticipant[]
  managementReviewParticipants  ManagementReviewParticipant[]
  indicators                    Indicator[]
  evidenceFiles                 EvidenceFile[]
  notifications                 Notification[]
  notificationDeliveryJobs      NotificationDeliveryJob[]
  notificationPreferences       NotificationPreference[]
  subscription                  Subscription?
  billingInvoices               BillingInvoice[]
  reportExports                 ReportExport[]
  auditLogs                     AuditLog[]
  onboardingMetricEvents        OnboardingMetricEvent[]
  evidenceDocumentLinks         EvidenceDocumentLink[]
  evidenceRiskLinks             EvidenceRiskLink[]
  evidenceAuditLinks            EvidenceAuditLink[]
  evidenceFindingLinks          EvidenceFindingLink[]
  evidenceNonconformityLinks    EvidenceNonconformityLink[]
  evidenceIndicatorLinks        EvidenceIndicatorLink[]
  evidenceManagementReviewLinks EvidenceManagementReviewLink[]
  organizationControls          OrganizationControl[]
  controlEvidences              ControlEvidence[]
  controlReviews                ControlReview[]
  riskControlLinks              RiskControlLink[]
  statementsOfApplicability     StatementOfApplicability[]
  soaControlEntries             SoAControlEntry[]
  riskMethodologies             RiskAssessmentMethodology[]
  riskTreatmentPlans            RiskTreatmentPlan[]
  riskTreatmentItems            RiskTreatmentItem[]
  riskTreatmentControls         RiskTreatmentControl[]
  residualRiskAssessments       ResidualRiskAssessment[]
  riskAcceptances               RiskAcceptance[]
  informationAssets             InformationAsset[]
  assetClassifications          AssetClassification[]
  assetDependencies             AssetDependency[]
  assetRisks                    AssetRisk[]
  assetControls                 AssetControl[]
  securityIncidents             SecurityIncident[]
  securityIncidentAssets        SecurityIncidentAsset[]
  securityIncidentEvidences     SecurityIncidentEvidence[]
  vulnerabilities               Vulnerability[]
  vulnerabilityAssets           VulnerabilityAsset[]
  remediations                  Remediation[]
  verifications                 Verification[]
  businessContinuityPlans       BusinessContinuityPlan[]
  bcpProcesses                  BCPProcess[]
  disasterRecoveryPlans         DisasterRecoveryPlan[]
  continuityScenarios           ContinuityScenario[]
  continuityTests               ContinuityTest[]
  continuityTestResults         TestResult[]
  improvementActions            ImprovementAction[]
  supplierSecurityProfiles      SupplierSecurityProfile[]

  // ISOTech manual alignment
  groups              Group[]
  positions           Position[]
  personnel           Personnel[]
  locations           Location[]
  retentionTimes      RetentionTime[]
  dispositions        Disposition[]
  archiveMethods      ArchiveMethod[]
  recordTypes         RecordType[]
  records             Record[]
  catalogItems        OrganizationCatalogItem[]
  auditPrograms       AuditProgram[]
  managementReviews   ManagementReview[]
  opportunities       Opportunity[]
  trainingCourses     TrainingCourse[]
  trainingAssignments TrainingAssignment[]
  changeRequests      ChangeRequest[]
  suppliers           Supplier[]
  integrations        Integration[]
  memberInvites       MemberInvite[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  authUserId   String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                   Membership[]
  notifications                 Notification[]
  notificationDeliveryJobs      NotificationDeliveryJob[]
  notificationPreferences       NotificationPreference[]
  auditLogs                     AuditLog[]
  onboardingMetricEvents        OnboardingMetricEvent[]
  sentInvites                   MemberInvite[]                @relation("InvitedBy")
  ownedDocuments                Document[]                    @relation("DocumentOwner")
  reportExports                 ReportExport[]                @relation("ReportGeneratedBy")
  uploadedEvidenceFiles         EvidenceFile[]                @relation("EvidenceUploadedBy")
  responsibleEvidenceFiles      EvidenceFile[]                @relation("EvidenceResponsible")
  reviewedEvidenceFiles         EvidenceFile[]                @relation("EvidenceReviewedBy")
  ownedOpportunities            Opportunity[]                 @relation("OpportunityOwner")
  reviewedOpportunities         Opportunity[]                 @relation("OpportunityReviewer")
  reviewedRecords               Record[]                      @relation("RecordReviewer")
  responsibleRecordEntries      RecordEntry[]                 @relation("RecordEntryResponsible")
  enteredRecordEntries          RecordEntry[]                 @relation("RecordEntryEnteredBy")
  capaOwners                    CAPA[]                        @relation("CAPAOwner")
  capaRequesters                CAPA[]                        @relation("CAPARequester")
  capaRootCauseApprovals        CAPA[]                        @relation("CAPARootCauseApprovedBy")
  capaVerifiers                 CAPA[]                        @relation("CAPAVerifier")
  capaClosers                   CAPA[]                        @relation("CAPACloser")
  uploadedCAPAEvidence          CAPAEvidence[]                @relation("CAPAEvidenceUploadedBy")
  capaComments                  CAPAComment[]                 @relation("CAPACommentAuthor")
  responsibleAuditPrograms      AuditProgram[]                @relation("AuditProgramResponsible")
  auditParticipants             AuditParticipant[]
  managementReviewParticipants  ManagementReviewParticipant[]
  closedAudits                  Audit[]                       @relation("AuditClosedBy")
  responsibleSecurityControls   OrganizationControl[]         @relation("SecurityControlResponsible")
  controlEvidenceValidators     ControlEvidence[]             @relation("ControlEvidenceValidator")
  controlReviewers              ControlReview[]               @relation("ControlReviewer")
  ownedSoAs                     StatementOfApplicability[]    @relation("SoAOwner")
  approvedSoAs                  StatementOfApplicability[]    @relation("SoAApprover")
  responsibleSoAEntries         SoAControlEntry[]             @relation("SoAEntryResponsible")
  ownedRiskMethodologies        RiskAssessmentMethodology[]   @relation("RiskMethodologyOwner")
  approvedRiskMethodologies     RiskAssessmentMethodology[]   @relation("RiskMethodologyApprover")
  ownedRiskPlans                RiskTreatmentPlan[]           @relation("RiskPlanOwner")
  approvedRiskPlans             RiskTreatmentPlan[]           @relation("RiskPlanApprover")
  ownedRiskItems                RiskTreatmentItem[]           @relation("RiskItemOwner")
  residualRiskAssessments       ResidualRiskAssessment[]      @relation("ResidualRiskAssessor")
  riskAcceptances               RiskAcceptance[]              @relation("RiskAcceptedBy")
  ownedAssets                   InformationAsset[]            @relation("AssetOwner")
  custodiedAssets               InformationAsset[]            @relation("AssetCustodian")
  reportedIncidents             SecurityIncident[]            @relation("IncidentReporter")
  responsibleIncidents          SecurityIncident[]            @relation("IncidentResponsible")
  responsibleVulnerabilities    Vulnerability[]               @relation("VulnerabilityResponsible")
  responsibleRemediations       Remediation[]                 @relation("RemediationResponsible")
  performedVerifications        Verification[]                @relation("VerificationBy")
  ownedBcps                     BusinessContinuityPlan[]      @relation("BcpOwner")
  ownedDrps                     DisasterRecoveryPlan[]        @relation("DrpOwner")
  responsibleContinuityTests    ContinuityTest[]              @relation("ContinuityTestResponsible")
  continuityTestResults         TestResult[]                  @relation("TestResultBy")
  responsibleImprovementActions ImprovementAction[]           @relation("ImprovementActionResponsible")

  @@map("users")
}

model Membership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           Role      @default(CONTRIBUTOR)
  active         Boolean   @default(true)
  deactivatedAt  DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model MemberInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(CONTRIBUTOR)
  token          String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("member_invites")
}

// ─── STANDARDS & CLAUSES ─────────────────────────────

model Standard {
  id          String  @id @default(cuid())
  code        String  @unique // ISO_9001, ISO_27001
  name        String
  version     String
  description String?
  isActive    Boolean @default(true)

  clauses                Clause[]
  assessments            Assessment[]
  orgStandards           OrganizationStandard[]
  controlCatalogVersions ControlCatalogVersion[]

  @@map("standards")
}

model Clause {
  id          String  @id @default(cuid())
  standardId  String
  code        String // e.g. "4.1", "6.1.2"
  title       String
  description String?
  parentId    String?
  order       Int     @default(0)

  standard          Standard             @relation(fields: [standardId], references: [id])
  parent            Clause?              @relation("ClauseParent", fields: [parentId], references: [id])
  children          Clause[]             @relation("ClauseParent")
  assessmentAnswers AssessmentAnswer[]
  documents         Document[]
  evidenceFiles     EvidenceFile[]
  records           Record[]
  capas             CAPA[]
  audits            Audit[]
  checklistItems    AuditChecklistItem[]
  documentTemplates DocumentTemplate[]

  @@map("clauses")
}

model DocumentTemplate {
  id           String       @id @default(cuid())
  code         String       @unique
  standardCode String
  title        String
  description  String?
  documentType DocumentType @default(PROCEDURE)
  clauseId     String?
  content      String
  fieldSchema  Json?
  tags         String[]     @default([])
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  clause    Clause?    @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([standardCode, isActive])
  @@index([clauseId])
  @@map("document_templates")
}

model OrganizationStandard {
  id             String    @id @default(cuid())
  organizationId String
  standardId     String
  startedAt      DateTime  @default(now())
  targetDate     DateTime?
  score          Float?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard     @relation(fields: [standardId], references: [id])

  @@unique([organizationId, standardId])
  @@map("organization_standards")
}

// ─── ISO 27001:2022 ANNEX A CONTROL CATALOG ────────

model ControlCatalogVersion {
  id          String               @id @default(cuid())
  standardId  String
  version     String
  catalogDate DateTime
  status      ControlCatalogStatus @default(DRAFT)
  active      Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  standard Standard          @relation(fields: [standardId], references: [id], onDelete: Restrict)
  controls SecurityControl[]

  @@unique([standardId, version])
  @@index([standardId, active])
  @@map("control_catalog_versions")
}

model SecurityControl {
  id                  String                @id @default(cuid())
  catalogVersionId    String
  code                String
  domain              SecurityControlDomain
  title               String
  descriptionInternal String?
  objective           String?
  sortOrder           Int
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  catalogVersion     ControlCatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  organizationStates OrganizationControl[]
  soaEntries         SoAControlEntry[]

  @@unique([catalogVersionId, code])
  @@index([domain, active])
  @@map("security_controls")
}

model OrganizationControl {
  id                  String                    @id @default(cuid())
  organizationId      String
  controlId           String
  applicability       ControlApplicability      @default(UNDER_REVIEW)
  status              OrganizationControlStatus @default(NOT_ASSESSED)
  responsibleId       String?
  reviewDate          DateTime?
  nextReviewDate      DateTime?
  implementationLevel Int                       @default(0)
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control        SecurityControl        @relation(fields: [controlId], references: [id], onDelete: Cascade)
  responsible    User?                  @relation("SecurityControlResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  evidence       ControlEvidence[]
  reviews        ControlReview[]
  riskLinks      RiskControlLink[]
  treatmentLinks RiskTreatmentControl[]
  assetLinks     AssetControl[]

  @@unique([organizationId, controlId])
  @@index([organizationId, status])
  @@index([organizationId, applicability])
  @@index([organizationId, nextReviewDate])
  @@map("organization_controls")
}

model ControlEvidence {
  id                    String                @id @default(cuid())
  organizationId        String
  organizationControlId String
  evidenceId            String
  period                String
  status                ControlEvidenceStatus @default(PENDING_VALIDATION)
  validatorId           String?
  validatedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  evidence            EvidenceFile        @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  validator           User?               @relation("ControlEvidenceValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  @@unique([organizationControlId, evidenceId, period])
  @@index([organizationId, status])
  @@index([organizationId, evidenceId])
  @@map("control_evidences")
}

model ControlReview {
  id                    String               @id @default(cuid())
  organizationId        String
  organizationControlId String
  result                ControlReviewResult
  effectiveness         ControlEffectiveness
  comments              String?
  reviewerId            String
  reviewedAt            DateTime             @default(now())
  createdAt             DateTime             @default(now())

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  reviewer            User                @relation("ControlReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([organizationId, organizationControlId, reviewedAt])
  @@map("control_reviews")
}

model RiskControlLink {
  id                    String   @id @default(cuid())
  organizationId        String
  riskId                String
  organizationControlId String
  purpose               String
  expectedEffectiveness String?
  observedEffectiveness String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk                Risk                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)

  @@unique([riskId, organizationControlId])
  @@index([organizationId, organizationControlId])
  @@map("risk_control_links")
}

// ─── GAP ASSESSMENT ──────────────────────────────────

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  standardId     String
  title          String
  type           AssessmentType   @default(INTERNAL)
  status         AssessmentStatus @default(IN_PROGRESS)
  globalScore    Float?
  assessorId     String?
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard           @relation(fields: [standardId], references: [id])
  answers      AssessmentAnswer[]

  @@map("assessments")
}

model AssessmentAnswer {
  id           String       @id @default(cuid())
  assessmentId String
  clauseId     String
  score        Int          @default(0) // 0-100
  status       ClauseStatus @default(NOT_EVALUATED)
  comment      String?
  evidence     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  clause     Clause     @relation(fields: [clauseId], references: [id])

  @@unique([assessmentId, clauseId])
  @@map("assessment_answers")
}

// ─── DOCUMENT CONTROL ────────────────────────────────

model Document {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  title          String
  type           DocumentType
  status         DocumentStatus @default(DRAFT)
  clauseId       String?
  processId      String?
  standardCode   String?
  currentVersion String         @default("1.0")
  ownerId        String?
  reviewDate     DateTime?
  tags           String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // ISOTech manual § 12
  isExternal               Boolean  @default(false)
  externalLink             String?
  custodianId              String?
  responsibleElaborationId String?
  responsibleApprovalId    String?
  locationId               String?
  physicalLocation         String?
  distributionList         String[] @default([])
  observations             String?
  content                  String?
  templateId               String?

  // Reemplazo / supersede: el documento obsoleto (01) apunta a su reemplazo (02).
  supersededById String? @unique

  organization                 Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supersededBy                 Document?                @relation("DocumentSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes                   Document?                @relation("DocumentSupersede")
  clause                       Clause?                  @relation(fields: [clauseId], references: [id])
  process                      Process?                 @relation(fields: [processId], references: [id], onDelete: SetNull)
  location                     Location?                @relation(fields: [locationId], references: [id])
  owner                        User?                    @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  responsibleElaboration       Personnel?               @relation("DocumentElaborationResponsible", fields: [responsibleElaborationId], references: [id], onDelete: SetNull)
  responsibleApproval          Personnel?               @relation("DocumentApprovalResponsible", fields: [responsibleApprovalId], references: [id], onDelete: SetNull)
  custodian                    Personnel?               @relation("DocumentCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  versions                     DocumentVersion[]
  approvals                    Approval[]
  trainingCourseLinks          TrainingCourseDocument[]
  triggeredTrainingAssignments TrainingAssignment[]     @relation("TrainingTriggerDocument")
  changeLinks                  ChangeDocument[]
  supplierLinks                SupplierDocument[]
  evidenceLinks                EvidenceDocumentLink[]
  template                     DocumentTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, standardCode])
  @@index([organizationId, clauseId])
  @@index([organizationId, processId])
  @@index([organizationId, ownerId])
  @@index([processId])
  @@index([ownerId])
  @@index([responsibleElaborationId])
  @@index([responsibleApprovalId])
  @@index([custodianId])
  @@index([templateId])
  @@map("documents")
}

model DocumentVersion {
  id                 String                @id @default(cuid())
  documentId         String
  version            String
  status             DocumentVersionStatus @default(DRAFT)
  reviewedFromStatus DocumentStatus?
  fileUrl            String?
  fileSize           Int?
  mimeType           String?
  changeLog          String?
  changeDescription  String?
  previousVersion    String?
  createdById        String?
  content            String?
  createdAt          DateTime              @default(now())

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@unique([documentId, version])
  @@map("document_versions")
}

model Approval {
  id         String         @id @default(cuid())
  documentId String
  versionId  String?
  approverId String
  status     ApprovalStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

// ─── PROCESSES ───────────────────────────────────────

model Process {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  type           String? // core, support, strategic
  description    String?
  ownerId        String?
  inputs         String[] @default([])
  outputs        String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents           Document[]
  risks               Risk[]
  indicators          Indicator[]
  trainingAssignments TrainingAssignment[]
  changeLinks         ChangeProcess[]
  records             Record[]
  groupLinks          GroupProcess[]
  evidenceFiles       EvidenceFile[]
  capas               CAPA[]
  audits              Audit[]
  informationAssets   InformationAsset[]
  bcpLinks            BCPProcess[]

  @@map("processes")
}

// ─── RISK MANAGEMENT ─────────────────────────────────

model Risk {
  id             String        @id @default(cuid())
  organizationId String
  processId      String?
  title          String
  description    String?
  category       String
  probability    Int // 1-5
  impact         Int // 1-5
  score          Int // probability * impact
  status         RiskStatus    @default(IDENTIFIED)
  treatment      RiskTreatment @default(MITIGATE)
  ownerId        String?
  dueDate        DateTime?
  residualScore  Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process                Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  controls               Control[]
  actions                Action[]
  changeLinks            ChangeRisk[]
  supplierLinks          SupplierRisk[]
  evidenceLinks          EvidenceRiskLink[]
  managementReviewInputs ManagementReviewInput[]
  securityControlLinks   RiskControlLink[]
  treatmentItems         RiskTreatmentItem[]     @relation("RiskTreatmentItemRisk")
  assetRisks             AssetRisk[]

  @@index([processId])
  @@map("risks")
}

model Control {
  id          String        @id @default(cuid())
  riskId      String
  title       String
  description String?
  type        ControlType   @default(PREVENTIVE)
  status      ControlStatus @default(PLANNED)
  ownerId     String?
  createdAt   DateTime      @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@map("controls")
}

// ─── AUDITS ──────────────────────────────────────────

model Audit {
  id               String      @id @default(cuid())
  organizationId   String
  programId        String?
  processId        String?
  title            String
  type             AuditType   @default(INTERNAL)
  standardCode     String?
  status           AuditStatus @default(PLANNED)
  auditorId        String?
  auditorExternal  String?
  plannedDate      DateTime?
  scheduledDate    DateTime?
  startDate        DateTime?
  endDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  scope            String?
  objectives       String?
  criteria         String?
  reportUrl        String?
  reportSummary    String?
  reportConclusion String?
  reportIssuedAt   DateTime?
  closedById       String?
  progress         Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program                AuditProgram?           @relation(fields: [programId], references: [id])
  process                Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  closedBy               User?                   @relation("AuditClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  findings               AuditFinding[]
  nonconformities        Nonconformity[]
  checklistItems         AuditChecklistItem[]
  evidenceLinks          EvidenceAuditLink[]
  participants           AuditParticipant[]
  managementReviewInputs ManagementReviewInput[]
  clause                 Clause?                 @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  clauseId               String?

  @@index([organizationId, plannedDate])
  @@index([organizationId, processId])
  @@index([organizationId, status])
  @@index([organizationId, clauseId])
  @@map("audits")
}

model AuditFinding {
  id          String          @id @default(cuid())
  auditId     String
  title       String
  description String?
  type        FindingType     @default(OBSERVATION)
  severity    FindingSeverity @default(MINOR)
  clauseCode  String?
  status      FindingStatus   @default(OPEN)
  evidenceUrl String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  audit         Audit                 @relation(fields: [auditId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity?
  evidenceLinks EvidenceFindingLink[]
  capa          CAPA?

  @@map("audit_findings")
}

// ─── NONCONFORMITIES / CAPA ──────────────────────────

model Nonconformity {
  id                     String     @id @default(cuid())
  organizationId         String
  auditId                String?
  findingId              String?    @unique
  title                  String
  description            String?
  source                 NCSource   @default(INTERNAL_AUDIT)
  severity               NCSeverity @default(MINOR)
  status                 NCStatus   @default(OPEN)
  ownerId                String?
  rootCause              String?
  dueDate                DateTime?
  closedAt               DateTime?
  effectivenessValidated Boolean    @default(false)
  archiveReason          String?
  archivedAt             DateTime?
  archivedById           String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit                  Audit?                      @relation(fields: [auditId], references: [id])
  finding                AuditFinding?               @relation(fields: [findingId], references: [id])
  actions                Action[]
  changeRequests         ChangeRequest[]
  supplierLinks          SupplierNonconformity[]
  comments               NonconformityComment[]
  evidenceLinks          EvidenceNonconformityLink[]
  capa                   CAPA?
  managementReviewInputs ManagementReviewInput[]

  @@map("nonconformities")
}

model NonconformityComment {
  id              String   @id @default(cuid())
  nonconformityId String
  authorId        String
  content         String
  createdAt       DateTime @default(now())

  nonconformity Nonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)

  @@index([nonconformityId, createdAt])
  @@map("nonconformity_comments")
}

// ─── OPPORTUNITIES ──────────────────────────────────

model Opportunity {
  id                      String            @id @default(cuid())
  organizationId          String
  title                   String
  description             String?
  standardCode            String?
  source                  String?
  category                String
  status                  OpportunityStatus @default(IDENTIFIED)
  ownerId                 String?
  reviewerId              String?
