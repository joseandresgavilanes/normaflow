  title                 String
  controlDescription    String?
  /// Reutiliza controles existentes (no se duplican).
  complianceControlId   String?
  organizationControlId String?
  obligationId          String?
  period                String
  testedAt              DateTime          @default(now())
  testedById            String?
  designAdequate        Boolean?
  operatingEffective    Boolean?
  sampleSize            Int?
  exceptionsFound       Int               @default(0)
  findings              String?
  effectiveness         Int?
  status                ControlTestStatus @default(PLANNED)
  nextTestDate          DateTime?
  evidenceId            String?
  capaId                String?
  createdById           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, period])
  @@map("financial_control_tests")
}

model NonFinancialControlTest {
  id                    String                  @id @default(cuid())
  organizationId        String
  code                  String
  title                 String
  controlDescription    String?
  controlArea           NonFinancialControlArea @default(OTHER)
  complianceControlId   String?
  organizationControlId String?
  obligationId          String?
  period                String
  testedAt              DateTime                @default(now())
  testedById            String?
  designAdequate        Boolean?
  operatingEffective    Boolean?
  sampleSize            Int?
  exceptionsFound       Int                     @default(0)
  findings              String?
  effectiveness         Int?
  status                ControlTestStatus       @default(PLANNED)
  nextTestDate          DateTime?
  evidenceId            String?
  capaId                String?
  createdById           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, controlArea])
  @@map("non_financial_control_tests")
}

model HighRiskTransactionApproval {
  id                     String                  @id @default(cuid())
  organizationId         String
  code                   String
  title                  String
  transactionType        HighRiskTransactionType @default(OTHER)
  description            String?
  amount                 Float?
  currency               String?
  associateId            String?
  counterpartyName       String?
  country                String?
  involvesPublicOfficial Boolean                 @default(false)
  riskRationale          String?
  status                 HighRiskApprovalStatus  @default(REQUESTED)
  requestedById          String?
  requestedAt            DateTime                @default(now())
  approvedById           String?
  approvedAt             DateTime?
  rejectionReason        String?
  conditions             String?
  obligationId           String?
  complianceRiskId       String?
  dueDiligenceCaseId     String?
  documentId             String?
  evidenceId             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  associate    BusinessAssociate? @relation(fields: [associateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, transactionType])
  @@map("high_risk_transaction_approvals")
}

model AntiBriberyCommitment {
  id             String                    @id @default(cuid())
  organizationId String
  code           String
  commitmentType AntiBriberyCommitmentType @default(EMPLOYEE)
  subjectUserId  String?
  associateId    String?
  subjectName    String?
  committedAt    DateTime                  @default(now())
  version        String                    @default("1")
  acknowledged   Boolean                   @default(true)
  expiresAt      DateTime?
  documentId     String?
  evidenceId     String?
  notes          String?
  createdById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  associate    BusinessAssociate? @relation(fields: [associateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, commitmentType])
  @@index([organizationId, associateId])
  @@map("anti_bribery_commitments")
