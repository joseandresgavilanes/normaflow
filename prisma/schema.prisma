model AntiBriberyInvestigation {
  id                     String                    @id @default(cuid())
  organizationId         String
  code                   String
  /// Investigación reutilizada — no se duplica el flujo ni la evidencia.
  investigationId        String
  speakUpReportId        String?
  breachId               String?
  allegationType         BriberyAllegationType     @default(OTHER)
  involvesPublicOfficial Boolean                   @default(false)
  estimatedValue         Float?
  currency               String?
  jurisdictionId         String?
  associateId            String?
  status                 AbmsInvestigationStatus   @default(OPEN)
  outcome                AbmsInvestigationOutcome?
