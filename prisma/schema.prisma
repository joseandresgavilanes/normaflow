  impact            ItsmImpact       @default(MEDIUM)
  requestedById     String?
  assessedById      String?
  approvedById      String?
  implementedById   String?
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  implementedAt     DateTime?
  reviewedAt        DateTime?
  closedAt          DateTime?
  relatedIncidentId String?
  relatedProblemId  String?
  capaId            String?
  documentId        String?
  evidenceId        String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service         ITService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  relatedIncident ITSMIncident? @relation(fields: [relatedIncidentId], references: [id], onDelete: SetNull)
  relatedProblem  Problem?      @relation(fields: [relatedProblemId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, changeType])
  @@index([organizationId, serviceId])
  @@map("itsm_changes")
}

