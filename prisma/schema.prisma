// NormaFlow Database Schema
// Proveedor: Supabase Postgres
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ORGANIZATIONS & USERS ───────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  industry     String?
  country      String   @default("ES")
  logoUrl      String?
  plan         Plan     @default(STARTER)
  trialEndsAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  standards         OrganizationStandard[]
  assessments       Assessment[]
  documents         Document[]
  processes         Process[]
  risks             Risk[]
  audits            Audit[]
  nonconformities   Nonconformity[]
  actions           Action[]
  indicators        Indicator[]
  evidenceFiles     EvidenceFile[]
  notifications     Notification[]
  subscription      Subscription?
  auditLogs         AuditLog[]

  // ISOTech manual alignment
  groups            Group[]
  positions         Position[]
  personnel         Personnel[]
  locations         Location[]
  retentionTimes    RetentionTime[]
  dispositions      Disposition[]
  archiveMethods    ArchiveMethod[]
  recordTypes       RecordType[]
  records           Record[]
  auditPrograms     AuditProgram[]
  managementReviews ManagementReview[]

  @@map("organizations")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  avatarUrl   String?
  authUserId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(CONTRIBUTOR)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// ─── STANDARDS & CLAUSES ─────────────────────────────

model Standard {
  id          String   @id @default(cuid())
  code        String   @unique  // ISO_9001, ISO_27001
  name        String
  version     String
  description String?
  isActive    Boolean  @default(true)

  clauses     Clause[]
  assessments Assessment[]
  orgStandards OrganizationStandard[]

  @@map("standards")
}

model Clause {
  id          String  @id @default(cuid())
  standardId  String
  code        String  // e.g. "4.1", "6.1.2"
  title       String
  description String?
  parentId    String?
  order       Int     @default(0)

  standard          Standard           @relation(fields: [standardId], references: [id])
  parent            Clause?            @relation("ClauseParent", fields: [parentId], references: [id])
  children          Clause[]           @relation("ClauseParent")
  assessmentAnswers AssessmentAnswer[]
  documents         Document[]

  @@map("clauses")
}

model OrganizationStandard {
  id             String   @id @default(cuid())
  organizationId String
  standardId     String
  startedAt      DateTime @default(now())
  targetDate     DateTime?
  score          Float?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard     @relation(fields: [standardId], references: [id])

  @@unique([organizationId, standardId])
  @@map("organization_standards")
}

// ─── GAP ASSESSMENT ──────────────────────────────────

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  standardId     String
  title          String
  type           AssessmentType   @default(INTERNAL)
  status         AssessmentStatus @default(IN_PROGRESS)
  globalScore    Float?
  assessorId     String?
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard           @relation(fields: [standardId], references: [id])
  answers      AssessmentAnswer[]

  @@map("assessments")
}

model AssessmentAnswer {
  id           String         @id @default(cuid())
  assessmentId String
  clauseId     String
  score        Int            @default(0)  // 0-100
  status       ClauseStatus   @default(NOT_EVALUATED)
  comment      String?
  evidence     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  clause     Clause     @relation(fields: [clauseId], references: [id])

  @@unique([assessmentId, clauseId])
  @@map("assessment_answers")
}

// ─── DOCUMENT CONTROL ────────────────────────────────

model Document {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  title          String
  type           DocumentType
  status         DocumentStatus @default(DRAFT)
  clauseId       String?
  processId      String?
  standardCode   String?
  currentVersion String         @default("1.0")
  ownerId        String?
  reviewDate     DateTime?
  tags           String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // ISOTech manual § 12
  isExternal                Boolean  @default(false)
  externalLink              String?
  custodianId               String?
  responsibleElaborationId  String?
  responsibleApprovalId     String?
  locationId                String?
  physicalLocation          String?
  distributionList          String[]
  observations              String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clause       Clause?           @relation(fields: [clauseId], references: [id])
  location     Location?         @relation(fields: [locationId], references: [id])
  versions     DocumentVersion[]
  approvals    Approval[]

  @@unique([organizationId, code])
  @@map("documents")
}

model DocumentVersion {
  id                String   @id @default(cuid())
  documentId        String
  version           String
  fileUrl           String?
  fileSize          Int?
  mimeType          String?
  changeLog         String?
  changeDescription String?
  previousVersion   String?
  createdById       String?
  createdAt         DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

model Approval {
  id         String         @id @default(cuid())
  documentId String
  approverId String
  status     ApprovalStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

// ─── PROCESSES ───────────────────────────────────────

model Process {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  type           String?  // core, support, strategic
  description    String?
  ownerId        String?
  inputs         String[]
  outputs        String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks        Risk[]

  @@map("processes")
}

// ─── RISK MANAGEMENT ─────────────────────────────────

model Risk {
  id              String          @id @default(cuid())
  organizationId  String
  processId       String?
  title           String
  description     String?
  category        String
  probability     Int             // 1-5
  impact          Int             // 1-5
  score           Int             // probability * impact
  status          RiskStatus      @default(IDENTIFIED)
  treatment       RiskTreatment   @default(MITIGATE)
  ownerId         String?
  dueDate         DateTime?
  residualScore   Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id])
  controls     Control[]
  actions      Action[]

  @@map("risks")
}

model Control {
  id          String        @id @default(cuid())
  riskId      String
  title       String
  description String?
  type        ControlType   @default(PREVENTIVE)
  status      ControlStatus @default(PLANNED)
  ownerId     String?
  createdAt   DateTime      @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@map("controls")
}

// ─── AUDITS ──────────────────────────────────────────

model Audit {
  id             String      @id @default(cuid())
  organizationId String
  programId      String?
  title          String
  type           AuditType   @default(INTERNAL)
  standardCode   String?
  status         AuditStatus @default(PLANNED)
  auditorId      String?
  auditorExternal String?
  scheduledDate  DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  scope          String?
  objectives     String?
  criteria       String?
  reportUrl      String?
  progress       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program         AuditProgram?     @relation(fields: [programId], references: [id])
  findings        AuditFinding[]
  nonconformities Nonconformity[]
  checklistItems  AuditChecklistItem[]

  @@map("audits")
}

model AuditFinding {
  id          String          @id @default(cuid())
  auditId     String
  title       String
  description String?
  type        FindingType     @default(OBSERVATION)
  severity    FindingSeverity @default(MINOR)
  clauseCode  String?
  status      FindingStatus   @default(OPEN)
  evidenceUrl String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  audit         Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity?

  @@map("audit_findings")
}

// ─── NONCONFORMITIES / CAPA ──────────────────────────

model Nonconformity {
  id             String               @id @default(cuid())
  organizationId String
  auditId        String?
  findingId      String?              @unique
  title          String
  description    String?
  source         NCSource             @default(INTERNAL_AUDIT)
  severity       NCSeverity           @default(MINOR)
  status         NCStatus             @default(OPEN)
  ownerId        String?
  rootCause      String?
  dueDate        DateTime?
  closedAt       DateTime?
  effectivenessValidated Boolean      @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit?        @relation(fields: [auditId], references: [id])
  finding      AuditFinding? @relation(fields: [findingId], references: [id])
  actions      Action[]

  @@map("nonconformities")
}

// ─── ACTIONS ─────────────────────────────────────────

model Action {
  id               String        @id @default(cuid())
  organizationId   String
  title            String
  description      String?
  type             ActionType    @default(CORRECTIVE)
  priority         Priority      @default(MEDIUM)
  status           ActionStatus  @default(PENDING)
  stage            ACPMStage     @default(REQUEST)
  source           String?
  rootCause        String?
  proposedSolution String?
  effectivenessCheck String?
  effectivenessAt  DateTime?
  ownerId          String?
  requestedById    String?
  requestApproverId String?
  solutionApproverId String?
  dueDate          DateTime?
  completedAt      DateTime?
  progress         Int           @default(0)
  riskId           String?
  nonconformityId  String?
  managementReviewId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk            Risk?            @relation(fields: [riskId], references: [id])
  nonconformity   Nonconformity?   @relation(fields: [nonconformityId], references: [id])
  managementReview ManagementReview? @relation(fields: [managementReviewId], references: [id])
  comments        ActionComment[]

  @@map("actions")
}

model ActionComment {
  id        String   @id @default(cuid())
  actionId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_comments")
}

// ─── INDICATORS ──────────────────────────────────────

model Indicator {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?
  unit           String
  target         Float
  frequency      String          @default("monthly")
  ownerId        String?
  status         IndicatorStatus @default(ON_TRACK)
  clauseCode     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       IndicatorValue[]

  @@map("indicators")
}

model IndicatorValue {
  id          String   @id @default(cuid())
  indicatorId String
  value       Float
  period      String   // "2025-06"
  note        String?
  createdAt   DateTime @default(now())

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@map("indicator_values")
}

// ─── EVIDENCE ────────────────────────────────────────

model EvidenceFile {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  module         String?  // risk, audit, document, nc
  moduleId       String?
  uploadedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("evidence_files")
}

// ─── NOTIFICATIONS ───────────────────────────────────

model Notification {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  type           NotificationType   @default(INFO)
  read           Boolean            @default(false)
  link           String?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── BILLING ─────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── AUDIT LOGS ──────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  module         String
  recordId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── ISOTECH MANUAL ALIGNMENT ───────────────────────
// Models that extend the SaaS to cover the ISOTech functional reference.
// All entities are tenant-scoped via organizationId.

// § 10.2 Grupos / § 10.3 Permiso a Grupo / § 10.4 Usuarios de Grupo
model Group {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMembership[]
  permissions  GroupPermission[]

  @@unique([organizationId, name])
  @@map("groups")
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_memberships")
}

model GroupPermission {
  id         String @id @default(cuid())
  groupId    String
  permission String // e.g. "documents:create", "records:*"

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, permission])
  @@map("group_permissions")
}

// § 11.1 Cargo
model Position {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnel    Personnel[]

  @@unique([organizationId, name])
  @@map("positions")
}

// § 11.3 Datos Personal
model Personnel {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  identification String?
  positionId     String?
  active         Boolean  @default(true)
  hiredAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position     Position?    @relation(fields: [positionId], references: [id])

  @@map("personnel")
}

// § 12.1.1 Lugar
model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([organizationId, name])
  @@map("locations")
}

// § 13.1.1 Tiempo de Retención
model RetentionTime {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  months         Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("retention_times")
}

// § 13.1.2 Disposición
model Disposition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("dispositions")
}

// § 13.1.3 Método de Archivo
model ArchiveMethod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("archive_methods")
}

// § 13.1.4 Tipo de Registro
model RecordType {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // FISICO, ELECTRONICO, FISICO_Y_ELECTRONICO, ...
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("record_types")
}

// § 13.2 Control de Registros
model Record {
  id                String   @id @default(cuid())
  organizationId    String
  code              String
  name              String
  processId         String?
  recordTypeId      String?
  retentionTimeId   String?
  dispositionId     String?
  archiveMethodId   String?
  custodianId       String?
  physicalLocation  String?
  digitalLocation   String?
  observations      String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordType    RecordType?    @relation(fields: [recordTypeId], references: [id])
  retentionTime RetentionTime? @relation(fields: [retentionTimeId], references: [id])
  disposition   Disposition?   @relation(fields: [dispositionId], references: [id])
  archiveMethod ArchiveMethod? @relation(fields: [archiveMethodId], references: [id])
  entries       RecordEntry[]

  @@unique([organizationId, code])
  @@map("records")
}

model RecordEntry {
  id          String   @id @default(cuid())
  recordId    String
  reference   String?  // e.g. registry number, batch
  description String?
  fileUrl     String?
  fileSize    Int?
  mimeType    String?
  enteredById String?
  enteredAt   DateTime @default(now())

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("record_entries")
}

// § 15 Programa de Auditoría (annual program grouping audits)
model AuditProgram {
  id             String   @id @default(cuid())
  organizationId String
  year           Int
  title          String
  objectives     String?
  scope          String?
  status         AuditProgramStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audits       Audit[]

  @@unique([organizationId, year, title])
  @@map("audit_programs")
}

model AuditChecklistItem {
  id          String   @id @default(cuid())
  auditId     String
  clauseCode  String?
  question    String
  expected    String?
  response    String?
  status      ChecklistItemStatus @default(PENDING)
  evidenceUrl String?
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("audit_checklist_items")
}

// § 16 Revisión por la Dirección
model ManagementReview {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  scheduledDate  DateTime?
  heldAt         DateTime?
  status         ManagementReviewStatus @default(PLANNED)
  chairId        String?
  attendees      String[] // free-text names or user IDs
  summary        String?
  reportUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inputs       ManagementReviewInput[]
  decisions    ManagementReviewDecision[]
  actions      Action[]

  @@map("management_reviews")
}

model ManagementReviewInput {
  id        String   @id @default(cuid())
  reviewId  String
  topic     ManagementReviewTopic
  content   String
  createdAt DateTime @default(now())

  review ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("management_review_inputs")
}

model ManagementReviewDecision {
  id          String   @id @default(cuid())
  reviewId    String
  topic       String
  decision    String
  ownerId     String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())

  review ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("management_review_decisions")
}

// ─── ENUMS ───────────────────────────────────────────

enum Plan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  COMPLIANCE_MANAGER
  AUDITOR
  CONTRIBUTOR
  VIEWER
}

enum AssessmentType {
  INTERNAL
  EXTERNAL
  PRE_CERTIFICATION
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ClauseStatus {
  NOT_EVALUATED
  COMPLIANT
  PARTIALLY_COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

enum DocumentType {
  MANUAL
  PROCEDURE
  POLICY
  INSTRUCTION
  FORM
  RECORD
  PLAN
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  OBSOLETE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiskStatus {
  IDENTIFIED
  UNDER_TREATMENT
  MONITORED
  MITIGATED
  ACCEPTED
  CLOSED
}

enum RiskTreatment {
  MITIGATE
  ACCEPT
  TRANSFER
  AVOID
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
}

enum ControlStatus {
  PLANNED
  IMPLEMENTED
  EFFECTIVE
  INEFFECTIVE
}

enum AuditType {
  INTERNAL
  EXTERNAL
  CERTIFICATION
  SURVEILLANCE
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingType {
  NONCONFORMITY
  OBSERVATION
  OPPORTUNITY
  STRENGTH
}

