  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  problem           Problem?           @relation(fields: [problemId], references: [id], onDelete: SetNull)
  configurationItem ConfigurationItem? @relation(fields: [configurationItemId], references: [id], onDelete: SetNull)
  articles          KnowledgeArticle[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, problemId])
  @@map("itsm_known_errors")
}

/// Cambio de servicio TI (ITSM). Distinto de ChangeRequest (ISO gestión del cambio).
model ITSMChange {
  id                String           @id @default(cuid())
  organizationId    String
  code              String
