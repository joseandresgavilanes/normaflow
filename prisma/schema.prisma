  email        String   @unique
  name         String
  avatarUrl    String?
  authUserId   String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                    Membership[]
  notifications                  Notification[]
  notificationDeliveryJobs       NotificationDeliveryJob[]
  notificationPreferences        NotificationPreference[]
  auditLogs                      AuditLog[]
  onboardingMetricEvents         OnboardingMetricEvent[]
  sentInvites                    MemberInvite[]                @relation("InvitedBy")
  ownedDocuments                 Document[]                    @relation("DocumentOwner")
  reportExports                  ReportExport[]                @relation("ReportGeneratedBy")
  uploadedEvidenceFiles          EvidenceFile[]                @relation("EvidenceUploadedBy")
  responsibleEvidenceFiles       EvidenceFile[]                @relation("EvidenceResponsible")
  reviewedEvidenceFiles          EvidenceFile[]                @relation("EvidenceReviewedBy")
  ownedOpportunities             Opportunity[]                 @relation("OpportunityOwner")
  reviewedOpportunities          Opportunity[]                 @relation("OpportunityReviewer")
  reviewedRecords                Record[]                      @relation("RecordReviewer")
  responsibleRecordEntries       RecordEntry[]                 @relation("RecordEntryResponsible")
  enteredRecordEntries           RecordEntry[]                 @relation("RecordEntryEnteredBy")
  capaOwners                     CAPA[]                        @relation("CAPAOwner")
  capaRequesters                 CAPA[]                        @relation("CAPARequester")
  capaRootCauseApprovals         CAPA[]                        @relation("CAPARootCauseApprovedBy")
  capaVerifiers                  CAPA[]                        @relation("CAPAVerifier")
  capaClosers                    CAPA[]                        @relation("CAPACloser")
  uploadedCAPAEvidence           CAPAEvidence[]                @relation("CAPAEvidenceUploadedBy")
  capaComments                   CAPAComment[]                 @relation("CAPACommentAuthor")
  responsibleAuditPrograms       AuditProgram[]                @relation("AuditProgramResponsible")
  auditParticipants              AuditParticipant[]
  managementReviewParticipants   ManagementReviewParticipant[]
  closedAudits                   Audit[]                       @relation("AuditClosedBy")
  responsibleSecurityControls    OrganizationControl[]         @relation("SecurityControlResponsible")
  controlEvidenceValidators      ControlEvidence[]             @relation("ControlEvidenceValidator")
  controlReviewers               ControlReview[]               @relation("ControlReviewer")
  ownedSoAs                      StatementOfApplicability[]    @relation("SoAOwner")
  approvedSoAs                   StatementOfApplicability[]    @relation("SoAApprover")
  responsibleSoAEntries          SoAControlEntry[]             @relation("SoAEntryResponsible")
  ownedRiskMethodologies         RiskAssessmentMethodology[]   @relation("RiskMethodologyOwner")
  approvedRiskMethodologies      RiskAssessmentMethodology[]   @relation("RiskMethodologyApprover")
  ownedRiskPlans                 RiskTreatmentPlan[]           @relation("RiskPlanOwner")
  approvedRiskPlans              RiskTreatmentPlan[]           @relation("RiskPlanApprover")
  ownedRiskItems                 RiskTreatmentItem[]           @relation("RiskItemOwner")
  residualRiskAssessments        ResidualRiskAssessment[]      @relation("ResidualRiskAssessor")
  riskAcceptances                RiskAcceptance[]              @relation("RiskAcceptedBy")
  ownedAssets                    InformationAsset[]            @relation("AssetOwner")
  custodiedAssets                InformationAsset[]            @relation("AssetCustodian")
  reportedIncidents              SecurityIncident[]            @relation("IncidentReporter")
  responsibleIncidents           SecurityIncident[]            @relation("IncidentResponsible")
  responsibleVulnerabilities     Vulnerability[]               @relation("VulnerabilityResponsible")
  responsibleRemediations        Remediation[]                 @relation("RemediationResponsible")
  performedVerifications         Verification[]                @relation("VerificationBy")
  ownedBcps                      BusinessContinuityPlan[]      @relation("BcpOwner")
  ownedDrps                      DisasterRecoveryPlan[]        @relation("DrpOwner")
  responsibleContinuityTests     ContinuityTest[]              @relation("ContinuityTestResponsible")
  continuityTestResults          TestResult[]                  @relation("TestResultBy")
  responsibleImprovementActions  ImprovementAction[]           @relation("ImprovementActionResponsible")
  responsibleOrgStandards        OrganizationStandard[]        @relation("OrgStandardResponsible")
  authoredRequirementCoverage    RequirementCoverage[]         @relation("RequirementCoverageAuthor")
  approvedIntegratedPolicies     IntegratedSystem[]            @relation("IntegratedPolicyApprover")
  approvedBcps                   BusinessContinuityPlan[]      @relation("BcpApprover")
  activatedBcps                  BusinessContinuityPlan[]      @relation("BcpActivator")
  approvedContinuityVersions     ContinuityPlanVersion[]       @relation("ContinuityVersionApprover")
  planActivations                PlanActivation[]              @relation("PlanActivatedBy")
  ownedBias                      BusinessImpactAnalysis[]      @relation("BiaOwner")
  approvedBias                   BusinessImpactAnalysis[]      @relation("BiaApprover")
  ownedCriticalActivities        CriticalActivity[]            @relation("CriticalActivityOwner")
  ownedContinuityStrategies      ContinuityStrategy[]          @relation("StrategyOwner")
  approvedContinuityStrategies   ContinuityStrategy[]          @relation("StrategyApprover")
  responsibleRecoveryProcedures  RecoveryProcedure[]           @relation("RecoveryProcedureResponsible")
  ledCrisisTeams                 CrisisTeam[]                  @relation("CrisisTeamLeader")
  deputyCrisisTeams              CrisisTeam[]                  @relation("CrisisTeamDeputy")
  crisisContacts                 CrisisContact[]               @relation("CrisisContactUser")
  responsibleIntegratedStandards IntegratedSystemStandard[]    @relation("IntegratedStandardResponsible")
  responsibleInterestedParties   InterestedParty[]             @relation("InterestedPartyResponsible")
  ownedIntegratedObjectives      IntegratedObjective[]         @relation("IntegratedObjectiveOwner")
  responsibleRequirements        RequirementAssignment[]       @relation("RequirementResponsible")
  grantedPackEntitlements        OrganizationPackEntitlement[] @relation("PackEntitlementGrantedBy")
  packReadinessAssessments       PackReadinessAssessment[]     @relation("PackReadinessActor")
  packLifecycleEvents            StandardPackLifecycleEvent[]  @relation("PackLifecycleActor")
  communicatedRecords            CommunicationRecord[]         @relation("CommunicationCommunicatedBy")

  @@map("users")
}

model Membership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           Role      @default(CONTRIBUTOR)
  active         Boolean   @default(true)
  deactivatedAt  DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model MemberInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(CONTRIBUTOR)
  token          String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("member_invites")
}

// ─── STANDARDS & CLAUSES ─────────────────────────────

// ─── STANDARD PACK ENGINE: CATALOG SPINE ─────────────
// StandardFamily (norm) → StandardEdition (year/version) → StandardRequirement (clause).
// Rename/refactor of the former `Standard`/`Clause` tables. FK scalar column names
// (`standardId`, `clauseId`) are intentionally retained on referencing models as
// compatibility aliases; the relations now point to the normalized models below.
// New cross-standard capability flows through RequirementCoverage / RequirementMapping.

model StandardFamily {
  id          String               @id @default(cuid())
  code        String               @unique // ISO_9001, ISO_27001, ISO_14001…
  name        String
  category    String? // Calidad, Seguridad de la información, Medio ambiente…
  description String?
  status      StandardFamilyStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  editions StandardEdition[]

  @@map("standard_families")
}

model StandardEdition {
  id             String                @id @default(cuid())
  familyId       String
  code           String // equals the family code (ISO_9001) — kept so every `.standard.code` reader stays valid
  editionCode    String                @default("") // "2015", "2022" — unique within a family
  name           String
  version        String // legacy edition label (kept for back-compat)
  year           Int?
  description    String?
  publishedAt    DateTime?
  withdrawnAt    DateTime?
  status         StandardEditionStatus @default(ACTIVE)
  catalogVersion String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  family                 StandardFamily          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  requirements           StandardRequirement[]
  assessments            Assessment[]
  orgStandards           OrganizationStandard[]
  controlCatalogVersions ControlCatalogVersion[]
  packLinks              StandardPackEdition[]
  standardTemplates      StandardTemplate[]

  @@unique([familyId, editionCode])
  @@index([familyId, status])
  @@index([code])
  @@map("standard_editions")
}

model StandardRequirement {
  id          String  @id @default(cuid())
  standardId  String // FK to StandardEdition.id — column name kept for back-compat
  code        String // e.g. "4.1", "6.1.2"
  title       String
  summary     String? // own summary — never protected full standard text
  description String?
  parentId    String?
  level       Int     @default(1)
  order       Int     @default(0)
  mandatory   Boolean @default(true)
  active      Boolean @default(true)

  standard          StandardEdition           @relation(fields: [standardId], references: [id])
  parent            StandardRequirement?      @relation("RequirementParent", fields: [parentId], references: [id])
  children          StandardRequirement[]     @relation("RequirementParent")
  assessmentAnswers AssessmentAnswer[]
  documents         Document[]
  evidenceFiles     EvidenceFile[]
  records           Record[]
  capas             CAPA[]
  audits            Audit[]
  checklistItems    AuditChecklistItem[]
  documentTemplates DocumentTemplate[]
  standardTemplates StandardTemplate[]
  evidenceRules     RequirementEvidenceRule[]
  gapQuestions      GapQuestionTemplate[]
  auditChecklist    AuditChecklistTemplate[]
  coverage          RequirementCoverage[]
  assignments       RequirementAssignment[]
  mappingsFrom      RequirementMapping[]      @relation("MappingSource")
  mappingsTo        RequirementMapping[]      @relation("MappingTarget")

  @@index([standardId, active])
  @@index([parentId])
  @@map("standard_requirements")
}

// ─── STANDARD PACK ENGINE: PACKS & CROSS-STANDARD FABRIC ──

model StandardPack {
  id              String                @id @default(cuid())
  code            String                @unique
  name            String
  version         String
  description     String?
  requiredModules String[]              @default([])
  featureFlags    Json?
  /// Ciclo editorial del catálogo (compat). Preferir lifecycleStatus para venta.
  status          StandardEditionStatus @default(ACTIVE)
  /// Ciclo comercial: DEVELOPMENT | PILOT | LIVE. Objetivo de producto = LIVE.
  lifecycleStatus PackLifecycleStatus   @default(DEVELOPMENT)
  /// Retiro del catálogo comercial. Ortogonal al lifecycle: un pack nunca
  /// "termina" en un estado de lifecycle deshabilitado; se archiva aparte.
  archivedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  editionLinks         StandardPackEdition[]
  orgStandards         OrganizationStandard[]
  entitlements         OrganizationPackEntitlement[]
  readinessAssessments PackReadinessAssessment[]
  lifecycleEvents      StandardPackLifecycleEvent[]

  @@index([lifecycleStatus])
  @@index([archivedAt])
  @@map("standard_packs")
}

model OrganizationPackEntitlement {
  id                String                @id @default(cuid())
  organizationId    String
  packId            String
  source            PackEntitlementSource @default(PLAN)
  enabled           Boolean               @default(true)
  startsAt          DateTime              @default(now())
  expiresAt         DateTime?
  grantedById       String?
  plan              String?
  contractReference String?
  scope             Json?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pack         StandardPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("PackEntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, packId])
  @@index([organizationId, enabled])
  @@index([packId])
  @@map("organization_pack_entitlements")
}

/// Checklist corrido (evaluatePackReadiness) persistido como evidencia de promoción.
model PackReadinessAssessment {
  id              String              @id @default(cuid())
  packId          String
  requestedStatus PackLifecycleStatus
  met             Int
  total           Int
  percent         Int
  ready           Boolean
  actorId         String?
  notes           String?
  createdAt       DateTime            @default(now())

  pack            StandardPack                 @relation(fields: [packId], references: [id], onDelete: Cascade)
  actor           User?                        @relation("PackReadinessActor", fields: [actorId], references: [id], onDelete: SetNull)
  checks          PackReadinessCheck[]
  lifecycleEvents StandardPackLifecycleEvent[]

  @@index([packId, createdAt])
  @@map("pack_readiness_assessments")
}

model PackReadinessCheck {
  id           String  @id @default(cuid())
  assessmentId String
  criterion    String
  met          Boolean
  note         String?

  assessment PackReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("pack_readiness_checks")
}

/// Historial append-only de transiciones de lifecycle de un pack.
model StandardPackLifecycleEvent {
  id           String               @id @default(cuid())
  packId       String
  fromStatus   PackLifecycleStatus?
  toStatus     PackLifecycleStatus
  reason       String?
  actorId      String?
  assessmentId String?
  createdAt    DateTime             @default(now())

  pack       StandardPack             @relation(fields: [packId], references: [id], onDelete: Cascade)
  actor      User?                    @relation("PackLifecycleActor", fields: [actorId], references: [id], onDelete: SetNull)
  assessment PackReadinessAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([packId, createdAt])
  @@map("standard_pack_lifecycle_events")
}

model StandardPackEdition {
  id        String @id @default(cuid())
  packId    String
  editionId String

  pack    StandardPack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  edition StandardEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([packId, editionId])
  @@index([editionId])
  @@map("standard_pack_editions")
}

model RequirementMapping {
  id                  String                  @id @default(cuid())
  sourceRequirementId String
  targetRequirementId String
  relationType        RequirementRelationType @default(RELATED)
  equivalencePercent  Int?
  notes               String?
  createdAt           DateTime                @default(now())

  source StandardRequirement @relation("MappingSource", fields: [sourceRequirementId], references: [id], onDelete: Cascade)
  target StandardRequirement @relation("MappingTarget", fields: [targetRequirementId], references: [id], onDelete: Cascade)

  @@unique([sourceRequirementId, targetRequirementId], map: "requirement_mappings_src_tgt_key")
  @@index([targetRequirementId])
  @@map("requirement_mappings")
}

model RequirementEvidenceRule {
  id              String            @id @default(cuid())
  requirementId   String
  expectedType    EvidenceType      @default(OTHER)
  mandatory       Boolean           @default(true)
  frequency       EvidenceFrequency @default(ON_DEMAND)
  retentionMonths Int?
  note            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  requirement StandardRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("requirement_evidence_rules")
}

model GapQuestionTemplate {
  id            String   @id @default(cuid())
  requirementId String
  question      String
  guidance      String?
  weight        Int      @default(1)
  options       Json?
  version       String   @default("1")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement StandardRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, active])
  @@map("gap_question_templates")
}

model AuditChecklistTemplate {
  id               String   @id @default(cuid())
  requirementId    String
  question         String
  expectedEvidence String?
  criterion        String?
  version          String   @default("1")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requirement StandardRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, active])
  @@map("audit_checklist_templates")
}

model StandardTemplate {
  id            String       @id @default(cuid())
  editionId     String?
  requirementId String?
  templateType  TemplateType @default(DOCUMENT)
  name          String
  content       String // own content / licensed content — never protected full standard text
  version       String       @default("1")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  edition     StandardEdition?     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  requirement StandardRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([editionId, templateType])
  @@index([requirementId])
  @@map("standard_templates")
}

// Shared-satisfaction fabric: one entity (document, risk, evidence, indicator,
// audit…) can satisfy many requirements across many editions/standards at once.
model RequirementCoverage {
  id             String             @id @default(cuid())
  organizationId String
  requirementId  String
  entityType     CoverageEntityType
  entityId       String
  coverageType   String? // primary, supporting, compensating…
  note           String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement  StandardRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("RequirementCoverageAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, requirementId, entityType, entityId], map: "requirement_coverage_unique")
  @@index([organizationId, entityType, entityId], map: "requirement_coverage_org_entity_idx")
  @@index([requirementId])
  @@map("requirement_coverage")
}

model DocumentTemplate {
  id           String       @id @default(cuid())
  code         String       @unique
  standardCode String
  title        String
  description  String?
  documentType DocumentType @default(PROCEDURE)
  clauseId     String?
  content      String
  fieldSchema  Json?
  tags         String[]     @default([])
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  clause    StandardRequirement? @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([standardCode, isActive])
  @@index([clauseId])
  @@map("document_templates")
}

model OrganizationStandard {
  id             String    @id @default(cuid())
  organizationId String
  standardId     String // FK to StandardEdition.id — column name kept for back-compat
  startedAt      DateTime  @default(now())
  targetDate     DateTime?
  score          Float?

  // Standard Pack Engine enrichment (spec §1.5)
  scope                String?
  responsibleId        String?
  startDate            DateTime?
  implementationStatus ImplementationStatus @default(NOT_STARTED)
  certified            Boolean              @default(false)
  certBody             String?
  certExpiresAt        DateTime?
  nextAuditDate        DateTime?
  sourcePackId         String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     StandardEdition @relation(fields: [standardId], references: [id])
  responsible  User?           @relation("OrgStandardResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  sourcePack   StandardPack?   @relation(fields: [sourcePackId], references: [id], onDelete: SetNull)

  @@unique([organizationId, standardId])
  @@index([organizationId, implementationStatus], map: "organization_standards_org_implStatus_idx")
  @@index([sourcePackId])
  @@map("organization_standards")
}

// ─── ISO 27001:2022 ANNEX A CONTROL CATALOG ────────

model ControlCatalogVersion {
  id          String               @id @default(cuid())
  standardId  String
  version     String
  catalogDate DateTime
  status      ControlCatalogStatus @default(DRAFT)
  active      Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  standard StandardEdition   @relation(fields: [standardId], references: [id], onDelete: Restrict)
  controls SecurityControl[]

  @@unique([standardId, version])
  @@index([standardId, active])
  @@map("control_catalog_versions")
}

model SecurityControl {
  id                  String                @id @default(cuid())
  catalogVersionId    String
  code                String
  domain              SecurityControlDomain
  title               String
  descriptionInternal String?
  objective           String?
  sortOrder           Int
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  catalogVersion     ControlCatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Cascade)
  organizationStates OrganizationControl[]
  soaEntries         SoAControlEntry[]

  @@unique([catalogVersionId, code])
  @@index([domain, active])
  @@map("security_controls")
}

model OrganizationControl {
  id                  String                    @id @default(cuid())
  organizationId      String
  controlId           String
  applicability       ControlApplicability      @default(UNDER_REVIEW)
  status              OrganizationControlStatus @default(NOT_ASSESSED)
  responsibleId       String?
  reviewDate          DateTime?
  nextReviewDate      DateTime?
  implementationLevel Int                       @default(0)
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control        SecurityControl        @relation(fields: [controlId], references: [id], onDelete: Cascade)
  responsible    User?                  @relation("SecurityControlResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  evidence       ControlEvidence[]
  reviews        ControlReview[]
  riskLinks      RiskControlLink[]
  treatmentLinks RiskTreatmentControl[]
  assetLinks     AssetControl[]

  @@unique([organizationId, controlId])
  @@index([organizationId, status])
  @@index([organizationId, applicability])
  @@index([organizationId, nextReviewDate])
  @@map("organization_controls")
}

model ControlEvidence {
  id                    String                @id @default(cuid())
  organizationId        String
  organizationControlId String
  evidenceId            String
  period                String
  status                ControlEvidenceStatus @default(PENDING_VALIDATION)
  validatorId           String?
  validatedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  evidence            EvidenceFile        @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  validator           User?               @relation("ControlEvidenceValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  @@unique([organizationControlId, evidenceId, period])
  @@index([organizationId, status])
  @@index([organizationId, evidenceId])
  @@map("control_evidences")
}

model ControlReview {
  id                    String               @id @default(cuid())
  organizationId        String
  organizationControlId String
  result                ControlReviewResult
  effectiveness         ControlEffectiveness
  comments              String?
  reviewerId            String
  reviewedAt            DateTime             @default(now())
  createdAt             DateTime             @default(now())

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  reviewer            User                @relation("ControlReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([organizationId, organizationControlId, reviewedAt])
  @@map("control_reviews")
}

model RiskControlLink {
  id                    String   @id @default(cuid())
  organizationId        String
  riskId                String
  organizationControlId String
  purpose               String
  expectedEffectiveness String?
  observedEffectiveness String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk                Risk                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)

  @@unique([riskId, organizationControlId])
  @@index([organizationId, organizationControlId])
  @@map("risk_control_links")
}

// ─── GAP ASSESSMENT ──────────────────────────────────

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  standardId     String
  title          String
  type           AssessmentType   @default(INTERNAL)
  status         AssessmentStatus @default(IN_PROGRESS)
  globalScore    Float?
  assessorId     String?
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     StandardEdition    @relation(fields: [standardId], references: [id])
  answers      AssessmentAnswer[]

  @@map("assessments")
}

model AssessmentAnswer {
  id           String       @id @default(cuid())
  assessmentId String
  clauseId     String
  score        Int          @default(0) // 0-100
  status       ClauseStatus @default(NOT_EVALUATED)
  comment      String?
  evidence     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessment Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  clause     StandardRequirement @relation(fields: [clauseId], references: [id])

  @@unique([assessmentId, clauseId])
  @@map("assessment_answers")
}

// ─── DOCUMENT CONTROL ────────────────────────────────

model Document {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  title          String
  type           DocumentType
  status         DocumentStatus @default(DRAFT)
  clauseId       String?
  processId      String?
  standardCode   String?
  currentVersion String         @default("1.0")
  ownerId        String?
  reviewDate     DateTime?
  tags           String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // ISOTech manual § 12
  isExternal               Boolean  @default(false)
  externalLink             String?
  custodianId              String?
  responsibleElaborationId String?
  responsibleApprovalId    String?
  locationId               String?
  physicalLocation         String?
  distributionList         String[] @default([])
  observations             String?
  content                  String?
  templateId               String?

  // Reemplazo / supersede: el documento obsoleto (01) apunta a su reemplazo (02).
  supersededById String? @unique

  organization                 Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supersededBy                 Document?                @relation("DocumentSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes                   Document?                @relation("DocumentSupersede")
  clause                       StandardRequirement?     @relation(fields: [clauseId], references: [id])
  process                      Process?                 @relation(fields: [processId], references: [id], onDelete: SetNull)
  location                     Location?                @relation(fields: [locationId], references: [id])
  owner                        User?                    @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  responsibleElaboration       Personnel?               @relation("DocumentElaborationResponsible", fields: [responsibleElaborationId], references: [id], onDelete: SetNull)
  responsibleApproval          Personnel?               @relation("DocumentApprovalResponsible", fields: [responsibleApprovalId], references: [id], onDelete: SetNull)
  custodian                    Personnel?               @relation("DocumentCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  versions                     DocumentVersion[]
  approvals                    Approval[]
  trainingCourseLinks          TrainingCourseDocument[]
  triggeredTrainingAssignments TrainingAssignment[]     @relation("TrainingTriggerDocument")
  changeLinks                  ChangeDocument[]
  supplierLinks                SupplierDocument[]
  evidenceLinks                EvidenceDocumentLink[]
  template                     DocumentTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, standardCode])
  @@index([organizationId, clauseId])
  @@index([organizationId, processId])
  @@index([organizationId, ownerId])
  @@index([processId])
  @@index([ownerId])
  @@index([responsibleElaborationId])
  @@index([responsibleApprovalId])
  @@index([custodianId])
  @@index([templateId])
  @@map("documents")
}

model DocumentVersion {
  id                 String                @id @default(cuid())
  documentId         String
  version            String
  status             DocumentVersionStatus @default(DRAFT)
  reviewedFromStatus DocumentStatus?
  fileUrl            String?
  fileSize           Int?
  mimeType           String?
  changeLog          String?
  changeDescription  String?
  previousVersion    String?
  createdById        String?
  content            String?
  createdAt          DateTime              @default(now())

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@unique([documentId, version])
  @@map("document_versions")
}

model Approval {
  id         String         @id @default(cuid())
  documentId String
  versionId  String?
  approverId String
  status     ApprovalStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("approvals")
}

// ─── PROCESSES ───────────────────────────────────────

model Process {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  type           String? // core, support, strategic
  description    String?
  ownerId        String?
  inputs         String[] @default([])
  outputs        String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents            Document[]
  risks                Risk[]
  indicators           Indicator[]
  trainingAssignments  TrainingAssignment[]
  changeLinks          ChangeProcess[]
  records              Record[]
  groupLinks           GroupProcess[]
  evidenceFiles        EvidenceFile[]
  capas                CAPA[]
  audits               Audit[]
  informationAssets    InformationAsset[]
  bcpLinks             BCPProcess[]
  customerRequirements CustomerRequirement[]
  customerProperties   CustomerProperty[]
  preservationRecords  PreservationRecord[]
  designProjects       DesignProject[]
  biodiversityRecords  EnvironmentalBiodiversityRecord[]

  @@map("processes")
}

// ─── RISK MANAGEMENT ─────────────────────────────────

model Risk {
  id             String        @id @default(cuid())
  organizationId String
  processId      String?
  title          String
  description    String?
  category       String
  probability    Int // 1-5
  impact         Int // 1-5
  score          Int // probability * impact
  status         RiskStatus    @default(IDENTIFIED)
  treatment      RiskTreatment @default(MITIGATE)
  ownerId        String?
  dueDate        DateTime?
  residualScore  Int?
  /// SIG: riesgos y oportunidades integrados — un riesgo puede pertenecer a
  /// varias disciplinas (QUALITY / ENVIRONMENT / SAFETY / SECURITY) y normas.
  disciplines    Discipline[]  @default([])
  standards      String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process                Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  controls               Control[]
  actions                Action[]
  changeLinks            ChangeRisk[]
  supplierLinks          SupplierRisk[]
  evidenceLinks          EvidenceRiskLink[]
  managementReviewInputs ManagementReviewInput[]
  securityControlLinks   RiskControlLink[]
  treatmentItems         RiskTreatmentItem[]     @relation("RiskTreatmentItemRisk")
  assetRisks             AssetRisk[]

  @@index([processId])
  @@map("risks")
}

model Control {
  id          String        @id @default(cuid())
  riskId      String
  title       String
  description String?
  type        ControlType   @default(PREVENTIVE)
  status      ControlStatus @default(PLANNED)
  ownerId     String?
  createdAt   DateTime      @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@map("controls")
}

// ─── AUDITS ──────────────────────────────────────────

model Audit {
  id               String      @id @default(cuid())
  organizationId   String
  programId        String?
  processId        String?
  title            String
  type             AuditType   @default(INTERNAL)
  standardCode     String?
  /// SIG: auditoría integrada — una sola auditoría cubre varias normas.
  /// `standardCode` se conserva como norma principal para compatibilidad.
  standards        String[]    @default([])
  integrated       Boolean     @default(false)
  status           AuditStatus @default(PLANNED)
  auditorId        String?
  auditorExternal  String?
  plannedDate      DateTime?
  scheduledDate    DateTime?
  startDate        DateTime?
  endDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  scope            String?
  objectives       String?
  criteria         String?
  reportUrl        String?
  reportSummary    String?
  reportConclusion String?
  reportIssuedAt   DateTime?
  closedById       String?
  progress         Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program                AuditProgram?           @relation(fields: [programId], references: [id])
  process                Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  closedBy               User?                   @relation("AuditClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  findings               AuditFinding[]
  nonconformities        Nonconformity[]
  checklistItems         AuditChecklistItem[]
  evidenceLinks          EvidenceAuditLink[]
  participants           AuditParticipant[]
  managementReviewInputs ManagementReviewInput[]
  clause                 StandardRequirement?    @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  clauseId               String?

  @@index([organizationId, plannedDate])
  @@index([organizationId, processId])
  @@index([organizationId, status])
  @@index([organizationId, clauseId])
  @@index([organizationId, integrated])
  @@map("audits")
}

model AuditFinding {
  id          String          @id @default(cuid())
  auditId     String
  title       String
  description String?
  type        FindingType     @default(OBSERVATION)
  severity    FindingSeverity @default(MINOR)
  clauseCode  String?
  status      FindingStatus   @default(OPEN)
  evidenceUrl String?
  /// SIG: un hallazgo puede afectar a varias normas a la vez (ISO_9001, ISO_14001…).
  /// Evita duplicar el mismo hallazgo una vez por norma.
  standards   String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  audit         Audit                 @relation(fields: [auditId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity?
  evidenceLinks EvidenceFindingLink[]
  capa          CAPA?

  @@map("audit_findings")
}

// ─── NONCONFORMITIES / CAPA ──────────────────────────

model Nonconformity {
  id                     String     @id @default(cuid())
  organizationId         String
  auditId                String?
  findingId              String?    @unique
  title                  String
  description            String?
  source                 NCSource   @default(INTERNAL_AUDIT)
  severity               NCSeverity @default(MINOR)
  status                 NCStatus   @default(OPEN)
  ownerId                String?
  rootCause              String?
  dueDate                DateTime?
  closedAt               DateTime?
  effectivenessValidated Boolean    @default(false)
  archiveReason          String?
  archivedAt             DateTime?
  archivedById           String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit                  Audit?                      @relation(fields: [auditId], references: [id])
  finding                AuditFinding?               @relation(fields: [findingId], references: [id])
  actions                Action[]
  changeRequests         ChangeRequest[]
  supplierLinks          SupplierNonconformity[]
  comments               NonconformityComment[]
  evidenceLinks          EvidenceNonconformityLink[]
  capa                   CAPA?
  managementReviewInputs ManagementReviewInput[]

  @@map("nonconformities")
}

model NonconformityComment {
  id              String   @id @default(cuid())
  nonconformityId String
  authorId        String
  content         String
  createdAt       DateTime @default(now())

  nonconformity Nonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)

  @@index([nonconformityId, createdAt])
  @@map("nonconformity_comments")
}

// ─── OPPORTUNITIES ──────────────────────────────────

model Opportunity {
  id                      String            @id @default(cuid())
  organizationId          String
  title                   String
  description             String?
  standardCode            String?
  source                  String?
  category                String
  status                  OpportunityStatus @default(IDENTIFIED)
  ownerId                 String?
  reviewerId              String?
  materializationAnalysis String?
  materializationPlan     String?
  materializationEvidence String?
  dueDate                 DateTime?
  materializedAt          DateTime?
  closedAt                DateTime?
  rejectionReason         String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewer     User?        @relation("OpportunityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, reviewerId, status])
  @@map("opportunities")
}

// ─── ACTIONS ─────────────────────────────────────────

model Action {
  id                         String       @id @default(cuid())
  organizationId             String
  title                      String
  description                String?
  type                       ActionType   @default(CORRECTIVE)
  priority                   Priority     @default(MEDIUM)
  status                     ActionStatus @default(PENDING)
  stage                      ACPMStage    @default(REQUEST)
  source                     String?
  rootCause                  String?
  proposedSolution           String?
  effectivenessCheck         String?
  effectivenessAt            DateTime?
  ownerId                    String?
  requestedById              String?
  requestApproverId          String?
  solutionApproverId         String?
  dueDate                    DateTime?
  completedAt                DateTime?
  progress                   Int          @default(0)
  riskId                     String?
  nonconformityId            String?
  managementReviewId         String?
  managementReviewDecisionId String?      @unique
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk                     Risk?                     @relation(fields: [riskId], references: [id])
  nonconformity            Nonconformity?            @relation(fields: [nonconformityId], references: [id])
  managementReview         ManagementReview?         @relation(fields: [managementReviewId], references: [id])
  managementReviewDecision ManagementReviewDecision? @relation(fields: [managementReviewDecisionId], references: [id], onDelete: SetNull)
  comments                 ActionComment[]
  managementReviewInputs   ManagementReviewInput[]

  @@map("actions")
}

model ActionComment {
  id        String   @id @default(cuid())
  actionId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_comments")
}

// ─── ACPM / CAPA ────────────────────────────────────

model CAPA {
  id                     String               @id @default(cuid())
  organizationId         String
  code                   String
  title                  String
  description            String
  origin                 ACPMOrigin           @default(OTHER)
  standardCode           String?
  /// SIG: CAPA común — una sola acción correctiva cubre varias normas.
  standards              String[]             @default([])
  clauseId               String?
  processId              String?
  nonconformityId        String?              @unique
  findingId              String?              @unique
  severity               NCSeverity           @default(MINOR)
  priority               Priority             @default(MEDIUM)
  stage                  CAPAStage            @default(REGISTERED)
  rootCauseMethod        ACPMRootCauseMethod?
  fiveWhys               Json?
  ishikawaAnalysis       String?
  rootCause              String?
  rootCauseApproved      Boolean              @default(false)
  rootCauseApprovedById  String?
  rootCauseApprovedAt    DateTime?
  correctiveAction       String?
  ownerId                String?
  dueDate                DateTime?
  progress               Int                  @default(0)
  implementationComments String?
  efficacyStatus         ACPMEfficacyStatus   @default(PENDING)
  verifierId             String?
  verifierComment        String?
  verifiedAt             DateTime?
  closedAt               DateTime?
  closedById             String?
  lessonsLearned         String?
  requestedById          String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clause                 StandardRequirement?    @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  process                Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  nonconformity          Nonconformity?          @relation(fields: [nonconformityId], references: [id], onDelete: SetNull)
  finding                AuditFinding?           @relation(fields: [findingId], references: [id], onDelete: SetNull)
  owner                  User?                   @relation("CAPAOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  requestedBy            User                    @relation("CAPARequester", fields: [requestedById], references: [id], onDelete: Restrict)
  rootCauseApprovedBy    User?                   @relation("CAPARootCauseApprovedBy", fields: [rootCauseApprovedById], references: [id], onDelete: SetNull)
  verifier               User?                   @relation("CAPAVerifier", fields: [verifierId], references: [id], onDelete: SetNull)
  closedBy               User?                   @relation("CAPACloser", fields: [closedById], references: [id], onDelete: SetNull)
  evidences              CAPAEvidence[]
  comments               CAPAComment[]
  managementReviewInputs ManagementReviewInput[]
  linkedCustomerFeedback CustomerFeedback[]

  @@unique([organizationId, code])
  @@index([organizationId, stage])
  @@index([organizationId, dueDate])
  @@index([organizationId, processId])
  @@index([organizationId, clauseId])
  @@index([organizationId, findingId])
  @@map("capas")
}

model CAPAEvidence {
  id             String           @id @default(cuid())
  organizationId String
  capaId         String
  kind           CAPAEvidenceKind
  title          String
  description    String?
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  uploadedById   String
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capa         CAPA         @relation(fields: [capaId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("CAPAEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, capaId, kind])
  @@map("capa_evidences")
}

model CAPAComment {
  id        String   @id @default(cuid())
  capaId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  capa   CAPA @relation(fields: [capaId], references: [id], onDelete: Cascade)
  author User @relation("CAPACommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([capaId, createdAt])
  @@map("capa_comments")
}

// ─── INDICATORS ──────────────────────────────────────

model Indicator {
  id             String          @id @default(cuid())
  organizationId String
  processId      String?
  name           String
  description    String?
  unit           String
  target         Float
  frequency      String          @default("monthly")
  ownerId        String?
  status         IndicatorStatus @default(ON_TRACK)
  clauseCode     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process                Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  values                 IndicatorValue[]
  evidenceLinks          EvidenceIndicatorLink[]
  managementReviewInputs ManagementReviewInput[]

  @@index([processId])
  @@map("indicators")
}

model IndicatorValue {
  id          String   @id @default(cuid())
  indicatorId String
  value       Float
  period      String // "2025-06"
  note        String?
  createdAt   DateTime @default(now())

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@map("indicator_values")
}

// ─── QUALITY OPERATIONS ──────────────────────────────
// Structured capture for ISO 9001 operational requirements that previously
// depended entirely on free-text documents: customer requirements (7.2),
// customer property (8.5.3), preservation (8.5.4), customer satisfaction
// (9.1.2) and communication (7.4 — shared with ISO 27001, same Annex SL
// clause number). See src/lib/actions/quality-operations.ts.

enum CustomerRequirementStatus {
  OPEN
  REVIEWED
  MET
}

model CustomerRequirement {
  id             String                    @id @default(cuid())
  organizationId String
  code           String
  title          String
  description    String?
  source         String? // cliente, contrato, licitación…
  processId      String?
  status         CustomerRequirementStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  createdById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("customer_requirements")
}

enum CustomerPropertyStatus {
  IN_CUSTODY
  RETURNED
  LOST_OR_DAMAGED
}

model CustomerProperty {
  id                 String                 @id @default(cuid())
  organizationId     String
  code               String
  description        String
  customerName       String
  conditionOnReceipt String?
  receivedAt         DateTime               @default(now())
  returnedAt         DateTime?
  status             CustomerPropertyStatus @default(IN_CUSTODY)
  incidentNote       String? // requerido al reportar pérdida/daño (9001 §8.5.3)
  responsibleId      String?
  processId          String?
  createdById        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("customer_properties")
}

enum PreservationStatus {
  COMPLIANT
  NON_COMPLIANT
  UNDER_REVIEW
}

model PreservationRecord {
  id                   String             @id @default(cuid())
  organizationId       String
  code                 String
  itemDescription      String
  handlingInstructions String?
  storageConditions    String?
  packagingNote        String?
  status               PreservationStatus @default(UNDER_REVIEW)
  reviewedById         String?
  reviewedAt           DateTime?
  responsibleId        String?
  processId            String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("preservation_records")
}

enum CustomerFeedbackChannel {
  SURVEY
  COMPLAINT
  COMPLIMENT
  REVIEW
  INTERVIEW
  OTHER
}

enum CustomerFeedbackStatus {
  RECEIVED
  ANALYZED
  ACTION_TAKEN
  CLOSED
}

model CustomerFeedback {
  id             String                  @id @default(cuid())
  organizationId String
  code           String
  customerName   String?
  channel        CustomerFeedbackChannel @default(SURVEY)
  score          Int? // 0-100 normalizado
  comment        String?
  receivedAt     DateTime                @default(now())
  status         CustomerFeedbackStatus  @default(RECEIVED)
  linkedCapaId   String?
  responsibleId  String?
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedCapa   CAPA?        @relation(fields: [linkedCapaId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, receivedAt])
  @@map("customer_feedback")
}

enum CommunicationDirection {
  INTERNAL
  EXTERNAL
}

model CommunicationRecord {
  id               String                 @id @default(cuid())
  organizationId   String
  code             String
  subject          String
  content          String?
  direction        CommunicationDirection @default(INTERNAL)
  audience         String? // "empleados", "clientes", "autoridad"…
  channel          String? // email, reunión, boletín, intranet…
  standards        String[]               @default([])
  communicatedById String?
  communicatedAt   DateTime               @default(now())
  createdById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communicatedBy User?        @relation("CommunicationCommunicatedBy", fields: [communicatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, direction])
  @@map("communication_records")
}

// ─── DESIGN & DEVELOPMENT (ISO 9001 §8.3) ────────────
// Generic, configurable design & development for any org — NOT the ISO
// 13485 DHF (DesignHistoryFile/DesignInput/…), which stays hard-scoped to
// MedicalDevice on purpose. A project's stages are free-form rows, not fixed
// schema columns: skip what doesn't apply, add more of what does.

enum DesignProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model DesignProject {
  id             String              @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  status         DesignProjectStatus @default(PLANNING)
  ownerId        String?
  processId      String?
  plannedStart   DateTime?
  plannedEnd     DateTime?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?      @relation(fields: [processId], references: [id], onDelete: SetNull)
  stages       DesignStage[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("design_projects")
}

enum DesignStageType {
  PLANNING
  INPUT
  OUTPUT
  REVIEW
  VERIFICATION
  VALIDATION
  CHANGE_CONTROL
  TRANSFER
}

enum DesignStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model DesignStage {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  code           String
  stageType      DesignStageType
  title          String
  description    String?
  result         String?
  status         DesignStageStatus @default(PENDING)
  responsibleId  String?
  evidenceId     String?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@map("design_stages")
}

// ─── EVIDENCE ────────────────────────────────────────

model EvidenceFile {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String?
  evidenceType   EvidenceType   @default(OTHER)
  status         EvidenceStatus @default(PENDING_REVIEW)
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  processId      String?
  standardCode   String?
  clauseId       String?
  responsibleId  String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  module         String? // legacy polymorphic link kept for backwards compatibility
  moduleId       String?
  uploadedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization              Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process                   Process?                       @relation(fields: [processId], references: [id], onDelete: SetNull)
  clause                    StandardRequirement?           @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  uploadedBy                User?                          @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  responsible               User?                          @relation("EvidenceResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  reviewedBy                User?                          @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documentLinks             EvidenceDocumentLink[]
  riskLinks                 EvidenceRiskLink[]
  auditLinks                EvidenceAuditLink[]
  findingLinks              EvidenceFindingLink[]
  nonconformityLinks        EvidenceNonconformityLink[]
  indicatorLinks            EvidenceIndicatorLink[]
  managementReviewLinks     EvidenceManagementReviewLink[]
  controlEvidences          ControlEvidence[]
  soaApprovalEvidence       StatementOfApplicability[]     @relation("SoAApprovalEvidence")
  soaEntryEvidence          SoAControlEntry[]              @relation("SoAEntryEvidence")
  riskPlanApprovalEvidence  RiskTreatmentPlan[]            @relation("RiskPlanApprovalEvidence")
  riskAcceptanceEvidence    RiskAcceptance[]               @relation("RiskAcceptanceEvidence")
  assetControlEvidence      AssetControl[]                 @relation("AssetControlEvidence")
  incidentEvidence          SecurityIncidentEvidence[]
  remediationEvidence       Remediation[]                  @relation("RemediationEvidence")
  verificationEvidence      Verification[]                 @relation("VerificationEvidence")
  testResultEvidence        TestResult[]                   @relation("TestResultEvidence")
  supplierSecurityEvidence  SupplierSecurityProfile[]      @relation("SupplierSecurityEvidence")
  biaEvidence               BusinessImpactAnalysis[]       @relation("BiaEvidence")
  continuityVersionEvidence ContinuityPlanVersion[]        @relation("ContinuityVersionEvidence")
  planActivationEvidence    PlanActivation[]               @relation("PlanActivationEvidence")
  designStages              DesignStage[]

  @@index([organizationId, status])
  @@index([organizationId, expiresAt])
  @@index([organizationId, evidenceType])
  @@index([organizationId, processId])
  @@index([organizationId, clauseId])
  @@index([organizationId, responsibleId])
  @@map("evidence_files")
}

model EvidenceDocumentLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  documentId     String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, documentId])
  @@index([organizationId, documentId])
  @@map("evidence_document_links")
}

model EvidenceRiskLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  riskId         String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  risk         Risk         @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, riskId])
  @@index([organizationId, riskId])
  @@map("evidence_risk_links")
}

model EvidenceAuditLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  auditId        String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, auditId])
  @@index([organizationId, auditId])
  @@map("evidence_audit_links")
}

model EvidenceFindingLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  findingId      String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  finding      AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, findingId])
  @@index([organizationId, findingId])
  @@map("evidence_finding_links")
}

model EvidenceNonconformityLink {
  id              String   @id @default(cuid())
  organizationId  String
  evidenceId      String
  nonconformityId String
  createdById     String?
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence      EvidenceFile  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, nonconformityId])
  @@index([organizationId, nonconformityId])
  @@map("evidence_nonconformity_links")
}

model EvidenceIndicatorLink {
  id             String   @id @default(cuid())
  organizationId String
  evidenceId     String
  indicatorId    String
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  indicator    Indicator    @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, indicatorId])
  @@index([organizationId, indicatorId])
  @@map("evidence_indicator_links")
}

model EvidenceManagementReviewLink {
  id                 String   @id @default(cuid())
  organizationId     String
  evidenceId         String
  managementReviewId String
  createdById        String?
  createdAt          DateTime @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence         EvidenceFile     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  managementReview ManagementReview @relation(fields: [managementReviewId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, managementReviewId])
  @@index([organizationId, managementReviewId])
  @@map("evidence_management_review_links")
}

// ─── NOTIFICATIONS ───────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  type           NotificationType @default(INFO)
  read           Boolean          @default(false)
  readAt         DateTime?
  link           String?
  idempotencyKey String?
  createdAt      DateTime         @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryJob  NotificationDeliveryJob?

  @@unique([organizationId, idempotencyKey])
  @@index([userId, read, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  emailEnabled   Boolean            @default(true)
  disabledTypes  NotificationType[] @default([])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("notification_preferences")
}

model NotificationDeliveryJob {
  id                  String                     @id @default(cuid())
  organizationId      String
  notificationId      String?                    @unique
  userId              String?
  recipientEmail      String
  recipientName       String
  title               String
  body                String
  link                String?
  idempotencyKey      String
  status              NotificationDeliveryStatus @default(PENDING)
  attempts            Int                        @default(0)
  maxAttempts         Int                        @default(5)
  nextAttemptAt       DateTime                   @default(now())
  processingStartedAt DateTime?
  providerMessageId   String?
  lastError           String?
  lastErrorAt         DateTime?
  sentAt              DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("notification_delivery_jobs")
}

// ─── BILLING ─────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  gracePeriodEndsAt    DateTime?
  suspendedAt          DateTime?
  lastPaymentFailedAt  DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     BillingInvoice[]

  @@map("subscriptions")
}

model BillingInvoice {
  id               String    @id @default(cuid())
  organizationId   String
  subscriptionId   String?
  stripeInvoiceId  String    @unique
  number           String?
  status           String
  currency         String    @default("usd")
  amountDue        Int
  amountPaid       Int       @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?
  hostedInvoiceUrl String?
  invoicePdf       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([subscriptionId])
  @@map("billing_invoices")
}

model StripeWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  payload     Json?
  attempts    Int       @default(1)
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([type, createdAt])
  @@index([processedAt])
  @@map("stripe_webhook_events")
}

model ReportExport {
  id                  String               @id @default(cuid())
  organizationId      String
  generatedById       String?
  reportType          String
  format              ReportFormat
  dateFrom            DateTime
  dateTo              DateTime
  rowCount            Int
  fileName            String
  mimeType            String?
  title               String?
  filters             Json?
  content             Bytes?
  storagePath         String?
  fileSize            Int?
  checksum            String?
  status              ReportArtifactStatus @default(QUEUED)
  error               String?
  idempotencyKey      String?
  attempts            Int                  @default(0)
  maxAttempts         Int                  @default(3)
  nextAttemptAt       DateTime             @default(now())
  processingStartedAt DateTime?
  leaseToken          String?
  lastErrorAt         DateTime?
  failedAt            DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([generatedById])
  @@index([organizationId, status, createdAt])
  @@map("report_exports")
}

enum ReportArtifactStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// ─── AUDIT LOGS ──────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  module         String
  recordId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  // El historial por entidad consulta (organizationId, module, recordId). Sin
  // este índice es un seq scan sobre la tabla que más crece del sistema: le
  // escriben los webhooks de Stripe, la aplicación de límites de plan, los
  // artefactos de informe y las 23 áreas de acciones.
  @@index([organizationId, module, recordId, createdAt])
  // La actividad de la organización se lee siempre por fecha descendente.
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model OnboardingMetricEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  event          String
  step           Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, event, createdAt])
  @@index([userId, createdAt])
  @@map("onboarding_metric_events")
}

// ─── ISOTECH MANUAL ALIGNMENT ───────────────────────
// Models that extend the SaaS to cover the ISOTech functional reference.
// All entities are tenant-scoped via organizationId.

// § 10.2 Grupos / § 10.3 Permiso a Grupo / § 10.4 Usuarios de Grupo
model Group {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMembership[]
  permissions  GroupPermission[]
  processLinks GroupProcess[]
  moduleLinks  GroupModule[]

  @@unique([organizationId, name])
  @@map("groups")
}

model GroupProcess {
  id        String   @id @default(cuid())
  groupId   String
  processId String
  createdAt DateTime @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([groupId, processId])
  @@index([processId])
  @@map("group_processes")
}

model GroupModule {
  id        String   @id @default(cuid())
  groupId   String
  module    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, module])
  @@map("group_modules")
}

model OrganizationCatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  kind           String
  name           String
  description    String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, active])
  @@map("organization_catalog_items")
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_memberships")
}

model GroupPermission {
  id         String @id @default(cuid())
  groupId    String
  permission String // e.g. "documents:create", "records:*"

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, permission])
  @@map("group_permissions")
}

// § 11.1 Cargo
model Position {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnel    Personnel[]

  @@unique([organizationId, name])
  @@map("positions")
}

// § 11.3 Datos Personal
model Personnel {
  id             String    @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  identification String?
  positionId     String?
  active         Boolean   @default(true)
  hiredAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position              Position?                @relation(fields: [positionId], references: [id])
  trainingAssignments   TrainingAssignment[]
  trainingAudienceLinks TrainingCourseAudience[]
  documentsElaborated   Document[]               @relation("DocumentElaborationResponsible")
  documentsApproved     Document[]               @relation("DocumentApprovalResponsible")
  documentsCustodied    Document[]               @relation("DocumentCustodian")
  recordsCustodied      Record[]                 @relation("RecordCustodian")

  @@map("personnel")
}

// ─── TRAINING MANAGEMENT ─────────────────────────────────

model TrainingCourse {
  id                      String   @id @default(cuid())
  organizationId          String
  code                    String
  title                   String
  description             String?
  standardTags            String[] @default([])
  defaultValidityMonths   Int      @default(12)
  defaultDueDays          Int      @default(30)
  mandatory               Boolean  @default(false)
  autoAssignOnDocApproval Boolean  @default(false)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentLinks TrainingCourseDocument[]
  audienceLinks TrainingCourseAudience[]
  assignments   TrainingAssignment[]
  changeLinks   ChangeTrainingCourse[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("training_courses")
}

model TrainingCourseDocument {
  courseId   String
  documentId String

  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([courseId, documentId])
  @@index([documentId])
  @@map("training_course_documents")
}

model TrainingCourseAudience {
  courseId    String
  personnelId String

  course    TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personnel Personnel      @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@id([courseId, personnelId])
  @@index([personnelId])
  @@map("training_course_audience")
}

model TrainingAssignment {
  id                    String                   @id @default(cuid())
  organizationId        String
  courseId              String
  personnelId           String
  processId             String?
  status                TrainingAssignmentStatus @default(ASSIGNED)
  assignedAt            DateTime                 @default(now())
  dueAt                 DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  evidenceNote          String?
  evidenceUrl           String?
  triggeredByDocumentId String?
  triggeredByVersion    String?
  reminderSentAt        DateTime?
  createdById           String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course              TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  personnel           Personnel      @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  process             Process?       @relation(fields: [processId], references: [id], onDelete: SetNull)
  triggeredByDocument Document?      @relation("TrainingTriggerDocument", fields: [triggeredByDocumentId], references: [id], onDelete: SetNull)

  @@unique([courseId, personnelId, triggeredByDocumentId, triggeredByVersion])
  @@index([organizationId, status])
  @@index([personnelId, dueAt])
  @@index([courseId])
  @@map("training_assignments")
}

// ─── CHANGE CONTROL ─────────────────────────────────────

model ChangeRequest {
  id              String              @id @default(cuid())
  organizationId  String
  code            String
  title           String
  category        String
  changeType      String
  reason          String
  impact          ChangeImpact        @default(MEDIUM)
  affectedAreas   String[]            @default([])
  /// SIG: gestión de cambios con impacto múltiple — un cambio puede afectar
  /// a varias disciplinas y normas del sistema integrado.
  disciplines     Discipline[]        @default([])
  standards       String[]            @default([])
  status          ChangeRequestStatus @default(DRAFT)
  requesterId     String?
  requesterName   String?
  nonconformityId String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  implementedAt   DateTime?
  verifiedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nonconformity   Nonconformity?         @relation(fields: [nonconformityId], references: [id], onDelete: SetNull)
  processes       ChangeProcess[]
  documents       ChangeDocument[]
  risks           ChangeRisk[]
  trainingCourses ChangeTrainingCourse[]
  approvers       ChangeApprover[]
  tasks           ChangeTask[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([nonconformityId])
  @@map("change_requests")
}

model ChangeProcess {
  changeRequestId String
  processId       String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  process       Process       @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, processId])
  @@index([processId])
  @@map("change_processes")
}

model ChangeDocument {
  changeRequestId String
  documentId      String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, documentId])
  @@index([documentId])
  @@map("change_documents")
}

model ChangeRisk {
  changeRequestId String
  riskId          String

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  risk          Risk          @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, riskId])
  @@index([riskId])
  @@map("change_risks")
}

model ChangeTrainingCourse {
  changeRequestId String
  courseId        String

  changeRequest ChangeRequest  @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([changeRequestId, courseId])
  @@index([courseId])
  @@map("change_training_courses")
}

model ChangeApprover {
  id                String         @id @default(cuid())
  changeRequestId   String
  userId            String
  status            ApprovalStatus @default(PENDING)
  comment           String?
  decidedAt         DateTime?
  attestationReason String?
  createdAt         DateTime       @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@unique([changeRequestId, userId])
  @@index([userId])
  @@map("change_approvers")
}

model ChangeTask {
  id              String    @id @default(cuid())
  changeRequestId String
  title           String
  done            Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId, done])
  @@map("change_tasks")
}

// ─── SUPPLIER MANAGEMENT ─────────────────────────────────

model Supplier {
  id               String              @id @default(cuid())
  organizationId   String
  code             String
  name             String
  category         String
  criticality      SupplierCriticality @default(MEDIUM)
  ownerId          String?
  status           SupplierStatus      @default(UNDER_REVIEW)
  contactName      String?
  contactEmail     String?
  notes            String?
  nextReviewDue    DateTime?
  lastEvaluationAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents       SupplierDocument[]
  risks           SupplierRisk[]
  nonconformities SupplierNonconformity[]
  evaluations     SupplierEvaluation[]
  securityProfile SupplierSecurityProfile?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([nextReviewDue])
  @@map("suppliers")
}

model SupplierDocument {
  supplierId String
  documentId String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([supplierId, documentId])
  @@index([documentId])
  @@map("supplier_documents")
}

model SupplierRisk {
  supplierId String
  riskId     String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  risk     Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@id([supplierId, riskId])
  @@index([riskId])
  @@map("supplier_risks")
}

model SupplierNonconformity {
  supplierId      String
  nonconformityId String

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  nonconformity Nonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)

  @@id([supplierId, nonconformityId])
  @@index([nonconformityId])
  @@map("supplier_nonconformities")
}

model SupplierEvaluation {
  id               String                    @id @default(cuid())
  supplierId       String
  score            Int?
  outcome          SupplierEvaluationOutcome
  notes            String?
  evaluatedById    String?
  evaluatedAt      DateTime                  @default(now())
  nextReviewDue    DateTime?
  /// SIG: un proveedor se evalúa una sola vez cubriendo calidad, ambiente y SST.
  /// `score` sigue siendo la nota global (media de las dimensiones evaluadas).
  qualityScore     Int?
  environmentScore Int?
  safetyScore      Int?
  disciplines      Discipline[]              @default([])

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, evaluatedAt])
  @@map("supplier_evaluations")
}

// ─── INTEGRATIONS ────────────────────────────────────────

model Integration {
  id               String            @id @default(cuid())
  organizationId   String
  key              String
  name             String
  provider         String
  category         String
  description      String?
  valueProposition String?
  status           IntegrationStatus @default(NOT_CONNECTED)
  externalAccount  String?
  config           Json?
  detailNote       String?
  lastSyncAt       DateTime?
  connectedAt      DateTime?
  configuredById   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncRuns     IntegrationSyncRun[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("integrations")
}

model IntegrationSyncRun {
  id               String                @id @default(cuid())
  integrationId    String
  status           IntegrationSyncStatus @default(RUNNING)
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  recordsProcessed Int                   @default(0)
  evidenceCreated  Int                   @default(0)
  errorMessage     String?
  metadata         Json?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
  @@map("integration_sync_runs")
}

// § 12.1.1 Lugar
model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents         Document[]
  informationAssets InformationAsset[]

  @@unique([organizationId, name])
  @@map("locations")
}

// § 13.1.1 Tiempo de Retención
model RetentionTime {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  months         Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("retention_times")
}

// § 13.1.2 Disposición
model Disposition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("dispositions")
}

// § 13.1.3 Método de Archivo
model ArchiveMethod {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, name])
  @@map("archive_methods")
}

// § 13.1.4 Tipo de Registro
model RecordType {
  id             String   @id @default(cuid())
  organizationId String
  code           String?
  name           String // FISICO, ELECTRONICO, FISICO_Y_ELECTRONICO, ...
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      Record[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@map("record_types")
}

// § 13.2 Control de Registros
model Record {
  id               String             @id @default(cuid())
  organizationId   String
  code             String
  name             String
  processId        String?
  clauseId         String?
  recordTypeId     String?
  retentionTimeId  String?
  dispositionId    String?
  archiveMethodId  String?
  custodianId      String?
  reviewerId       String?
  reviewStatus     RecordReviewStatus @default(DRAFT)
  reviewComment    String?
  reviewedAt       DateTime?
  physicalLocation String?
  digitalLocation  String?
  observations     String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process       Process?             @relation(fields: [processId], references: [id], onDelete: SetNull)
  clause        StandardRequirement? @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  recordType    RecordType?          @relation(fields: [recordTypeId], references: [id])
  retentionTime RetentionTime?       @relation(fields: [retentionTimeId], references: [id])
  disposition   Disposition?         @relation(fields: [dispositionId], references: [id])
  archiveMethod ArchiveMethod?       @relation(fields: [archiveMethodId], references: [id])
  custodian     Personnel?           @relation("RecordCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  reviewer      User?                @relation("RecordReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  entries       RecordEntry[]

  @@unique([organizationId, code])
  @@index([processId])
  @@index([organizationId, clauseId])
  @@index([custodianId])
  @@map("records")
}

model RecordEntry {
  id            String            @id @default(cuid())
  recordId      String
  title         String            @default("Entrada")
  reference     String? // e.g. registry number, batch
  description   String?
  entryDate     DateTime          @default(now())
  status        RecordEntryStatus @default(VALID)
  responsibleId String?
  fileName      String?
  fileUrl       String?
  fileSize      Int?
  mimeType      String?
  enteredById   String?
  enteredAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  record      Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  responsible User?  @relation("RecordEntryResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  enteredBy   User?  @relation("RecordEntryEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@index([recordId, entryDate])
  @@index([recordId, status])
  @@index([responsibleId])
  @@map("record_entries")
}

// § 15 Programa de Auditoría (annual program grouping audits)
model AuditProgram {
  id             String             @id @default(cuid())
  organizationId String
  year           Int
  title          String
  objectives     String?
  scope          String?
  standards      String[]           @default([])
  criteria       String?
  responsibleId  String?
  status         AuditProgramStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("AuditProgramResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  audits       Audit[]

  @@unique([organizationId, year, title])
  @@map("audit_programs")
}

model AuditChecklistItem {
  id          String              @id @default(cuid())
  auditId     String
  clauseCode  String?
  clauseId    String?
  question    String
  expected    String?
  response    String?
  status      ChecklistItemStatus @default(PENDING)
  evidenceUrl String?
  notes       String?
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())

  audit  Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)
  clause StandardRequirement? @relation(fields: [clauseId], references: [id], onDelete: SetNull)

  @@map("audit_checklist_items")
}

model AuditParticipant {
  id             String               @id @default(cuid())
  organizationId String
  auditId        String
  userId         String
  role           AuditParticipantRole @default(AUDITEE)
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([auditId, userId])
  @@index([organizationId, auditId])
  @@index([userId])
  @@map("audit_participants")
}

// § 16 Revisión por la Dirección
model ManagementReview {
  id             String                 @id @default(cuid())
  organizationId String
  title          String
  scheduledDate  DateTime?
  heldAt         DateTime?
  status         ManagementReviewStatus @default(PLANNED)
  chairId        String?
  attendees      String[]               @default([]) // free-text names or user IDs
  standards      String[]               @default([])
  summary        String?
  reportUrl      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inputs        ManagementReviewInput[]
  decisions     ManagementReviewDecision[]
  actions       Action[]
  evidenceLinks EvidenceManagementReviewLink[]
  participants  ManagementReviewParticipant[]

  @@map("management_reviews")
}

model ManagementReviewInput {
  id              String                @id @default(cuid())
  reviewId        String
  topic           ManagementReviewTopic
  content         String
  auditId         String?
  indicatorId     String?
  riskId          String?
  nonconformityId String?
  actionId        String?
  capaId          String?
  createdAt       DateTime              @default(now())

  review        ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  audit         Audit?           @relation(fields: [auditId], references: [id], onDelete: SetNull)
  indicator     Indicator?       @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  risk          Risk?            @relation(fields: [riskId], references: [id], onDelete: SetNull)
  nonconformity Nonconformity?   @relation(fields: [nonconformityId], references: [id], onDelete: SetNull)
  action        Action?          @relation(fields: [actionId], references: [id], onDelete: SetNull)
  capa          CAPA?            @relation(fields: [capaId], references: [id], onDelete: SetNull)

  @@index([reviewId, topic])
  @@index([auditId])
  @@index([indicatorId])
  @@index([riskId])
  @@index([nonconformityId])
  @@index([actionId])
  @@index([capaId])
  @@map("management_review_inputs")
}

model ManagementReviewDecision {
  id        String    @id @default(cuid())
  reviewId  String
  topic     String
  decision  String
  ownerId   String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  review ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  action Action?

  @@map("management_review_decisions")
}

model ManagementReviewParticipant {
  id             String                          @id @default(cuid())
  organizationId String
  reviewId       String
  userId         String
  role           ManagementReviewParticipantRole @default(ATTENDEE)
  createdAt      DateTime                        @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([organizationId, reviewId])
  @@index([userId])
  @@map("management_review_participants")
}

// ─── STATEMENT OF APPLICABILITY ──────────────────────

model StatementOfApplicability {
  id                 String    @id @default(cuid())
  organizationId     String
  version            Int
  status             SoAStatus @default(DRAFT)
  scope              String?
  ownerId            String?
  approverId         String?
  approvalComment    String?
  approvalEvidenceId String?
  approvedAt         DateTime?
  nextReviewDate     DateTime?
  supersededById     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?                      @relation("SoAOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approver         User?                      @relation("SoAApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalEvidence EvidenceFile?              @relation("SoAApprovalEvidence", fields: [approvalEvidenceId], references: [id], onDelete: SetNull)
  supersededBy     StatementOfApplicability?  @relation("SoASupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       StatementOfApplicability[] @relation("SoASupersede")
  entries          SoAControlEntry[]
  riskPlans        RiskTreatmentPlan[]        @relation("SoARiskPlans")

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("statements_of_applicability")
}

model SoAControlEntry {
  id                   String                    @id @default(cuid())
  organizationId       String
  soaId                String
  controlId            String
  controlCode          String
  controlTitle         String
  controlDomain        SecurityControlDomain
  applicability        ControlApplicability      @default(UNDER_REVIEW)
  justification        String?
  implementationStatus OrganizationControlStatus @default(NOT_ASSESSED)
  relatedRiskItemId    String?
  evidenceId           String?
  responsibleId        String?
  reviewDate           DateTime?
  notes                String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  soa             StatementOfApplicability @relation(fields: [soaId], references: [id], onDelete: Cascade)
  control         SecurityControl          @relation(fields: [controlId], references: [id], onDelete: Restrict)
  relatedRiskItem RiskTreatmentItem?       @relation("SoAEntryRiskItem", fields: [relatedRiskItemId], references: [id], onDelete: SetNull)
  evidence        EvidenceFile?            @relation("SoAEntryEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  responsible     User?                    @relation("SoAEntryResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@unique([soaId, controlId])
  @@index([organizationId, soaId])
  @@index([organizationId, applicability])
  @@map("soa_control_entries")
}

// ─── RISK TREATMENT ──────────────────────────────────

model RiskAssessmentMethodology {
  id                  String    @id @default(cuid())
  organizationId      String
  version             Int
  title               String
  description         String?
  probabilityScale    Json
  impactScale         Json
  riskMatrix          Json
  acceptanceCriteria  String
  acceptanceThreshold Int?
  ownerId             String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?               @relation("RiskMethodologyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy   User?               @relation("RiskMethodologyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  plans        RiskTreatmentPlan[]

  @@unique([organizationId, version])
  @@map("risk_assessment_methodologies")
}

model RiskTreatmentPlan {
  id                 String                  @id @default(cuid())
  organizationId     String
  methodologyId      String?
  soaId              String?
  version            Int
  title              String
  status             RiskTreatmentPlanStatus @default(DRAFT)
  ownerId            String?
  approverId         String?
  approvalComment    String?
  approvalEvidenceId String?
  approvedAt         DateTime?
  nextReviewDate     DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  methodology      RiskAssessmentMethodology? @relation(fields: [methodologyId], references: [id], onDelete: SetNull)
  soa              StatementOfApplicability?  @relation("SoARiskPlans", fields: [soaId], references: [id], onDelete: SetNull)
  owner            User?                      @relation("RiskPlanOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approver         User?                      @relation("RiskPlanApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalEvidence EvidenceFile?              @relation("RiskPlanApprovalEvidence", fields: [approvalEvidenceId], references: [id], onDelete: SetNull)
  items            RiskTreatmentItem[]

  @@unique([organizationId, version])
  @@index([organizationId, status])
  @@map("risk_treatment_plans")
}

model RiskTreatmentItem {
  id                  String                  @id @default(cuid())
  organizationId      String
  planId              String
  reference           String
  title               String
  description         String?
  riskId              String?
  asset               String?
  threat              String?
  vulnerability       String?
  impact              Int
  probability         Int
  inherentRisk        Int
  existingControls    String?
  proposedControls    String?
  treatment           RiskTreatment           @default(MITIGATE)
  residualImpact      Int?
  residualProbability Int?
  residualRisk        Int?
  ownerId             String?
  targetDate          DateTime?
  status              RiskTreatmentItemStatus @default(OPEN)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                RiskTreatmentPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  risk                Risk?                    @relation("RiskTreatmentItemRisk", fields: [riskId], references: [id], onDelete: SetNull)
  owner               User?                    @relation("RiskItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  controls            RiskTreatmentControl[]
  residualAssessments ResidualRiskAssessment[]
  acceptances         RiskAcceptance[]
  soaEntries          SoAControlEntry[]        @relation("SoAEntryRiskItem")

  @@unique([planId, reference])
  @@index([organizationId, status])
  @@index([organizationId, planId])
  @@map("risk_treatment_items")
}

model RiskTreatmentControl {
  id                    String   @id @default(cuid())
  organizationId        String
  itemId                String
  organizationControlId String
  role                  String   @default("PROPOSED")
  createdAt             DateTime @default(now())

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item                RiskTreatmentItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)

  @@unique([itemId, organizationControlId])
  @@index([organizationId, itemId])
  @@map("risk_treatment_controls")
}

model ResidualRiskAssessment {
  id                  String   @id @default(cuid())
  organizationId      String
  itemId              String
  residualImpact      Int
  residualProbability Int
  residualRisk        Int
  rationale           String?
  assessedById        String
  assessedAt          DateTime @default(now())
  approved            Boolean  @default(false)
  createdAt           DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         RiskTreatmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assessedBy   User              @relation("ResidualRiskAssessor", fields: [assessedById], references: [id], onDelete: Restrict)
  acceptances  RiskAcceptance[]

  @@index([organizationId, itemId, assessedAt])
  @@map("residual_risk_assessments")
}

model RiskAcceptance {
  id                   String    @id @default(cuid())
  organizationId       String
  itemId               String
  residualAssessmentId String?
  justification        String
  acceptedById         String
  acceptedAt           DateTime  @default(now())
  comment              String?
  evidenceId           String?
  validUntil           DateTime?
  createdAt            DateTime  @default(now())

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item               RiskTreatmentItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  residualAssessment ResidualRiskAssessment? @relation(fields: [residualAssessmentId], references: [id], onDelete: SetNull)
  acceptedBy         User                    @relation("RiskAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)
  evidence           EvidenceFile?           @relation("RiskAcceptanceEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, itemId])
  @@map("risk_acceptances")
}

// ─── INFORMATION ASSET INVENTORY ─────────────────────

model InformationAsset {
  id             String           @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  category       AssetCategory
  ownerId        String?
  custodianId    String?
  processId      String?
  locationId     String?
  status         AssetStatus      @default(ACTIVE)
  criticality    AssetCriticality @default(MEDIUM)
  reviewDate     DateTime?
  nextReviewDate DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?                   @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  custodian          User?                   @relation("AssetCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  process            Process?                @relation(fields: [processId], references: [id], onDelete: SetNull)
  location           Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  classification     AssetClassification?
  dependencies       AssetDependency[]       @relation("AssetDependencySource")
  dependents         AssetDependency[]       @relation("AssetDependencyTarget")
  risks              AssetRisk[]
  controls           AssetControl[]
  incidentLinks      SecurityIncidentAsset[]
  vulnerabilityLinks VulnerabilityAsset[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([organizationId, status])
  @@index([organizationId, criticality])
  @@index([organizationId, nextReviewDate])
  @@map("information_assets")
}

model AssetClassification {
  id                String                    @id @default(cuid())
  organizationId    String
  assetId           String                    @unique
  confidentiality   CIARating                 @default(MEDIUM)
  integrity         CIARating                 @default(MEDIUM)
  availability      CIARating                 @default(MEDIUM)
  classification    InformationClassification @default(INTERNAL)
  legalRequirements String?
  retention         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, classification])
  @@map("asset_classifications")
}

model AssetDependency {
  id               String              @id @default(cuid())
  organizationId   String
  sourceAssetId    String
  dependentAssetId String
  type             AssetDependencyType @default(DEPENDS_ON)
  description      String?
  createdAt        DateTime            @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceAsset    InformationAsset @relation("AssetDependencySource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  dependentAsset InformationAsset @relation("AssetDependencyTarget", fields: [dependentAssetId], references: [id], onDelete: Cascade)

  @@unique([sourceAssetId, dependentAssetId])
  @@index([organizationId, sourceAssetId])
  @@map("asset_dependencies")
}

model AssetRisk {
  id             String   @id @default(cuid())
  organizationId String
  assetId        String
  riskId         String?
  threat         String?
  vulnerability  String?
  description    String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  risk         Risk?            @relation(fields: [riskId], references: [id], onDelete: SetNull)

  @@index([organizationId, assetId])
  @@map("asset_risks")
}

model AssetControl {
  id                    String                    @id @default(cuid())
  organizationId        String
  assetId               String
  organizationControlId String
  status                OrganizationControlStatus @default(NOT_ASSESSED)
  evidenceId            String?
  note                  String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset               InformationAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  organizationControl OrganizationControl @relation(fields: [organizationControlId], references: [id], onDelete: Cascade)
  evidence            EvidenceFile?       @relation("AssetControlEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@unique([assetId, organizationControlId])
  @@index([organizationId, assetId])
  @@map("asset_controls")
}

// ─── SECURITY INCIDENTS ──────────────────────────────

model SecurityIncident {
  id                   String           @id @default(cuid())
  organizationId       String
  code                 String
  detectedAt           DateTime
  occurredAt           DateTime?
  reporterId           String?
  responsibleId        String?
  severity             IncidentSeverity @default(MEDIUM)
  category             IncidentCategory @default(OTHER)
  description          String
  impact               String?
  status               IncidentStatus   @default(DETECTED)
  notificationRequired Boolean          @default(false)
  notificationDetails  String?
  lessonsLearned       String?
  closedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter       User?                      @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  responsible    User?                      @relation("IncidentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  affectedAssets SecurityIncidentAsset[]
  evidenceLinks  SecurityIncidentEvidence[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@map("security_incidents")
}

model SecurityIncidentAsset {
  id             String   @id @default(cuid())
  organizationId String
  incidentId     String
  assetId        String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  asset        InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([incidentId, assetId])
  @@index([organizationId, incidentId])
  @@map("security_incident_assets")
}

model SecurityIncidentEvidence {
  id             String   @id @default(cuid())
  organizationId String
  incidentId     String
  evidenceId     String
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([incidentId, evidenceId])
  @@index([organizationId, incidentId])
  @@map("security_incident_evidences")
}

// ─── VULNERABILITIES ─────────────────────────────────

model Vulnerability {
  id             String                @id @default(cuid())
  organizationId String
  code           String
  source         String
  cve            String?
  severity       VulnerabilitySeverity @default(MEDIUM)
  exposure       String?
  description    String?
  responsibleId  String?
  targetDate     DateTime?
  status         VulnerabilityStatus   @default(OPEN)
  discoveredAt   DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsible  User?                @relation("VulnerabilityResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  assets       VulnerabilityAsset[]
  remediations Remediation[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@map("vulnerabilities")
}

model VulnerabilityAsset {
  id              String   @id @default(cuid())
  organizationId  String
  vulnerabilityId String
  assetId         String
  exposure        String?
  createdAt       DateTime @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vulnerability Vulnerability    @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  asset         InformationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([vulnerabilityId, assetId])
  @@index([organizationId, vulnerabilityId])
  @@map("vulnerability_assets")
}

model Remediation {
  id              String            @id @default(cuid())
  organizationId  String
  vulnerabilityId String
  description     String
  responsibleId   String?
  targetDate      DateTime?
  status          RemediationStatus @default(PLANNED)
  evidenceId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vulnerability Vulnerability  @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  responsible   User?          @relation("RemediationResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  evidence      EvidenceFile?  @relation("RemediationEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  verifications Verification[]

  @@index([organizationId, vulnerabilityId])
  @@map("remediations")
}

model Verification {
  id             String             @id @default(cuid())
  organizationId String
  remediationId  String
  result         VerificationResult
  notes          String?
  verifiedById   String
  verifiedAt     DateTime           @default(now())
  evidenceId     String?
  createdAt      DateTime           @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediation  Remediation   @relation(fields: [remediationId], references: [id], onDelete: Cascade)
  verifiedBy   User          @relation("VerificationBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  evidence     EvidenceFile? @relation("VerificationEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, remediationId])
  @@map("verifications")
}

// ─── BUSINESS CONTINUITY ─────────────────────────────

model BusinessContinuityPlan {
  id             String               @id @default(cuid())
  organizationId String
  code           String
  title          String
  scope          String?
  ownerId        String?
  status         ContinuityPlanStatus @default(DRAFT)
  rtoMinutes     Int?
  rpoMinutes     Int?
  dependencies   String?
  reviewDate     DateTime?
  nextReviewDate DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // ─── Versionado, aprobación y activación (ISO 22301 §8.4) ───
  version             String    @default("1.0")
  approvedById        String?
  approvedAt          DateTime?
  /// Plan actualmente activado ante una interrupción real.
  activated           Boolean   @default(false)
  activatedAt         DateTime?
  activatedById       String?
  activationReason    String?
  deactivatedAt       DateTime?
  /// Nivel mínimo aceptable de continuidad del servicio (MBCO).
  minimumServiceLevel String?
  invocationCriteria  String?

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?                   @relation("BcpOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy         User?                   @relation("BcpApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  activatedBy        User?                   @relation("BcpActivator", fields: [activatedById], references: [id], onDelete: SetNull)
  criticalProcesses  BCPProcess[]
  drPlans            DisasterRecoveryPlan[]
  scenarios          ContinuityScenario[]
  tests              ContinuityTest[]
  versions           ContinuityPlanVersion[]
  activations        PlanActivation[]
  strategies         ContinuityStrategy[]
  recoveryProcedures RecoveryProcedure[]
  crisisTeams        CrisisTeam[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, activated])
  @@map("business_continuity_plans")
}

/// Histórico inmutable de versiones del plan (evidencia de control de cambios).
model ContinuityPlanVersion {
  id             String    @id @default(cuid())
  organizationId String
  planId         String
  version        String
  changeSummary  String?
  content        String?
  approvedById   String?
  approvedAt     DateTime?
  evidenceId     String?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  approvedBy   User?                  @relation("ContinuityVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  evidence     EvidenceFile?          @relation("ContinuityVersionEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@unique([planId, version])
  @@index([organizationId, planId])
  @@map("continuity_plan_versions")
}

/// Registro de cada activación real del plan (invocación y cierre).
model PlanActivation {
  id             String    @id @default(cuid())
  organizationId String
  planId         String
  reason         String
  scenarioId     String?
  incidentId     String? // reutiliza el módulo de incidentes
  activatedById  String?
  activatedAt    DateTime  @default(now())
  deactivatedAt  DateTime?
  outcome        String?
  lessonsLearned String?
  evidenceId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  scenario     ContinuityScenario?    @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  activatedBy  User?                  @relation("PlanActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  evidence     EvidenceFile?          @relation("PlanActivationEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, planId])
  @@index([organizationId, activatedAt])
  @@map("plan_activations")
}

model BCPProcess {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  processId      String
  rtoMinutes     Int?
  rpoMinutes     Int?
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  process      Process                @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([planId, processId])
  @@index([organizationId, planId])
  @@map("bcp_processes")
}

model DisasterRecoveryPlan {
  id             String               @id @default(cuid())
  organizationId String
  code           String
  title          String
  bcpId          String?
  ownerId        String?
  status         ContinuityPlanStatus @default(DRAFT)
  rtoMinutes     Int?
  rpoMinutes     Int?
  systems        String?
  dependencies   String?
  reviewDate     DateTime?
  nextReviewDate DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bcp          BusinessContinuityPlan? @relation(fields: [bcpId], references: [id], onDelete: SetNull)
  owner        User?                   @relation("DrpOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("disaster_recovery_plans")
}

model ContinuityScenario {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  title          String
  description    String?
  type           String?
  createdAt      DateTime @default(now())

  /// Caracterización del escenario para priorizar simulacros.
  likelihood        Int? // 1-5
  severity          Int? // 1-5
  riskId            String? // ← módulo de riesgos existente
  affectedResources String?
  assumptions       String?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tests        ContinuityTest[]
  activations  PlanActivation[]

  @@index([organizationId, planId])
  @@map("continuity_scenarios")
}

model ContinuityTest {
  id             String               @id @default(cuid())
  organizationId String
  planId         String
  scenarioId     String?
  title          String
  type           ContinuityTestType   @default(TABLETOP)
  status         ContinuityTestStatus @default(PLANNED)
  plannedDate    DateTime?
  executedDate   DateTime?
  responsibleId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  /// Diseño del simulacro (ISO 22301 §8.5): objetivo, alcance y metas.
  objective        String?
  scopeDescription String?
  participants     String?
  targetRtoMinutes Int?
  targetRpoMinutes Int?
  durationMinutes  Int?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  scenario     ContinuityScenario?    @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  responsible  User?                  @relation("ContinuityTestResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  results      TestResult[]

  @@index([organizationId, planId])
  @@index([organizationId, status])
  @@map("continuity_tests")
}

model TestResult {
  id                 String                @id @default(cuid())
  organizationId     String
  testId             String
  outcome            ContinuityTestOutcome
  rtoAchievedMinutes Int?
  rpoAchievedMinutes Int?
  summary            String?
  evidenceId         String?
  testedById         String
  testedAt           DateTime              @default(now())
  createdAt          DateTime              @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  test               ContinuityTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  evidence           EvidenceFile?       @relation("TestResultEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  testedBy           User                @relation("TestResultBy", fields: [testedById], references: [id], onDelete: Restrict)
  improvementActions ImprovementAction[]

  @@index([organizationId, testId])
  @@map("test_results")
}

model ImprovementAction {
  id             String                  @id @default(cuid())
  organizationId String
  testResultId   String
  description    String
  responsibleId  String?
  targetDate     DateTime?
  status         ImprovementActionStatus @default(OPEN)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testResult   TestResult   @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("ImprovementActionResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([organizationId, testResultId])
  @@map("improvement_actions")
}

// ─── CONTINUIDAD DEL NEGOCIO: BIA Y ESTRATEGIA (ISO 22301) ──
// Se apoya en los módulos existentes: Process, Risk, InformationAsset,
// Supplier, SecurityIncident, Document, EvidenceFile, Audit y Action.
// Las referencias a esos módulos son ids escalares validados por organización
// en las Server Actions (mismo patrón que ambiente/SST).

/// Análisis de Impacto en el Negocio: cabecera versionada y aprobable.
model BusinessImpactAnalysis {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  title          String
  scope          String?
  methodology    String? // criterios de impacto y escalas empleadas
  version        String    @default("1.0")
  status         BiaStatus @default(DRAFT)
  ownerId        String?
  approvedById   String?
  approvedAt     DateTime?
  performedAt    DateTime?
  nextReviewDate DateTime?
  evidenceId     String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?                    @relation("BiaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy   User?                    @relation("BiaApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  evidence     EvidenceFile?            @relation("BiaEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  activities   CriticalActivity[]
  priorities   ProductServicePriority[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("business_impact_analyses")
}

/// Actividad crítica evaluada en el BIA. Reutiliza `Process` del módulo existente.
model CriticalActivity {
  id                  String           @id @default(cuid())
  organizationId      String
  biaId               String
  code                String
  name                String
  description         String?
  processId           String? // ← módulo de procesos existente
  ownerId             String?
  /// Máximo Periodo Tolerable de Interrupción (minutos).
  mtpdMinutes         Int?
  /// Objetivo de Tiempo de Recuperación (minutos). Debe ser <= MTPD.
  rtoMinutes          Int?
  /// Objetivo de Punto de Recuperación (minutos de pérdida de datos tolerable).
  rpoMinutes          Int?
  /// Nivel mínimo aceptable de operación durante la interrupción (MBCO).
  minimumServiceLevel String?
  /// Impactos valorados 1-5 por categoría.
  financialImpact     Int              @default(0)
  operationalImpact   Int              @default(0)
  legalImpact         Int              @default(0)
  reputationalImpact  Int              @default(0)
  peopleImpact        Int              @default(0)
  /// Puntuación y nivel derivados (calculados en src/lib/continuity/bia.ts).
  impactScore         Int              @default(0)
  criticality         CriticalityLevel @default(LOW)
  priority            Int              @default(0)
  peakPeriods         String?
  notes               String?
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bia          BusinessImpactAnalysis @relation(fields: [biaId], references: [id], onDelete: Cascade)
  owner        User?                  @relation("CriticalActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dependencies BusinessDependency[]
  resources    ResourceRequirement[]
  strategies   ContinuityStrategy[]
  procedures   RecoveryProcedure[]

  @@unique([organizationId, code])
  @@index([organizationId, criticality])
  @@index([organizationId, biaId])
  @@map("critical_activities")
}

/// Priorización de productos y servicios (ISO 22301 §8.2.2).
model ProductServicePriority {
  id                  String           @id @default(cuid())
  organizationId      String
  biaId               String
  code                String
  name                String
  description         String?
  priority            Int              @default(0)
  criticality         CriticalityLevel @default(LOW)
  mtpdMinutes         Int?
  rtoMinutes          Int?
  minimumServiceLevel String?
  revenueShare        Float? // % de ingresos que representa
  customersAffected   Int?
  notes               String?
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bia          BusinessImpactAnalysis @relation(fields: [biaId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, priority])
  @@map("product_service_priorities")
}

/// Dependencia de una actividad crítica: personas, instalaciones, tecnología,
/// proveedores, datos… Reutiliza activos y proveedores existentes por id.
model BusinessDependency {
  id                   String           @id @default(cuid())
  organizationId       String
  activityId           String
  type                 DependencyType
  name                 String
  description          String?
  /// Referencias opcionales a módulos existentes (validadas por organización).
  processId            String?
  assetId              String? // ← inventario de activos de información
  supplierId           String? // ← módulo de proveedores
  personnelId          String?
  locationId           String?
  /// Criticidad e indisponibilidad tolerable de la dependencia.
  criticality          CriticalityLevel @default(MEDIUM)
  maxOutageMinutes     Int?
  /// Recurso alterno previsto si la dependencia falla.
  alternative          String?
  singlePointOfFailure Boolean          @default(false)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity     CriticalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([organizationId, activityId])
  @@index([organizationId, type])
  @@map("business_dependencies")
}

/// Recursos mínimos necesarios para reanudar la actividad en el nivel acordado.
model ResourceRequirement {
  id                  String       @id @default(cuid())
  organizationId      String
  activityId          String
  type                ResourceType
  name                String
  description         String?
  /// Cantidad normal vs cantidad mínima para el nivel mínimo aceptable.
  normalQuantity      Int?
  minimumQuantity     Int?
  unit                String?
  availableAt         String? // ubicación / sistema donde está disponible
  /// Recurso alterno y plazo para disponer de él.
  alternativeResource String?
  leadTimeMinutes     Int?
  supplierId          String?
  assetId             String?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity     CriticalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([organizationId, activityId])
  @@index([organizationId, type])
  @@map("resource_requirements")
}

/// Estrategia de continuidad seleccionada para una actividad (§8.3).
model ContinuityStrategy {
  id                 String         @id @default(cuid())
  organizationId     String
  code               String
  activityId         String?
  planId             String?
  title              String
  type               StrategyType   @default(MITIGATE)
  description        String?
  /// Capacidad que aporta y plazo en que la aporta.
  achievesRtoMinutes Int?
  achievesRpoMinutes Int?
  cost               Float?
  status             StrategyStatus @default(PROPOSED)
  ownerId            String?
  approvedById       String?
  approvedAt         DateTime?
  resourcesNeeded    String?
  notes              String?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity     CriticalActivity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  plan         BusinessContinuityPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  owner        User?                   @relation("StrategyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy   User?                   @relation("StrategyApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("continuity_strategies")
}

/// Procedimiento de recuperación paso a paso (parte ejecutable del plan).
model RecoveryProcedure {
  id               String    @id @default(cuid())
  organizationId   String
  code             String
  planId           String?
  activityId       String?
  title            String
  objective        String?
  /// Pasos ordenados en texto propio; el documento formal vive en Documentos.
  steps            String?
  documentId       String? // ← módulo de documentos existente
  responsibleId    String?
  estimatedMinutes Int?
  prerequisites    String?
  order            Int       @default(0)
  version          String    @default("1.0")
  lastTestedAt     DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  activity     CriticalActivity?       @relation(fields: [activityId], references: [id], onDelete: SetNull)
  responsible  User?                   @relation("RecoveryProcedureResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, planId])
  @@map("recovery_procedures")
}

/// Equipo de crisis y sus miembros/contactos.
model CrisisTeam {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  purpose        String?
  planId         String?
  leaderId       String?
  deputyId       String?
  activationRule String? // cuándo se convoca
  meetingPoint   String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BusinessContinuityPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  leader       User?                   @relation("CrisisTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  deputy       User?                   @relation("CrisisTeamDeputy", fields: [deputyId], references: [id], onDelete: SetNull)
  contacts     CrisisContact[]
  trees        CommunicationTree[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("crisis_teams")
}

/// Contacto del equipo de crisis (interno o externo: autoridades, proveedores…).
model CrisisContact {
  id              String      @id @default(cuid())
  organizationId  String
  teamId          String
  name            String
  role            String?
  type            ContactType @default(INTERNAL)
  userId          String?
  personnelId     String?
  supplierId      String?
  primaryPhone    String?
  altPhone        String?
  email           String?
  /// Orden de escalado dentro del árbol de llamadas.
  escalationOrder Int         @default(0)
  isDeputy        Boolean     @default(false)
  availability    String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         CrisisTeam          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?               @relation("CrisisContactUser", fields: [userId], references: [id], onDelete: SetNull)
  treeNodes    CommunicationTree[]

  @@index([organizationId, teamId])
  @@map("crisis_contacts")
}

/// Árbol de comunicación / cascada de llamadas (nodo autorreferenciado).
model CommunicationTree {
  id              String   @id @default(cuid())
  organizationId  String
  teamId          String
  contactId       String?
  parentId        String?
  label           String
  audience        String? // a quién comunica este nodo
  channel         String? // teléfono, SMS, correo, megafonía…
  messageTemplate String?
  order           Int      @default(0)
  maxDelayMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         CrisisTeam          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contact      CrisisContact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  parent       CommunicationTree?  @relation("CommTreeParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     CommunicationTree[] @relation("CommTreeParent")

  @@index([organizationId, teamId])
  @@index([parentId])
  @@map("communication_trees")
}

// ─── SECURITY SUPPLIER PROFILE ───────────────────────

model SupplierSecurityProfile {
  id                  String              @id @default(cuid())
  organizationId      String
  supplierId          String              @unique
  securityCriticality SupplierCriticality @default(MEDIUM)
  dataProcessed       String?
  accessGranted       String?
  obligations         String?
  controls            String?
  riskLevel           String?
  reviewDate          DateTime?
  nextReviewDate      DateTime?
  contractExpiry      DateTime?
  evidenceId          String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evidence     EvidenceFile? @relation("SupplierSecurityEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([organizationId, securityCriticality])
  @@index([organizationId, contractExpiry])
  @@map("supplier_security_profiles")
}

// ─── ISO 14001:2015 ENVIRONMENTAL MANAGEMENT ─────────
// Specialized models for the environmental (Medio ambiente) standard pack.
// Person / process / entity references are stored as scalar ids and validated
// org-scoped in the server actions (same tenant guard as the coverage fabric);
// cross-standard requirement satisfaction flows through RequirementCoverage.

model EnvironmentalAspect {
  id             String                 @id @default(cuid())
  organizationId String
  code           String
  activity       String // actividad
  productService String? // producto o servicio
  condition      EnvironmentalCondition @default(NORMAL) // normal | anormal | emergencia
  lifeCycleStage String? // perspectiva de ciclo de vida
  responsibleId  String? // responsable (user id)
  processId      String? // proceso
  description    String?
  active         Boolean                @default(true)
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  impacts      EnvironmentalImpact[]

  @@unique([organizationId, code])
  @@index([organizationId, condition])
  @@index([organizationId, processId])
  @@map("environmental_aspects")
}

model EnvironmentalImpact {
  id                   String                    @id @default(cuid())
  organizationId       String
  aspectId             String
  methodId             String? // significance method applied
  impactType           String // tipo de impacto
  description          String?
  severity             Int                       @default(1) // severidad
  frequency            Int                       @default(1) // frecuencia
  scope                Int                       @default(1) // alcance
  existingControl      String? // control existente
  controlEffectiveness Int? // 0..100 mitigation applied by the existing control
  score                Float? // computed significance value
  level                EnvironmentalSignificance @default(LOW) // nivel
  significant          Boolean                   @default(false) // significativo
  riskId               String? // relación con riesgo
  controlId            String? // relación con control
  createdById          String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aspect       EnvironmentalAspect @relation(fields: [aspectId], references: [id], onDelete: Cascade)

  @@index([organizationId, significant])
  @@index([aspectId])
  @@map("environmental_impacts")
}

model EnvironmentalSignificanceMethod {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  criteria       Json? // criterios (factor definitions / scales)
  weights        Json? // ponderaciones (factor -> weight)
  formula        String    @default("WEIGHTED_SUM") // fórmula: WEIGHTED_SUM | PRODUCT | SUM
  threshold      Float     @default(0) // umbral de significancia
  version        String    @default("1") // versión (methodology history)
  active         Boolean   @default(true)
  approvedById   String? // aprobación
  approvedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, version])
  @@index([organizationId, active])
  @@map("environmental_significance_methods")
}

model EnvironmentalComplianceObligation {
  id                    String    @id @default(cuid())
  organizationId        String
  code                  String
  source                String // fuente (ley / reglamento / permiso)
  jurisdiction          String? // jurisdicción
  obligation            String // obligación (texto propio)
  applicability         String? // aplicabilidad
  responsibleId         String? // responsable
  reviewDate            DateTime? // fecha de revisión (próxima)
  reviewFrequencyMonths Int?
  evidenceId            String? // evidencia
  documentId            String?
  active                Boolean   @default(true)
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evaluations  EnvironmentalComplianceEvaluation[]

  @@unique([organizationId, code])
  @@index([organizationId, reviewDate])
  @@map("environmental_compliance_obligations")
}

model EnvironmentalComplianceEvaluation {
  id              String                        @id @default(cuid())
  organizationId  String
  obligationId    String
  evaluatedAt     DateTime                      @default(now()) // fecha
  result          EnvironmentalComplianceResult @default(NOT_EVALUATED) // resultado
  evaluatorId     String? // evaluador
  evidenceId      String? // evidencia
  findings        String?
  derivedActionId String? // acción derivada (Action / CAPA)
  createdById     String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  organization Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation   EnvironmentalComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([organizationId, obligationId, evaluatedAt])
  @@map("environmental_compliance_evaluations")
}

model EnvironmentalObjective {
  id             String                       @id @default(cuid())
  organizationId String
  code           String
  objective      String // objetivo
  baseline       String? // línea base
  target         String? // meta
  indicatorId    String? // indicador
  responsibleId  String? // responsable
  resources      String? // recursos
  dueDate        DateTime? // fecha
  status         EnvironmentalObjectiveStatus @default(PLANNED) // estado
  progress       Int                          @default(0)
  createdById    String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs     EnvironmentalProgram[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("environmental_objectives")
}

model EnvironmentalProgram {
  id             String                     @id @default(cuid())
  organizationId String
  objectiveId    String?
  name           String
  activities     String? // actividades
  responsibleId  String? // responsables
  budget         Float? // presupuesto
  progress       Int                        @default(0) // avance
  status         EnvironmentalProgramStatus @default(NOT_STARTED)
  startDate      DateTime?
  dueDate        DateTime?
  evidenceId     String? // evidencias
  createdById    String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objective    EnvironmentalObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([objectiveId])
  @@map("environmental_programs")
}

model EnvironmentalMetric {
  id             String    @id @default(cuid())
  organizationId String
  period         String // p. ej. 2026-07
  periodStart    DateTime?
  processId      String?
  locationId     String?
  water          Float? // agua
  energy         Float? // energía
  fuel           Float? // combustible
  emissions      Float? // emisiones (CO2e)
  discharges     Float? // vertidos
  waste          Float? // residuos
  rawMaterials   Float? // materias primas
  unitNote       String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, period])
  @@index([organizationId, processId])
  @@map("environmental_metrics")
}

model WasteStream {
  id             String              @id @default(cuid())
  organizationId String
  code           String
  wasteType      String // tipo
  classification WasteClassification @default(NON_HAZARDOUS) // clasificación
  quantity       Float? // cantidad
  unit           String? // unidad
  period         String?
  storage        String? // almacenamiento
  managerName    String? // gestor
  disposition    String? // disposición
  manifest       String? // manifiesto
  processId      String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, classification])
  @@map("waste_streams")
}

model EnvironmentalEmergencyScenario {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  scenario       String // escenario
  impact         String? // impacto
  controls       String? // controles
  responsePlan   String? // plan
  responsibleId  String? // responsables
  lastDrillAt    DateTime? // simulacros (último)
  nextDrillAt    DateTime?
  drillResults   String? // resultados
  documentId     String?
  active         Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("environmental_emergency_scenarios")
}

/// Biodiversidad — configurable: cada organización define su propio sitio,
/// tipo de ecosistema y cadencia de monitoreo en vez de un checklist fijo.
enum BiodiversityImpactStatus {
  IDENTIFIED
  MONITORING
  MITIGATED
  CLOSED
}

model EnvironmentalBiodiversityRecord {
  id                  String                   @id @default(cuid())
  organizationId      String
  code                String
  site                String // ubicación / sede
  ecosystemType       String? // tipo de ecosistema
  protectedArea       Boolean                  @default(false)
  protectedAreaName   String?
  speciesOrHabitat    String? // especie/hábitat afectado
  impactDescription   String?
  mitigationMeasures  String?
  monitoringFrequency String? // configurable: "trimestral", "anual"…
  status              BiodiversityImpactStatus @default(IDENTIFIED)
  responsibleId       String?
  processId           String?
  evidenceId          String?
  lastMonitoredAt     DateTime?
  nextMonitoringAt    DateTime?
  createdById         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process      Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("environmental_biodiversity_records")
}

// ─── ISO 45001:2018 OCCUPATIONAL HEALTH & SAFETY ─────
// Reuses the existing risk / audit / CAPA / evidence / document / training /
// supplier / management-review modules via scalar id references validated
// org-scoped in the server actions. Gated on the `safety` permission module.

model OccupationalHazard {
  id               String                     @id @default(cuid())
  organizationId   String
  code             String
  processId        String? // proceso
  activity         String // actividad
  task             String? // tarea
  hazard           String // peligro
  category         OccupationalHazardCategory @default(OTHER) // categoría
  exposedWorkers   Int? // trabajadores expuestos
  existingControls String? // controles existentes
  responsibleId    String?
  active           Boolean                    @default(true)
  createdById      String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessments  OccupationalRiskAssessment[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([organizationId, processId])
  @@map("occupational_hazards")
}

