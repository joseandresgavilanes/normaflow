  lotNumbers     String[]    @default([])
  capaId         String?
  documentId     String?
  evidenceId     String?
  createdById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       MedicalDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, deviceId])
  @@map("md_field_safety_actions")
}

/// Retiro / recall de dispositivo médico (distinto de WithdrawalRecall alimentario).
model ProductRecall {
  id                String         @id @default(cuid())
  organizationId    String
  code              String
  deviceId          String?
  title             String
  reason            String
  lotNumbers        String[]       @default([])
  status            MdRecallStatus @default(DRAFT)
  initiatedAt       DateTime       @default(now())
  notifiedAt        DateTime?
  closedAt          DateTime?
  authorityNotified Boolean        @default(false)
  capaId            String?
  documentId        String?
  evidenceId        String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       MedicalDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, deviceId])
  @@map("md_product_recalls")
}

/// Requisitos regulatorios configurables por jurisdicción/marco.
model RegulatoryRequirement {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  jurisdiction   String
  /// Marco configurable: ISO_13485, MDR, FDA_QSR, MDSAP, LOCAL, OTHER…
  framework      String
  clauseRef      String?
  title          String
  description    String?
  mandatory      Boolean  @default(true)
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, framework])
  @@index([organizationId, jurisdiction])
  @@index([organizationId, active])
  @@map("md_regulatory_requirements")
}

model RegulatorySubmission {
  id              String             @id @default(cuid())
  organizationId  String
  code            String
  deviceId        String?
  jurisdiction    String
  submissionType  String
  status          MdSubmissionStatus @default(DRAFT)
  submittedAt     DateTime?
  referenceNumber String?
  summary         String?
  documentId      String?
  evidenceId      String?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       MedicalDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, deviceId])
  @@map("md_regulatory_submissions")
}

/// Retención configurable para expedientes de vigilancia (queja, evento
/// adverso) — una fila por organización. La retención regulatoria real
/// (p. ej. vida del dispositivo + N años bajo MDR/QSR) depende de la
/// jurisdicción del fabricante; aquí es un parámetro, no un valor fijo.
model MdRetentionPolicy {
  id             String   @id @default(cuid())
  organizationId String   @unique
  retentionYears Int      @default(15)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("md_retention_policies")
}

// ─── SISTEMA INTEGRADO DE GESTIÓN (SIG) ──────────────
// Capa de integración sobre el Standard Pack Engine. La NO duplicación de
// documentos, evidencias, riesgos, auditorías y CAPA se resuelve con
// `RequirementCoverage` (un elemento satisface requisitos de varias normas)
// y con los campos `standards[]` / `disciplines[]` de los modelos existentes.
// Aquí solo viven los conceptos que aún no existían en la aplicación.

/// Alcance y política integrados del sistema (uno por organización).
model IntegratedSystem {
  id                 String    @id @default(cuid())
  organizationId     String    @unique
  name               String    @default("Sistema Integrado de Gestión")
  scope              String? // alcance integrado
  scopeExclusions    String?
  policy             String? // política integrada (texto propio del cliente)
  policyVersion      String    @default("1.0")
  policyApprovedAt   DateTime?
  policyApprovedById String?
  boundaries         String? // límites físicos / organizacionales
  contextNotes       String? // cuestiones internas y externas (4.1 común)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policyApprovedBy User?                      @relation("IntegratedPolicyApprover", fields: [policyApprovedById], references: [id], onDelete: SetNull)
  standards        IntegratedSystemStandard[]

  @@map("integrated_systems")
}

/// Norma incluida en el alcance del SIG, con su nota de alcance específica.
model IntegratedSystemStandard {
  id                 String     @id @default(cuid())
  organizationId     String
  integratedSystemId String
  standardCode       String // ISO_9001, ISO_14001, ISO_45001…
  discipline         Discipline
  scopeNote          String?
  exclusions         String?
  responsibleId      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integratedSystem IntegratedSystem @relation(fields: [integratedSystemId], references: [id], onDelete: Cascade)
  responsible      User?            @relation("IntegratedStandardResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@unique([integratedSystemId, standardCode])
  @@index([organizationId])
  @@map("integrated_system_standards")
}

/// Partes interesadas comunes (ISO 9001/14001/45001 §4.2) — una sola lista.
model InterestedParty {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String? // cliente, trabajador, autoridad, comunidad, proveedor…
  needs          String? // necesidades y expectativas
  requirements   String? // requisitos aplicables
  influence      Int          @default(3) // 1-5
  dependency     Int          @default(3) // 1-5
  isRelevant     Boolean      @default(true)
  communication  String?
  /// Disciplinas/normas para las que esta parte interesada es pertinente.
  disciplines    Discipline[] @default([])
  standards      String[]     @default([])
  responsibleId  String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("InterestedPartyResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, isRelevant])
  @@map("interested_parties")
}

/// Objetivos del sistema: por disciplina o compartidos entre varias normas.
model IntegratedObjective {
  id             String                    @id @default(cuid())
  organizationId String
  code           String
  title          String
  description    String?
  /// Vacío/múltiple = objetivo compartido entre disciplinas.
  disciplines    Discipline[]              @default([])
  standards      String[]                  @default([])
  target         String? // meta expresada
  baseline       String?
  unit           String?
  targetValue    Float?
  currentValue   Float?
  dueDate        DateTime?
  status         IntegratedObjectiveStatus @default(PLANNED)
  ownerId        String?
  processId      String?
  indicatorId    String? // reutiliza el módulo de indicadores existente
  resources      String?
  createdById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("IntegratedObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("integrated_objectives")
}

/// Responsable (y notas) de un requisito concreto dentro de la organización.
/// Completa el crosswalk: documento/evidencia compartidos salen de
/// `RequirementCoverage`; el responsable vive aquí.
model RequirementAssignment {
  id             String   @id @default(cuid())
  organizationId String
  requirementId  String
  responsibleId  String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirement  StandardRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  responsible  User?               @relation("RequirementResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, requirementId])
  @@index([organizationId])
  @@map("requirement_assignments")
}

