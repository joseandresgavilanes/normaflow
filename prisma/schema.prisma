// ─── ISO/IEC 42001:2023 AI MANAGEMENT SYSTEM (AIMS) ──
// Specialized models for the AI management standard pack. Person / process /
// entity references are stored as scalar ids and validated org-scoped in the
// server actions; cross-standard requirement satisfaction flows through
// RequirementCoverage. Gated on the `aims` permission module.
//
// HUMAN RULE (non-negotiable): an AI output is never an official record. Every
// AI-produced artifact lands in `AIGeneratedOutput` as DRAFT, moves to
// HUMAN_REVIEW and only becomes promotable once a human sets APPROVED. The
// promotion columns are additionally guarded by DB CHECK constraints.

/// Inventario de sistemas de IA (ISO/IEC 42001 §4.1, §6.1, Anexo A.6).
model AISystem {
  id               String               @id @default(cuid())
  organizationId   String
  code             String
  name             String // nombre
  ownerId          String? // propietario (user id)
  provider         String? // proveedor (interno / tercero)
  providerType     AIProviderType       @default(INTERNAL)
  supplierId       String? // proveedor registrado (módulo proveedores)
  purpose          String // propósito
  users            String? // usuarios (quién lo usa)
  affectedGroups   String? // colectivos afectados
  context          String? // contexto de uso y límites
  criticality      AISystemCriticality  @default(MEDIUM) // criticidad
  classification   AIRiskClassification @default(NOT_CLASSIFIED) // clasificación de riesgo
  autonomy         AIAutonomyLevel      @default(HUMAN_IN_THE_LOOP)
  status           AISystemStatus       @default(PLANNED) // estado
  processId        String?
  documentId       String?
  approvedById     String? // aprobación para producción
  approvedAt       DateTime?
  deployedAt       DateTime?
  /// Retiro de sistema (§A.6.2.7) — motivo y disposición de datos/modelos.
  retiredAt        DateTime?
  retirementReason String?
  retirementPlan   String?
  nextReviewDate   DateTime?
  active           Boolean              @default(true)
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  useCases          AIUseCase[]
  impactAssessments AIImpactAssessment[]
  risks             AIRisk[]
  modelVersions     ModelVersion[]
  oversightControls HumanOversightControl[]
  transparency      AITransparencyRecord[]
  incidents         AIIncident[]
  changeRequests    AIChangeRequest[]
  metrics           AIPerformanceMetric[]
  generatedOutputs  AIGeneratedOutput[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, criticality])
  @@index([organizationId, classification])
  @@map("ai_systems")
}

/// Caso de uso de un sistema de IA: objetivo, decisiones y restricciones.
model AIUseCase {
  id                 String          @id @default(cuid())
  organizationId     String
  systemId           String
  code               String
  title              String
  objective          String // objetivo
  supportedDecisions String? // decisiones apoyadas
  decisionAutonomy   AIAutonomyLevel @default(HUMAN_IN_THE_LOOP)
  affectedPeople     String? // personas afectadas
  affectedCount      Int?
  impact             String? // impacto esperado
  constraints        String? // restricciones (uso prohibido, límites)
  prohibitedUses     String?
  processId          String?
  active             Boolean         @default(true)
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, systemId])
  @@map("ai_use_cases")
}

/// Evaluación de impacto de la IA sobre las personas (§6.1.4, §A.5.2).
/// Cada dimensión se valora por separado y la aprobación es siempre humana.
model AIImpactAssessment {
  id                   String               @id @default(cuid())
  organizationId       String
  systemId             String
  useCaseId            String?
  code                 String
  version              String               @default("1")
  methodology          String?
  /// Dimensiones evaluadas (§A.5.2): derechos, seguridad, privacidad, sesgo,
  /// transparencia, explicabilidad y supervisión humana.
  rightsImpact         AIImpactSeverity     @default(NOT_ASSESSED) // derechos
  rightsNote           String?
  safetyImpact         AIImpactSeverity     @default(NOT_ASSESSED) // seguridad
  safetyNote           String?
  privacyImpact        AIImpactSeverity     @default(NOT_ASSESSED) // privacidad
  privacyNote          String?
  biasImpact           AIImpactSeverity     @default(NOT_ASSESSED) // sesgo
  biasNote             String?
  transparencyImpact   AIImpactSeverity     @default(NOT_ASSESSED) // transparencia
  transparencyNote     String?
  explainabilityImpact AIImpactSeverity     @default(NOT_ASSESSED) // explicabilidad
  explainabilityNote   String?
  oversightImpact      AIImpactSeverity     @default(NOT_ASSESSED) // supervisión humana
  oversightNote        String?
  /// Resultado agregado calculado por `src/lib/aims/classification.ts`.
  overallScore         Float?
  overallSeverity      AIImpactSeverity     @default(NOT_ASSESSED)
  classification       AIRiskClassification @default(NOT_CLASSIFIED)
  safeguards           String? // salvaguardas requeridas
  residualImpact       String?
  assessorId           String?
  assessedAt           DateTime?
  /// Regla humana: DRAFT → HUMAN_REVIEW → APPROVED | REJECTED.
  reviewStatus         AIHumanReviewStatus  @default(DRAFT)
  submittedAt          DateTime?
  reviewerId           String?
  reviewedAt           DateTime?
  decisionNote         String?
  evidenceId           String?
  documentId           String?
  nextReviewDate       DateTime?
  createdById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code, version])
  @@index([organizationId, systemId])
  @@index([organizationId, reviewStatus])
  @@map("ai_impact_assessments")
}

/// Riesgo específico de IA, valorado y tratado (§6.1.2, §6.1.3).
model AIRisk {
  id                   String              @id @default(cuid())
  organizationId       String
  systemId             String?
  code                 String
  title                String
  category             AIRiskCategory      @default(OTHER)
  source               String? // fuente del riesgo (datos, modelo, uso, proveedor…)
  description          String?
  affectedParties      String?
  likelihood           Int                 @default(1) // 1..5
  impact               Int                 @default(1) // 1..5
  inherentScore        Float?
  inherentLevel        AIRiskLevel         @default(LOW)
  existingControls     String?
  controlEffectiveness Int? // 0..100
  residualScore        Float?
  residualLevel        AIRiskLevel         @default(LOW)
  acceptability        AIRiskAcceptability @default(ACCEPTABLE)
  treatment            AIRiskTreatment     @default(MITIGATE)
  treatmentPlan        String?
  ownerId              String?
  dueDate              DateTime?
  /// Puentes con los módulos existentes (no se duplica el riesgo corporativo).
  riskId               String? // Risk
  controlId            String? // OrganizationControl
  capaId               String?
  evidenceId           String?
  status               AIRiskStatus        @default(OPEN)
  acceptedById         String?
  acceptedAt           DateTime?
  acceptanceRationale  String?
  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem?    @relation(fields: [systemId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, residualLevel])
  @@index([organizationId, category])
  @@index([organizationId, systemId])
  @@map("ai_risks")
}

/// Conjunto de datos usado para entrenar, validar o evaluar un modelo (§A.7).
model Dataset {
  id                        String                @id @default(cuid())
  organizationId            String
  code                      String
  name                      String
  purpose                   String? // propósito del dato
  ownerId                   String? // propietario del dato
  stewardId                 String? // custodio
  classification            DatasetClassification @default(INTERNAL)
  /// Privacidad: se registra la naturaleza del dato, nunca el dato personal.
  containsPersonalData      Boolean               @default(false)
  personalDataCategories    String?
  containsSpecialCategories Boolean               @default(false)
  legalBasis                DataLegalBasis        @default(NOT_APPLICABLE)
  anonymization             String?
  recordCount               Int?
  featureCount              Int?
  periodCovered             String?
  /// Calidad de datos (0..100) — §A.7.4.
  completeness              Int?
  accuracy                  Int?
  consistency               Int?
  timeliness                Int?
  representativeness        Int?
  qualityScore              Float?
  qualityLevel              DataQualityLevel      @default(NOT_ASSESSED)
  /// Sesgo (§A.7.4, §A.9.3) — poblaciones representadas y sesgos detectados.
  biasReviewed              Boolean               @default(false)
  biasFindings              String?
  underrepresentedGroups    String?
  retentionMonths           Int?
  storageLocation           String?
  documentId                String?
  evidenceId                String?
  active                    Boolean               @default(true)
  createdById               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources       DataSource[]
  lineage       DataLineage[]
  evaluations   ModelEvaluation[]
  trainedModels ModelVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, classification])
  @@index([organizationId, containsPersonalData])
  @@map("datasets")
}

/// Origen de un dataset: procedencia, licencia y base legal (§A.7.2, §A.7.3).
model DataSource {
  id              String         @id @default(cuid())
  organizationId  String
  datasetId       String
  code            String
  name            String
  type            DataSourceType @default(OTHER)
  origin          String? // procedencia (sistema, URL, proveedor)
  provider        String?
  supplierId      String?
  license         String? // licencia / condiciones de uso
  licenseVerified Boolean        @default(false)
  legalBasis      DataLegalBasis @default(NOT_APPLICABLE)
  consentEvidence String?
  collectedFrom   DateTime?
  collectedTo     DateTime?
  restrictions    String?
  evidenceId      String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, datasetId])
  @@index([organizationId, type])
  @@map("data_sources")
}

/// Procedencia de datos: cada transformación aplicada, en orden (§A.7.2).
model DataLineage {
  id             String               @id @default(cuid())
  organizationId String
  datasetId      String
  step           Int                  @default(1)
  operation      DataLineageOperation @default(INGESTION)
  description    String?
  inputRef       String? // dataset / fuente de entrada
  outputRef      String? // artefacto resultante
  tool           String?
  performedById  String?
  performedAt    DateTime             @default(now())
  reversible     Boolean              @default(false)
  evidenceId     String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, datasetId, step])
  @@index([organizationId, datasetId])
  @@map("data_lineage")
}

/// Versión de un modelo. Solo pasa a producción con aprobación humana (§A.6.2).
model ModelVersion {
  id                   String              @id @default(cuid())
  organizationId       String
  systemId             String
  code                 String
  modelName            String
  version              String
  algorithm            String?
  framework            String?
  baseModel            String? // modelo base / preentrenado
  provider             String?
  trainingDatasetId    String?
  trainingSummary      String?
  hyperparameters      Json?
  /// Explicabilidad (§A.9.3): técnica y alcance de la explicación disponible.
  explainabilityMethod String?
  explainabilityNote   String?
  limitations          String?
  intendedUse          String?
  stage                ModelVersionStage   @default(DEVELOPMENT)
  /// Regla humana: DRAFT → HUMAN_REVIEW → APPROVED | REJECTED antes de desplegar.
  reviewStatus         AIHumanReviewStatus @default(DRAFT)
  submittedAt          DateTime?
  reviewerId           String?
  reviewedAt           DateTime?
  decisionNote         String?
  deployedAt           DateTime?
  retiredAt            DateTime?
  documentId           String?
  evidenceId           String?
  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system           AISystem              @relation(fields: [systemId], references: [id], onDelete: Cascade)
  trainingDataset  Dataset?              @relation(fields: [trainingDatasetId], references: [id], onDelete: SetNull)
  evaluations      ModelEvaluation[]
  changeRequests   AIChangeRequest[]
  metrics          AIPerformanceMetric[]
  generatedOutputs AIGeneratedOutput[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemId, modelName, version])
  @@index([organizationId, stage])
  @@index([organizationId, reviewStatus])
  @@map("model_versions")
}

/// Evaluación de un modelo: desempeño, sesgo, robustez y explicabilidad (§A.6.2.4).
model ModelEvaluation {
  id                     String                 @id @default(cuid())
  organizationId         String
  modelVersionId         String
  datasetId              String? // dataset de evaluación
  code                   String
  evaluatedAt            DateTime               @default(now())
  evaluatorId            String?
  accuracy               Float?
  precision              Float?
  recall                 Float?
  f1Score                Float?
  aucRoc                 Float?
  errorRate              Float?
  /// Sesgo y equidad: métrica, grupos comparados y disparidad observada.
  fairnessMetric         String?
  fairnessScore          Float?
  biasDetected           Boolean                @default(false)
  biasGroups             String?
  disparityRatio         Float?
  robustness             String?
  adversarialTested      Boolean                @default(false)
  explainabilityAssessed Boolean                @default(false)
  explainabilityNote     String?
  thresholds             Json?
  outcome                ModelEvaluationOutcome @default(NOT_EVALUATED)
  findings               String?
  conditions             String?
  capaId                 String?
  evidenceId             String?
  createdById            String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modelVersion ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  dataset      Dataset?     @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, modelVersionId])
  @@index([organizationId, outcome])
  @@map("model_evaluations")
}

/// Control de supervisión humana sobre un sistema de IA (§A.9.2).
model HumanOversightControl {
  id               String             @id @default(cuid())
  organizationId   String
  systemId         String
  code             String
  name             String
  type             HumanOversightType @default(HUMAN_IN_THE_LOOP)
  description      String?
  responsibleId    String? // quién supervisa
  competence       String? // competencia requerida
  trainingCourseId String?
  /// Capacidad real de intervención: parar, revertir, anular la decisión.
  canOverride      Boolean            @default(true)
  canStop          Boolean            @default(true)
  escalationPath   String?
  frequency        String?
  effectiveness    Int? // 0..100
  lastVerifiedAt   DateTime?
  nextReviewDate   DateTime?
  controlId        String? // OrganizationControl
  evidenceId       String?
  documentId       String?
  active           Boolean            @default(true)
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, systemId])
  @@index([organizationId, type])
  @@map("human_oversight_controls")
}

/// Registro de transparencia: qué se informa, a quién y por qué canal (§A.8).
model AITransparencyRecord {
  id                   String                 @id @default(cuid())
  organizationId       String
  systemId             String
  code                 String
  audience             AITransparencyAudience @default(END_USER)
  disclosure           String // información proporcionada
  aiUseDisclosed       Boolean                @default(true) // se informa que hay IA
  limitationsDisclosed Boolean                @default(false)
  dataUseDisclosed     Boolean                @default(false)
  humanContactOffered  Boolean                @default(false)
  channel              String? // canal (web, contrato, interfaz, aviso legal)
  language             String?
  publishedAt          DateTime?
  version              String                 @default("1")
  responsibleId        String?
  documentId           String?
  evidenceId           String?
  nextReviewDate       DateTime?
  createdById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, systemId])
  @@index([organizationId, audience])
  @@map("ai_transparency_records")
}

/// Incidente de IA con flujo de investigación estrictamente lineal (§A.10.4).
model AIIncident {
  id                   String           @id @default(cuid())
  organizationId       String
  systemId             String?
  modelVersionId       String?
  code                 String
  type                 AIIncidentType   @default(OTHER)
  severity             IncidentSeverity @default(MEDIUM)
  title                String
  description          String?
  detectedAt           DateTime         @default(now())
  occurredAt           DateTime?
  detectedBy           String?
  reporterId           String?
  affectedParties      String?
  affectedCount        Int?
  harmDescription      String?
  /// Investigación y causa raíz.
  investigation        String?
  rootCause            String?
  rootCauseMethod      String?
  containment          String?
  correctiveActions    String?
  /// Notificación a autoridades / afectados (privacidad y AI Act).
  notificationRequired Boolean          @default(false)
  notificationDetails  String?
  notifiedAt           DateTime?
  status               AIIncidentStatus @default(REPORTED)
  responsibleId        String?
  dueDate              DateTime?
  closedAt             DateTime?
  lessonsLearned       String?
  capaId               String?
  evidenceId           String?
  createdById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem?    @relation(fields: [systemId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, detectedAt])
  @@map("ai_incidents")
}

/// Evaluación de un proveedor de IA (modelo, API o dataset de terceros) (§A.10.2).
model AISupplierAssessment {
  id                          String            @id @default(cuid())
  organizationId              String
  supplierId                  String? // módulo proveedores
  systemId                    String?
  code                        String
  supplierName                String
  serviceType                 AISupplierService @default(OTHER)
  /// Debida diligencia: qué declara y qué se ha verificado del proveedor.
  modelDocumentation          Boolean           @default(false)
  trainingDataDisclosed       Boolean           @default(false)
  evaluationResultsShared     Boolean           @default(false)
  biasTestingEvidence         Boolean           @default(false)
  securityCertification       String?
  dataProcessingTerms         String?
  subprocessors               String?
  dataResidency               String?
  usesCustomerDataForTraining Boolean           @default(false)
  incidentNotificationSla     String?
  exitPlan                    String?
  risks                       String?
  requirements                String?
  outcome                     AISupplierOutcome @default(UNDER_REVIEW)
  score                       Int?
  assessedAt                  DateTime?
  assessorId                  String?
  nextReviewDate              DateTime?
  contractExpiry              DateTime?
  evidenceId                  String?
  documentId                  String?
  createdById                 String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, outcome])
  @@index([organizationId, supplierId])
  @@map("ai_supplier_assessments")
}

/// Cambio sobre un sistema o modelo de IA — requiere aprobación humana (§A.6.2.6).
model AIChangeRequest {
  id                      String              @id @default(cuid())
  organizationId          String
  systemId                String
  modelVersionId          String?
  code                    String
  title                   String
  changeType              AIChangeType        @default(OTHER)
  description             String?
  justification           String?
  /// Análisis de impacto del cambio antes de aprobarlo.
  impactAnalysis          String?
  affectsImpactAssessment Boolean             @default(false)
  requiresReassessment    Boolean             @default(false)
  requiresRetraining      Boolean             @default(false)
  requiresRevalidation    Boolean             @default(false)
  rollbackPlan            String?
  requesterId             String?
  /// Regla humana: DRAFT → HUMAN_REVIEW → APPROVED | REJECTED.
  reviewStatus            AIHumanReviewStatus @default(DRAFT)
  submittedAt             DateTime?
  reviewerId              String?
  reviewedAt              DateTime?
  decisionNote            String?
  implementedAt           DateTime?
  verifiedAt              DateTime?
  changeRequestId         String? // ChangeRequest corporativo (no se duplica)
  evidenceId              String?
  createdById             String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem      @relation(fields: [systemId], references: [id], onDelete: Cascade)
  modelVersion ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, systemId])
  @@index([organizationId, reviewStatus])
  @@map("ai_change_requests")
}

/// Monitoreo continuo en producción: métrica por periodo con umbral y deriva (§A.6.2.6).
model AIPerformanceMetric {
  id             String       @id @default(cuid())
  organizationId String
  systemId       String
  modelVersionId String?
  period         String // p. ej. 2026-07
  periodStart    DateTime?
  kind           AIMetricKind @default(OTHER)
  name           String
  value          Float
  unit           String?
  baseline       Float?
  threshold      Float?
  /// Dirección deseada: para latencia/deriva menor es mejor.
  higherIsBetter Boolean      @default(true)
  breached       Boolean      @default(false)
  driftDetected  Boolean      @default(false)
  sampleSize     Int?
  humanOverrides Int?
  note           String?
  indicatorId    String? // Indicator corporativo
  evidenceId     String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem      @relation(fields: [systemId], references: [id], onDelete: Cascade)
  modelVersion ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, systemId, period, name])
  @@index([organizationId, systemId, period])
  @@index([organizationId, breached])
  @@map("ai_performance_metrics")
}

/// REGLA HUMANA — toda salida de IA se guarda aquí y NUNCA es registro oficial
/// por sí misma. Guarda prompt, modelo, versión, salida, usuario, aprobación,
/// fecha y los cambios humanos. La promoción a un registro oficial solo es
/// posible en estado APPROVED (además garantizado por CHECK en la migración).
model AIGeneratedOutput {
  id                   String              @id @default(cuid())
  organizationId       String
  code                 String
  systemId             String?
  modelVersionId       String?
  purpose              String? // para qué se solicitó
  targetType           AIOutputTarget      @default(OTHER) // registro oficial que se pretende
  /// Trazabilidad de la generación.
  prompt               String // prompt
  promptHash           String?
  model                String // modelo
  modelVersionLabel    String // versión
  parameters           Json? // temperatura, topP, semilla…
  output               String // salida cruda de la IA (nunca se publica sin aprobar)
  outputHash           String?
  tokensUsed           Int?
  requestedById        String // usuario que la solicitó
  generatedAt          DateTime            @default(now()) // fecha
  /// Privacidad: se marca si el prompt/salida contienen datos personales.
  containsPersonalData Boolean             @default(false)
  redacted             Boolean             @default(false)
  /// Ciclo obligatorio DRAFT → HUMAN_REVIEW → APPROVED | REJECTED.
  reviewStatus         AIHumanReviewStatus @default(DRAFT)
  submittedAt          DateTime?
  reviewerId           String? // aprobación (revisor humano)
  reviewedAt           DateTime? // fecha de la decisión
  decisionNote         String?
  /// Cambios humanos sobre la salida.
  edited               Boolean             @default(false)
  humanEdits           String? // texto final tras la edición humana
  editSummary          String?
  editedById           String?
  editedAt             DateTime?
  /// Promoción a registro oficial — solo tras APPROVED.
  promotedEntityType   String?
  promotedEntityId     String?
  promotedAt           DateTime?
  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       AISystem?     @relation(fields: [systemId], references: [id], onDelete: SetNull)
  modelVersion ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, reviewStatus])
  @@index([organizationId, requestedById])
  @@index([organizationId, generatedAt])
  @@map("ai_generated_outputs")
}

// ─── ISO 37301:2021 COMPLIANCE MANAGEMENT SYSTEM ─────
// Specialized models for the compliance standard pack. Person / process /
// entity references are scalar ids validated org-scoped in the server actions;
// cross-standard requirement satisfaction flows through RequirementCoverage.
//
// TWO PERMISSION MODULES, ON PURPOSE:
//   `compliance` → obligations, risks, controls, evaluations, calendar, changes,
//                  breaches, remediation, training, governing-body reports.
//   `speakup`    → the reporting channel and its investigations. Holding
//                  `compliance:read` grants NO access to a case; every table
//                  below the channel is additionally gated by a RESTRICTIVE RLS
//                  policy that demands an explicit, non-revoked
//                  `SpeakUpCaseAccess` row (need-to-know), and by DB CHECK
//                  constraints that make an anonymous report physically unable
//                  to hold the reporter's identity.

/// Jurisdicción aplicable (país, región, sector). Jerárquica: UE → España → CCAA.
model Jurisdiction {
  id             String            @id @default(cuid())
  organizationId String
  code           String // ISO 3166 o código interno (EU, ES, ES-MD, SECTOR-FIN)
  name           String
  level          JurisdictionLevel @default(NATIONAL)
  parentId       String?
  country        String?
  authority      String? // autoridad competente principal
  applicable     Boolean           @default(true)
  rationale      String? // por qué la organización está sujeta a esta jurisdicción
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent        Jurisdiction?             @relation("JurisdictionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Jurisdiction[]            @relation("JurisdictionTree")
  sources       RegulatorySource[]
  obligations   ComplianceObligation[]
  applicability ObligationApplicability[]
  calendarItems ComplianceCalendar[]
  changes       RegulatoryChange[]
  breaches      ComplianceBreach[]

  @@unique([organizationId, code])
  @@index([organizationId, level])
  @@index([organizationId, applicable])
  @@map("jurisdictions")
}

/// Fuente regulatoria vigilada (ley, decreto, norma, contrato) — §4.6, §8.1.
model RegulatorySource {
  id                  String                 @id @default(cuid())
  organizationId      String
  code                String
  name                String
  sourceType          RegulatorySourceType   @default(LAW)
  issuer              String? // organismo emisor
  reference           String? // número o identificador oficial
  officialUrl         String?
  jurisdictionId      String?
  publishedAt         DateTime?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  /// Vigilancia activa de cambios regulatorios (§8.1).
  monitored           Boolean                @default(true)
  monitoringFrequency MonitoringFrequency    @default(QUARTERLY)
  ownerId             String? // responsable de la vigilancia
  lastCheckedAt       DateTime?
  nextCheckDate       DateTime?
  status              RegulatorySourceStatus @default(IN_FORCE)
  documentId          String?
  notes               String?
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction?          @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  obligations  ComplianceObligation[]
  changes      RegulatoryChange[]

  @@unique([organizationId, code])
  @@index([organizationId, sourceType])
  @@index([organizationId, monitored, nextCheckDate])
  @@index([organizationId, jurisdictionId])
  @@map("regulatory_sources")
}

/// Registro de obligaciones de compliance (§4.6). El corazón del módulo.
model ComplianceObligation {
  id                  String                @id @default(cuid())
  organizationId      String
  code                String
  title               String
  description         String?
  /// Texto literal de la obligación, para no reinterpretarla al resumirla.
  requirementText     String?
  obligationType      ObligationType        @default(LEGAL)
  category            ComplianceCategory    @default(OTHER)
  sourceId            String?
  jurisdictionId      String?
  articleReference    String? // artículo o cláusula concreta
  /// Responsable de la obligación y quien responde ante el órgano de gobierno.
  ownerId             String?
  accountableId       String?
  criticality         ComplianceCriticality @default(MEDIUM)
  applicability       ApplicabilityDecision @default(UNDER_ASSESSMENT)
  complianceStatus    ObligationStatus      @default(NOT_EVALUATED)
  /// Consecuencia del incumplimiento (multa, sanción penal, pérdida de licencia).
  sanctionDescription String?
  maxSanctionAmount   Float?
  currency            String?
  evidenceRequired    String? // qué evidencia demuestra el cumplimiento
  evaluationFrequency MonitoringFrequency   @default(ANNUAL)
  lastEvaluatedAt     DateTime?
  nextEvaluationDate  DateTime?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  status              ObligationLifecycle   @default(ACTIVE)
  supersededById      String?
  processId           String?
  documentId          String?
  evidenceId          String?
  requirementId       String? // StandardRequirement satisfecho (RequirementCoverage)
  createdById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source                   RegulatorySource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  jurisdiction             Jurisdiction?             @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  applicabilityAssessments ObligationApplicability[]
  risks                    ComplianceRisk[]
  controls                 ComplianceControl[]
  evaluations              ComplianceEvaluation[]
  calendarItems            ComplianceCalendar[]
  changes                  RegulatoryChange[]
  breaches                 ComplianceBreach[]
  trainings                ComplianceTraining[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
  @@index([organizationId, complianceStatus])
  @@index([organizationId, criticality])
  @@index([organizationId, ownerId])
  @@index([organizationId, nextEvaluationDate])
  @@index([organizationId, jurisdictionId])
  @@map("compliance_obligations")
}

/// Evaluación de aplicabilidad de una obligación en una jurisdicción (§4.6).
model ObligationApplicability {
  id             String                @id @default(cuid())
  organizationId String
  obligationId   String
  jurisdictionId String
  decision       ApplicabilityDecision @default(UNDER_ASSESSMENT)
  /// Motivo documentado: sin razón no hay decisión (garantizado por CHECK).
  rationale      String?
  criteria       String? // actividad, tamaño, sector, volumen de datos…
  assessedById   String?
  assessedAt     DateTime?
  reviewDate     DateTime?
  evidenceId     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation   ComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  jurisdiction Jurisdiction         @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, obligationId, jurisdictionId])
  @@index([organizationId, decision])
  @@index([organizationId, reviewDate])
  @@map("obligation_applicability")
}

/// Riesgo de compliance (§6.1): incumplir una obligación y su consecuencia.
model ComplianceRisk {
  id                   String                  @id @default(cuid())
  organizationId       String
  code                 String
  title                String
  description          String?
  obligationId         String?
  category             ComplianceCategory      @default(OTHER)
  likelihood           Int                     @default(3) // 1-5
  impact               Int                     @default(3) // 1-5
  inherentScore        Int                     @default(9)
  inherentLevel        ComplianceRiskLevel     @default(MEDIUM)
  /// Eficacia agregada de los controles (0-100) que rebaja el riesgo inherente.
  controlEffectiveness Int?
  residualScore        Int                     @default(9)
  residualLevel        ComplianceRiskLevel     @default(MEDIUM)
  acceptability        ComplianceAcceptability @default(TOLERABLE)
  treatment            ComplianceTreatment     @default(MITIGATE)
  /// Exposición económica estimada (multa + coste de remediación).
  sanctionExposure     Float?
  reputationalImpact   ComplianceImpactLevel   @default(MODERATE)
  ownerId              String?
  status               ComplianceRiskStatus    @default(OPEN)
  dueDate              DateTime?
  acceptedById         String?
  acceptedAt           DateTime?
  acceptanceRationale  String?
  riskId               String? // Risk corporativo (no se duplica)
  capaId               String?
  createdById          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation   ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  controls     ComplianceControl[]

  @@unique([organizationId, code])
  @@index([organizationId, residualLevel])
  @@index([organizationId, status])
  @@index([organizationId, obligationId])
  @@map("compliance_risks")
}

/// Control de compliance (§8.1) que mitiga un riesgo o asegura una obligación.
model ComplianceControl {
  id                    String                @id @default(cuid())
  organizationId        String
  code                  String
  name                  String
  description           String?
  obligationId          String?
  riskId                String? // ComplianceRisk
  controlType           ComplianceControlType @default(PREVENTIVE)
  nature                ControlNature         @default(MANUAL)
  frequency             MonitoringFrequency   @default(MONTHLY)
  ownerId               String?
  /// Diseño adecuado y operación eficaz se evalúan por separado.
  designAdequate        Boolean?
  operatingEffective    Boolean?
  effectiveness         Int? // 0-100
  lastTestedAt          DateTime?
  nextTestDate          DateTime?
  active                Boolean               @default(true)
  organizationControlId String? // OrganizationControl ISO 27001 reutilizado
  documentId            String?
  evidenceId            String?
  createdById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation   ComplianceObligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  risk         ComplianceRisk?        @relation(fields: [riskId], references: [id], onDelete: SetNull)
  evaluations  ComplianceEvaluation[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([organizationId, nextTestDate])
  @@index([organizationId, obligationId])
  @@map("compliance_controls")
}

/// Evaluación de cumplimiento de una obligación o control (§9.1).
model ComplianceEvaluation {
  id             String                 @id @default(cuid())
  organizationId String
  code           String
  obligationId   String?
  controlId      String?
  scope          EvaluationScope        @default(OBLIGATION)
  method         EvaluationMethod       @default(SELF_ASSESSMENT)
  period         String // 2026-Q1, 2026, …
  evaluatedById  String?
  evaluatedAt    DateTime               @default(now())
  result         ComplianceResult       @default(NOT_EVALUATED)
  score          Int? // 0-100
  findings       String?
  gapsIdentified String?
  recommendation String?
  /// Una evaluación decidida nombra a su revisor (CHECK, igual que la regla humana).
  reviewStatus   ComplianceReviewStatus @default(DRAFT)
  reviewerId     String?
  reviewedAt     DateTime?
  decisionNote   String?
  evidenceId     String?
  capaId         String?
  breachId       String?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation   ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  control      ComplianceControl?    @relation(fields: [controlId], references: [id], onDelete: SetNull)
  breach       ComplianceBreach?     @relation(fields: [breachId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, result])
  @@index([organizationId, period])
  @@index([organizationId, obligationId])
  @@index([organizationId, reviewStatus])
  @@map("compliance_evaluations")
}

/// Calendario de obligaciones con vencimiento y alerta anticipada (§8.1).
model ComplianceCalendar {
  id                  String                @id @default(cuid())
  organizationId      String
  code                String
  title               String
  description         String?
  obligationId        String?
  jurisdictionId      String?
  dueDate             DateTime
  recurrence          CalendarRecurrence    @default(ANNUAL)
  /// Días de aviso previo: dispara la alerta antes del vencimiento.
  leadTimeDays        Int                   @default(30)
  criticality         ComplianceCriticality @default(MEDIUM)
  responsibleId       String?
  authority           String? // ante quién se presenta
  submissionReference String? // número de registro de la presentación
  status              CalendarItemStatus    @default(SCHEDULED)
  completedAt         DateTime?
  completedById       String?
  alertSentAt         DateTime?
  evidenceId          String?
  parentItemId        String? // ocurrencia anterior de una obligación recurrente
  createdById         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation   ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  jurisdiction Jurisdiction?         @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@index([organizationId, responsibleId])
  @@map("compliance_calendar")
}

/// Declaración de conflicto de interés (§7.2, §8.2).
model ConflictOfInterestDeclaration {
  id                  String               @id @default(cuid())
  organizationId      String
  code                String
  declarantId         String
  period              String // ejercicio declarado (2026)
  hasConflict         Boolean              @default(false)
  conflictType        ConflictType?
  description         String?
  relatedParty        String?
  supplierId          String?
  estimatedValue      Float?
  currency            String?
  declaredAt          DateTime             @default(now())
  /// Una declaración decidida nombra a su revisor y su fecha (CHECK).
  reviewStatus        ConflictReviewStatus @default(PENDING)
  reviewerId          String?
  reviewedAt          DateTime?
  mitigationMeasures  String?
  /// Obliga a abstenerse: alimenta el control de independencia de investigaciones.
  recusalRequired     Boolean              @default(false)
  confidential        Boolean              @default(true)
  nextDeclarationDate DateTime?
  evidenceId          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@unique([organizationId, declarantId, period])
  @@index([organizationId, hasConflict])
  @@index([organizationId, reviewStatus])
  @@map("conflict_of_interest_declarations")
}

/// Cambio regulatorio detectado por la vigilancia (§8.1) y su impacto.
model RegulatoryChange {
  id              String                @id @default(cuid())
  organizationId  String
  code            String
  title           String
  sourceId        String?
  jurisdictionId  String?
  obligationId    String? // obligación afectada principal
  changeType      RegulatoryChangeType  @default(AMENDMENT)
  summary         String?
  detectedAt      DateTime              @default(now())
  detectedById    String?
  publishedAt     DateTime?
  effectiveFrom   DateTime? // fecha en la que obliga
  transitionUntil DateTime?
  impactStatus    ChangeImpactStatus    @default(PENDING_ASSESSMENT)
  impactLevel     ComplianceImpactLevel @default(MODERATE)
  impactAnalysis  String?
  affectedAreas   String?
  actionsRequired String?
  responsibleId   String?
  dueDate         DateTime?
  implementedAt   DateTime?
  changeRequestId String? // ChangeRequest corporativo (no se duplica)
  documentId      String?
  evidenceId      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       RegulatorySource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  jurisdiction Jurisdiction?         @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  obligation   ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, impactStatus])
  @@index([organizationId, effectiveFrom])
  @@index([organizationId, sourceId])
  @@map("regulatory_changes")
}

/// Configuración del canal de denuncias (una por organización) — ISO 37002.
/// Decide qué modos de reporte se admiten: el anonimato solo existe si aquí
/// está habilitado (garantizado por trigger en base).
model SpeakUpChannelConfig {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  /// Habilita el reporte anónimo. Si es false, la base rechaza el INSERT anónimo.
  allowAnonymous       Boolean  @default(true)
  allowConfidential    Boolean  @default(true)
  /// Plazos ISO 37002 / Directiva (UE) 2019/1937: acuse ≤ 7 días, respuesta ≤ 3 meses.
  acknowledgementDays  Int      @default(7)
  feedbackDays         Int      @default(90)
  /// Retención del caso tras el cierre; antes de ese plazo no se puede purgar.
  retentionMonths      Int      @default(60)
  /// Receptor designado y su suplente para cuando el titular esté en conflicto.
  defaultHandlerId     String?
  alternateHandlerId   String?
  externalChannelUrl   String?
  policyDocumentId     String?
  retaliationStatement String?
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("speak_up_channel_config")
}

/// Denuncia del canal (§8.3). La identidad del informante solo existe cuando el
/// modo la admite: en ANONYMOUS la base impide almacenarla (CHECK).
model SpeakUpReport {
  id                     String                   @id @default(cuid())
  organizationId         String
  code                   String // código de seguimiento
  identificationMode     ReportIdentificationMode @default(IDENTIFIED)
  intakeChannel          SpeakUpIntakeChannel     @default(WEB_FORM)
  category               SpeakUpCategory          @default(OTHER)
  severity               SpeakUpSeverity          @default(MEDIUM)
  receivedAt             DateTime                 @default(now())
  description            String
  allegedFacts           String?
  occurredAt             DateTime?
  location               String?
  /// Persona señalada: texto libre y, opcionalmente, el usuario, que se usa solo
  /// para el control de conflicto de interés al asignar la investigación.
  subjectDescription     String?
  subjectUserId          String?
  witnesses              String?
  /// Identidad del informante — NULL obligatorio en modo anónimo.
  reporterUserId         String?
  reporterName           String?
  reporterEmail          String?
  reporterPhone          String?
  reporterRelationship   ReporterRelationship?
  /// Código de seguimiento para que un informante anónimo consulte su caso.
  followUpCodeHash       String?
  retaliationRisk        Boolean                  @default(false)
  protectionMeasures     String?
  status                 SpeakUpStatus            @default(RECEIVED)
  acknowledgementDueAt   DateTime?
  acknowledgedAt         DateTime?
  feedbackDueAt          DateTime?
  feedbackProvidedAt     DateTime?
  /// Admisibilidad: decisión, quién y por qué (CHECK).
  admissibilityById      String?
  admissibilityAt        DateTime?
  admissibilityRationale String?
  outcome                SpeakUpOutcome?
  closureSummary         String?
  closedAt               DateTime?
  closedById             String?
  /// Retención: la purga solo puede ocurrir una vez vencido el plazo (CHECK).
  retentionUntil         DateTime?
  purgedAt               DateTime?
  breachId               String?
  capaId                 String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  access         SpeakUpCaseAccess[]
  evidence       SpeakUpEvidence[]
  investigations Investigation[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, receivedAt])
  @@index([organizationId, retentionUntil])
  @@map("speak_up_reports")
}

/// Asignación restringida: lista explícita de quién puede ver un caso y por qué.
/// Es la base de la política RLS RESTRICTIVE del canal (need-to-know).
model SpeakUpCaseAccess {
  id             String          @id @default(cuid())
  organizationId String
  reportId       String
  userId         String
  caseRole       SpeakUpCaseRole @default(TRIAGE)
  /// Justificación de la necesidad de conocer.
  reason         String?
  grantedById    String?
  grantedAt      DateTime        @default(now())
  revokedAt      DateTime?
  /// Motivo de la revocación: obligatorio al revocar (CHECK). Recusación incluida.
  revokedReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       SpeakUpReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId, caseRole])
  @@index([organizationId, userId])
  @@index([reportId, revokedAt])
  @@map("speak_up_case_access")
}

/// Evidencia protegida del canal. Deliberadamente separada de `EvidenceFile`:
/// quien tiene `evidence:read` no debe alcanzar la prueba de una denuncia.
model SpeakUpEvidence {
  id              String   @id @default(cuid())
  organizationId  String
  reportId        String
  investigationId String?
  code            String
  title           String
  description     String?
  fileUrl         String?
  mimeType        String?
  fileSize        Int?
  /// Cadena de custodia: hash de integridad, quién la obtuvo y cuándo.
  sha256          String?
  collectedById   String?
  collectedAt     DateTime @default(now())
  custodyNotes    String?
  sealed          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report        SpeakUpReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  investigation Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, reportId])
  @@map("speak_up_evidence")
}

/// Investigación de una denuncia o de un incumplimiento (§8.3, §9.1).
/// La independencia es estructural: el investigador no puede ser la persona
/// señalada (CHECK) y un conflicto detectado obliga a recusación y reasignación.
model Investigation {
  id                    String               @id @default(cuid())
  organizationId        String
  code                  String
  reportId              String?
  breachId              String?
  title                 String
  scope                 String?
  plan                  String?
  leadInvestigatorId    String?
  teamDescription       String?
  /// Copia de la persona señalada para poder verificar la independencia en base.
  subjectUserId         String?
  independenceConfirmed Boolean              @default(false)
  conflictChecked       Boolean              @default(false)
  conflictDetected      Boolean              @default(false)
  conflictDescription   String?
  recusedAt             DateTime?
  recusedById           String?
  reassignedToId        String?
  status                InvestigationStatus  @default(PLANNED)
  confidentiality       ConfidentialityLevel @default(RESTRICTED)
  startedAt             DateTime?
  dueDate               DateTime?
  concludedAt           DateTime?
  findings              String?
  conclusion            String?
  recommendations       String?
  sanctionsRecommended  String?
  reportDocumentId      String?
  capaId                String?
  createdById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       SpeakUpReport?    @relation(fields: [reportId], references: [id], onDelete: SetNull)
  breach       ComplianceBreach? @relation(fields: [breachId], references: [id], onDelete: SetNull)
  evidence     SpeakUpEvidence[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, reportId])
  @@index([organizationId, leadInvestigatorId])
  @@map("investigations")
}

/// Incumplimiento de compliance confirmado (§10.1) y su notificación a autoridad.
model ComplianceBreach {
  id                   String                @id @default(cuid())
  organizationId       String
  code                 String
  title                String
  description          String?
  obligationId         String?
  jurisdictionId       String?
  detectionSource      BreachDetectionSource @default(SELF_DETECTED)
  severity             BreachSeverity        @default(MODERATE)
  detectedAt           DateTime              @default(now())
  detectedById         String?
  occurredAt           DateTime?
  rootCause            String?
  affectedParties      String?
  recurrence           Boolean               @default(false)
  financialExposure    Float?
  currency             String?
  sanctionImposed      Boolean               @default(false)
  sanctionAmount       Float?
  sanctionDescription  String?
  /// Notificación a la autoridad: decisión obligatoria y con plazo.
  notificationRequired Boolean               @default(false)
  notificationDeadline DateTime?
  authorityNotifiedAt  DateTime?
  authorityReference   String?
  status               BreachStatus          @default(OPEN)
  closedAt             DateTime?
  closedById           String?
  lessonsLearned       String?
  capaId               String?
  ncId                 String?
  evidenceId           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation       ComplianceObligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  jurisdiction     Jurisdiction?          @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  investigations   Investigation[]
  remediationPlans RemediationPlan[]
  evaluations      ComplianceEvaluation[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, detectedAt])
  @@index([organizationId, obligationId])
  @@map("compliance_breaches")
}

/// Plan de remediación de un incumplimiento (§10.1). Su cierre exige
/// verificación de eficacia por una persona distinta del ejecutor.
model RemediationPlan {
  id                        String                @id @default(cuid())
  organizationId            String
  code                      String
  title                     String
  breachId                  String?
  obligationId              String?
  objective                 String?
  actionsDescription        String?
  ownerId                   String?
  startDate                 DateTime?
  dueDate                   DateTime?
  progressPercent           Int                   @default(0)
  status                    RemediationPlanStatus @default(DRAFT)
  approvedById              String?
  approvedAt                DateTime?
  completedAt               DateTime?
  effectivenessVerified     Boolean               @default(false)
  effectivenessVerifiedById String?
  effectivenessVerifiedAt   DateTime?
  verificationNote          String?
  verificationEvidenceId    String?
  cost                      Float?
  currency                  String?
  actionId                  String? // Action corporativa (no se duplica)
  createdById               String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  breach       ComplianceBreach? @relation(fields: [breachId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, breachId])
  @@map("remediation_plans")
}

/// Formación en compliance (§7.2, §7.3) y su cobertura real sobre la audiencia.
model ComplianceTraining {
  id                     String           @id @default(cuid())
  organizationId         String
  code                   String
  title                  String
  topic                  ComplianceTopic  @default(CODE_OF_CONDUCT)
  obligationId           String?
  audience               String?
  mandatory              Boolean          @default(true)
  deliveryMode           TrainingDelivery @default(ONLINE)
  scheduledFor           DateTime?
  completedAt            DateTime?
  durationMinutes        Int?
  targetCount            Int?
  completedCount         Int?
  passRate               Int? // 0-100
  effectivenessEvaluated Boolean          @default(false)
  effectivenessNote      String?
  nextDueDate            DateTime?
  trainingCourseId       String? // TrainingCourse corporativo reutilizado
  materialsDocumentId    String?
  evidenceId             String?
  createdById            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligation   ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId, topic])
  @@index([organizationId, scheduledFor])
  @@map("compliance_trainings")
}

/// Informe al órgano de gobierno (§5.1, §9.3). Los datos del canal entran solo
/// agregados: el informe no transporta identidades de informantes.
model GoverningBodyReport {
  id                    String                @id @default(cuid())
  organizationId        String
  code                  String
  title                 String
  period                String
  presentedTo           GoverningBody         @default(BOARD)
  preparedById          String?
  reportedAt            DateTime              @default(now())
  executiveSummary      String?
  obligationsSummary    String?
  risksSummary          String?
  evaluationsSummary    String?
  breachesSummary       String?
  /// Solo volúmenes, categorías y resultados del canal — nunca identidades.
  speakUpSummary        String?
  investigationsSummary String?
  trainingSummary       String?
  remediationSummary    String?
  resourcesRequested    String?
  decisionsRequested    String?
  decisionsTaken        String?
  reviewStatus          GoverningReportStatus @default(DRAFT)
  submittedAt           DateTime?
  presentedAt           DateTime?
  acknowledgedAt        DateTime?
  acknowledgedById      String?
  documentId            String?
  evidenceId            String?
  managementReviewId    String? // ManagementReview corporativa
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, period])
  @@index([organizationId, reviewStatus])
  @@map("governing_body_reports")
}

// ─── ISO 37001:2021 ANTI-BRIBERY MANAGEMENT SYSTEM ───
// Extensión del paquete de compliance (ISO 37301). NO duplica obligaciones,
// riesgos de compliance, denuncias, investigaciones ni CAPA: los referencia
// por id escalar validado en las Server Actions. El canal de denuncias sigue
// siendo SpeakUpReport; AntiBriberyInvestigation apunta a Investigation.

model BriberyRiskAssessment {
  id                 String                  @id @default(cuid())
  organizationId     String
  code               String
  title              String
  scope              String?
  /// Área / proceso / proceso evaluado (sin duplicar Process).
  processId          String?
  jurisdictionId     String? // Jurisdiction (compliance)
  obligationId       String? // ComplianceObligation
  complianceRiskId   String? // ComplianceRisk — valoración reutilizada
  riskId             String? // Risk corporativo
  inherentLikelihood Int                     @default(3)
  inherentImpact     Int                     @default(3)
  inherentScore      Int                     @default(9)
  inherentLevel      ComplianceRiskLevel     @default(MEDIUM)
  residualLikelihood Int?
  residualImpact     Int?
  residualScore      Int?
  residualLevel      ComplianceRiskLevel?
  publicOfficialRisk Boolean                 @default(false)
  thirdPartyRisk     Boolean                 @default(false)
  countryRisk        BriberyCountryRisk      @default(MODERATE)
  sectorRisk         BriberyCountryRisk      @default(MODERATE)
  treatment          ComplianceTreatment     @default(MITIGATE)
  treatmentPlan      String?
  ownerId            String?
  assessedAt         DateTime                @default(now())
  nextReviewDate     DateTime?
  status             BriberyAssessmentStatus @default(DRAFT)
  approvedById       String?
  approvedAt         DateTime?
  documentId         String?
  evidenceId         String?
  capaId             String?
  createdById        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, residualLevel])
  @@index([organizationId, nextReviewDate])
  @@map("bribery_risk_assessments")
}

model BusinessAssociate {
  id                 String                @id @default(cuid())
  organizationId     String
  code               String
  name               String
  associateType      BusinessAssociateType @default(SUPPLIER)
  country            String?
  registrationNumber String?
  industry           String?
  /// Reutiliza el proveedor corporativo cuando ya existe.
  supplierId         String?
  riskTier           AssociateRiskTier     @default(MEDIUM)
  isPublicOfficial   Boolean               @default(false)
  interactsWithPEPs  Boolean               @default(false)
  sanctionedScreen   ScreeningResult       @default(NOT_SCREENED)
  adverseMedia       ScreeningResult       @default(NOT_SCREENED)
  ownershipKnown     Boolean               @default(false)
  status             AssociateStatus       @default(ACTIVE)
  ownerId            String?
  onboardingDate     DateTime?
  nextReviewDate     DateTime?
  notes              String?
  documentId         String?
  createdById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  beneficialOwners  BeneficialOwner[]
  dueDiligence      DueDiligenceCase[]
  gifts             GiftHospitalityRecord[]
  donations         DonationSponsorshipRecord[]
  commitments       AntiBriberyCommitment[]
  highRiskApprovals HighRiskTransactionApproval[]

  @@unique([organizationId, code])
  @@index([organizationId, associateType])
  @@index([organizationId, riskTier])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@map("business_associates")
}

model DueDiligenceCase {
  id               String             @id @default(cuid())
  organizationId   String
  code             String
  associateId      String
  level            DueDiligenceLevel  @default(STANDARD)
  purpose          String?
  /// Flujo: DRAFT → SCREENING → REVIEW → ENHANCED_REVIEW → APPROVED|REJECTED → PERIODIC_REVIEW
  status           DueDiligenceStatus @default(DRAFT)
  screeningResult  ScreeningResult    @default(NOT_SCREENED)
  findings         String?
  residualRisk     AssociateRiskTier?
  conditions       String?
  reviewerId       String?
  reviewedAt       DateTime?
  approvedById     String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  rejectionReason  String?
  nextReviewDate   DateTime?
  obligationId     String? // ComplianceObligation de debida diligencia
  complianceRiskId String?
  documentId       String?
  evidenceId       String?
  capaId           String?
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  associate    BusinessAssociate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, associateId])
  @@index([organizationId, nextReviewDate])
  @@map("due_diligence_cases")
}

model BeneficialOwner {
  id                 String                @id @default(cuid())
  organizationId     String
  code               String
  associateId        String
  fullName           String
  nationality        String?
  countryOfResidence String?
  ownershipPercent   Float?
  controlType        BeneficialControlType @default(OWNERSHIP)
  isPep              Boolean               @default(false)
  pepRole            String?
  identifiedAt       DateTime              @default(now())
  verifiedAt         DateTime?
  verifiedById       String?
  evidenceId         String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  associate    BusinessAssociate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, associateId])
  @@index([organizationId, isPep])
  @@map("beneficial_owners")
