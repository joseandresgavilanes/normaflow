# =============================================
# NORMAFLOW — Variables de Entorno
# =============================================
# Copia este archivo como .env.local y rellena los valores.

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Obligatorio para invitar usuarios (Opción A: auth.admin.inviteUserByEmail)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Invitaciones: Site URL = raíz del dominio (NO /home). Redirect URLs:
#   {APP_URL}/auth/callback  — Plantilla: Authentication → Email Templates → Invite user
# Bucket privado en Supabase Storage para archivos de documentos del SGC.
# Crear en Supabase: Storage → New bucket → "documents" → Private.
SUPABASE_DOCUMENTS_BUCKET=documents
# Bucket privado para las evidencias vinculadas a procesos y módulos operativos.
SUPABASE_EVIDENCE_BUCKET=evidence

# DATABASE
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# STRIPE
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...

# ANTHROPIC
ANTHROPIC_API_KEY=sk-ant-api03-...

# RESEND
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@normaflow.io

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Solo se usa para sesión demo local; nunca se configura en producción.
NEXTAUTH_SECRET=
NODE_ENV=development

# DEMO / DESARROLLO LOCAL
# Sin Supabase, permite logins locales vía cookie firmada (útil para tests e2e y prototipos).
AUTH_DEMO_MODE=false
# Debe coincidir con AUTH_DEMO_MODE. Producción rechaza cualquier valor true.
NEXT_PUBLIC_AUTH_DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=
# Rol local por defecto para poder probar vistas admin sin Supabase.
DEMO_ROLE=ORG_ADMIN
DEMO_ORG_ID=org_tecnoserv
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
CUSTOMER_NAME=
CUSTOMER_ORG_ID=org_customer
CUSTOMER_ORG_NAME=Mi Organización
CUSTOMER_ROLE=ORG_ADMIN
CUSTOMER_PLAN=GROWTH
DEMO_SESSION_SECRET=

# Cifrado a nivel de campo para vigilancia de la salud ocupacional (ISO 45001).
# Obligatoria solo para crear/leer registros de OccupationalHealthSurveillance;
# el resto de la app funciona sin ella. Cambiarla invalida los registros ya cifrados.
HEALTH_DATA_ENCRYPTION_KEY=

# Cifrado a nivel de campo para la identidad del informante en el canal de
# denuncias (ISO 37301 §8.3 / ISO 37002). Obligatoria solo para presentar una
# denuncia IDENTIFIED o CONFIDENTIAL; una denuncia ANONYMOUS nunca guarda
# identidad, con o sin esta clave. Cambiarla invalida los casos ya cifrados.
SPEAKUP_DATA_ENCRYPTION_KEY=

# Cifrado a nivel de campo para texto libre de vigilancia de dispositivos
# médicos (ISO 13485 §8.2/§8.3): quejas, eventos adversos, PMS y acciones de
# campo. Obligatoria solo para crear/leer esos registros. Cambiarla invalida
# los registros ya cifrados.
MD_SENSITIVE_DATA_ENCRYPTION_KEY=

# Tests live: debe activarse explícitamente porque crean y eliminan fixtures efímeros.
LIVE_TEST_ALLOW_MUTATIONS=false
NORMAFLOW_TEST_ENV=isolated
# Suite de seguridad live: credenciales separadas del proyecto/DB de producción.
# Requiere además NORMAFLOW_TEST_ENV=isolated al ejecutarla.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Staging: nunca reutilizar DATABASE_URL o el proyecto Supabase de producción.
STAGING_DATABASE_URL=
STAGING_DIRECT_URL=

# Producción: solo para el comando de migración seguro con aprobación explícita.
PRODUCTION_DATABASE_URL=
PRODUCTION_DIRECT_URL=
NORMAFLOW_ENV=development
NORMAFLOW_AI_ENABLED=false

# CRON — secreto que protege /api/cron/* (Vercel Cron lo envía como Bearer)
CRON_SECRET=

# ── Observabilidad ──
# LOG_LEVEL: debug | info | warn | error (default: debug en dev, info en el resto)
LOG_LEVEL=
# Tracker de errores opcional. Instala @sentry/nextjs y define el DSN para activarlo.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# Webhook entrante (Slack/Teams/PagerDuty, formato {text}) para alertas de /api/cron/ops-monitor.
OPS_ALERT_WEBHOOK=

# ── Backups / pruebas de restauración ──
# Retención en días (documentada en docs/backup-restore.md; la aplica el proveedor).
BACKUP_RETENTION_DAYS=
# Base efímera de destino para `npm run restore:drill` (nunca un entorno real).
RESTORE_TARGET_URL=
RESTORE_SOURCE_URL=
