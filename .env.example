# =============================================
# NORMAFLOW — Variables de Entorno
# =============================================
# Copia este archivo como .env.local y rellena los valores.

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Obligatorio para invitar usuarios (Opción A: auth.admin.inviteUserByEmail)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Invitaciones: Site URL = raíz del dominio (NO /home). Redirect URLs:
#   {APP_URL}/auth/callback  — Plantilla: Authentication → Email Templates → Invite user
# Bucket privado en Supabase Storage para archivos de documentos del SGC.
# Crear en Supabase: Storage → New bucket → "documents" → Private.
SUPABASE_DOCUMENTS_BUCKET=documents
# Bucket privado para las evidencias vinculadas a procesos y módulos operativos.
SUPABASE_EVIDENCE_BUCKET=evidence

# DATABASE
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# STRIPE
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ANTHROPIC
ANTHROPIC_API_KEY=sk-ant-api03-...

# RESEND
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@normaflow.io

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secreto-aleatorio-seguro-aqui
NODE_ENV=development

# DEMO / DESARROLLO LOCAL
# Sin Supabase, permite logins locales vía cookie firmada (útil para tests e2e y prototipos).
AUTH_DEMO_MODE=true
# Expuesto al cliente solo como flag; no sustituye el secreto de firma (NEXTAUTH_SECRET).
NEXT_PUBLIC_AUTH_DEMO_MODE=true
DEMO_EMAIL=demo@normaflow.io
DEMO_PASSWORD=NormaFlow2025!
DEMO_NAME=Ana García
# Rol local por defecto para poder probar vistas admin sin Supabase.
DEMO_ROLE=ORG_ADMIN
DEMO_ORG_ID=org_tecnoserv
CUSTOMER_EMAIL=cliente@normaflow.io
CUSTOMER_PASSWORD=NormaFlow2025!
CUSTOMER_NAME=Admin Cliente
CUSTOMER_ORG_ID=org_customer
CUSTOMER_ORG_NAME=Mi Organización
CUSTOMER_ROLE=ORG_ADMIN
CUSTOMER_PLAN=GROWTH
DEMO_SESSION_SECRET=opcional-si-no-usas-NEXTAUTH_SECRET

# Tests live: debe activarse explícitamente porque crean y eliminan fixtures efímeros.
LIVE_TEST_ALLOW_MUTATIONS=false
