{
  "name": "normaflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:runtime-config && npm run validate:plans && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:status": "npx prisma migrate status",
    "db:smoke": "tsx scripts/migration-smoke.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:packs": "tsx scripts/test-standard-packs.ts",
    "test:sig": "tsx scripts/test-sig.ts",
    "test:bcm": "tsx scripts/test-continuity.ts",
    "test:env": "tsx scripts/test-environmental.ts",
    "test:safety": "tsx scripts/test-safety.ts",
    "test:aims": "tsx scripts/test-aims.ts",
    "test:compliance": "tsx scripts/test-compliance.ts",
    "test:antibribery": "tsx scripts/test-antibribery.ts",
    "test:energy": "tsx scripts/test-energy.ts",
    "test:food-safety": "tsx scripts/test-food-safety.ts",
    "test:itsm": "tsx scripts/test-itsm.ts",
    "test:medical-devices": "tsx scripts/test-medical-devices.ts",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:live": "LIVE_TEST_ALLOW_MUTATIONS=true NORMAFLOW_TEST_ENV=isolated playwright test --config=playwright.live.config.ts",
    "test:security-live": "LIVE_TEST_ALLOW_MUTATIONS=true NORMAFLOW_TEST_ENV=isolated playwright test tests-live/security-tenant.spec.ts --config=playwright.live.config.ts",
    "test:ui": "playwright test --ui",
    "test:live": "LIVE_TEST_ALLOW_MUTATIONS=true NORMAFLOW_TEST_ENV=isolated playwright test --config=playwright.live.config.ts",
    "test:live:headed": "LIVE_TEST_ALLOW_MUTATIONS=true NORMAFLOW_TEST_ENV=isolated playwright test --config=playwright.live.config.ts --headed",
    "validate:plans": "tsx scripts/validate-plans.ts",
    "validate:runtime-config": "tsx scripts/validate-runtime-config.ts",
    "validate:production-config": "tsx scripts/validate-production-config.ts",
    "db:deploy:safe": "tsx scripts/db-deploy-safe.ts",
    "storage:reconcile-documents": "tsx scripts/reconcile-document-storage.ts",
    "restore:drill": "tsx scripts/restore-drill.ts",
    "org:offboard": "tsx scripts/org-offboarding.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@stripe/stripe-js": "^3.4.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.43.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.383.0",
    "next": "^15.5.14",
    "pdf-lib": "^1.17.1",
    "prisma": "5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "recharts": "^2.12.7",
    "resend": "^3.2.0",
    "stripe": "^15.11.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
